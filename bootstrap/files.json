{"__files":{"src/components/MoreWays.astro":"---\nimport { url } from '../lib/data';\nconst { cards, cols = 'g3', tint = false } = Astro.props;\n---\n<section class={tint ? 'band tint' : 'band'}>\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">More ways we can help</p><h2 style=\"margin-bottom:28px\">Whatever your move looks like.</h2>\n    <div class={'grid ' + cols}>{cards.map(([t, d, p]) => <a class=\"card pad\" href={url(p)} style=\"text-decoration:none\"><h4 style=\"margin-bottom:8px\">{t}</h4><p class=\"meta\" style=\"font-size:16px\">{d}</p></a>)}</div>\n    <div class=\"card pad pick\" style=\"margin-top:20px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap\">\n      <div style=\"max-width:720px\"><p class=\"eyebrow\" style=\"margin-bottom:6px\">Beyond Houston</p><h4 style=\"margin-bottom:8px;font-size:24px\">Our worldwide network</h4><p class=\"meta\" style=\"font-size:17px\">Looking outside Houston? Tap our network to find real estate across the United States and in other countries.</p></div>\n      <a class=\"btn\" href={url('/ask-dillon')}>Ask Dillon</a>\n    </div>\n  </div>\n</section>\n"},"__patches":[{"path":"src/pages/tradition-realty-group.astro","find":"import { listings } from '../lib/listings';\n","replace":"import { listings } from '../lib/listings';\nimport MoreWays from '../components/MoreWays.astro';\n"},{"path":"src/pages/make-it-home.astro","find":"import { url } from '../lib/data';\n","replace":"import { url } from '../lib/data';\nimport MoreWays from '../components/MoreWays.astro';\n"}],"__cuts":[{"path":"src/pages/tradition-realty-group.astro","from":"  <section class=\"band\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">More ways we can help</p>","to":"        <a class=\"btn\" href={url('/ask-dillon')}>Ask Dillon</a>\n      </div>\n    </div>\n  </section>\n\n","replace":"  <MoreWays cards={help} />\n\n"},{"path":"src/pages/make-it-home.astro","from":"  <section class=\"band tint\">\n   