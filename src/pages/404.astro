---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url } from '../lib/data';
---
<Base title="Page not found" active="" description="That page has moved or is no longer here.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Page not found</p>
      <h1 style="margin-bottom:16px;max-width:820px">We could not find that page.</h1>
      <p class="lead" style="margin-bottom:28px">It may have moved, or it is no longer here. Here are some good places to start.</p>
      <div class="chips"><a class="btn" href={url('/food')}>Where to eat</a><a class="btn line" href={url('/neighborhoods')}>Neighborhoods</a><a class="btn line" href={url('/things-to-do')}>Things to do</a><a class="btn line" href={url('/ask-dillon')}>Ask Dillon</a></div>
    </div>
  </section>
</Base>
