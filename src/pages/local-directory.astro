    }

    // ---- 2. the main sponsor (one now, built so it can rotate later)
    function drawMain() {
      var host = $('dx-main'); host.textContent = '';
      if (!S.ready.s) return;
      var mains = S.sp.filter(function (s) { return s.is_main; }), pool = mains.length ? mains : S.sp;
      if (!pool.length) {
        var e = el('div', 'dx-lock'); e.appendChild(el('p', '', 'Your business could be the Main Sponsor here. Sponsors reach neighbors who are moving, buying, or settling in.'));
        var r = el('div', 'acts'); r.appendChild(a(DX.ask, 'Become the main sponsor', 'btn')); e.appendChild(r); host.appendChild(e); return;
      }
      var s = pool[S.mainPick % pool.length], card = el('div', 'card dx-split'), left = el('div', 'dx-splitl'), box = el('div', 'dx-logobox'), im = safeImg(s.logo_url);
      if (im) { var i = el('img'); i.src = im; i.alt = s.name; box.appendChild(i); } else box.textContent = s.name;
      left.appendChild(box); card.appendChild(left);
      var right = el('div', 'dx-splitr'); right.appendChild(el('h3', '', s.name)); if (s.tagline) right.appendChild(el('p', '', s.tagline));
      var w = safeUrl(s.website); if (w) { var row = el('div', 'dx-acts'); row.appendChild(a(w, 'Visit website', 'btn', 'sponsored noopener')); right.appendChild(row); }
      card.appendChild(right); host.appendChild(card);
    }

    // ---- 4. our short list: three recommendations per category, rotating
    function catItems(i) { return S.pr.filter(function (p) { return CATS[i].re.test(p.category || ''); }); }
    function activeCats() { return CATS.map(function (x, i) { return i; }).filter(function (i) { return catItems(i).length; }); }
    function stopRot() { if (S.timer) { clearInterval(S.timer); S.timer = null; } }
    function startRot() { stopRot(); if (S.paused || reduced() || !S.signed || activeCats().length < 2) return; S.timer = setInterval(function () { step(1, true); }, 8000); }
    function step(dir, auto) {
      var act = activeCats(); if (!act.length) return;
      var pos = act.indexOf(S.tab); if (pos < 0) pos = 0; S.tab = act[(pos + dir + act.length) % act.length]; drawShort(auto); if (!auto) startRot();
    }
    function drawShort() {
      var tabs = $('dx-stabs'), panel = $('dx-spanel'), cap = $('dx-scap'); tabs.textContent = ''; panel.textContent = ''; cap.textContent = '';
      var ctl = $('dx-ctl'); ctl.querySelectorAll('.dx-rnd').forEach(function (b) { b.hidden = !S.signed; });
      CATS.forEach(function (cat, i) {
        var b = el('button', 'dx-stab', cat.l); b.type = 'button'; b.id = 'dx-tab' + i; b.setAttribute('role', 'tab'); b.setAttribute('aria-selected', i === S.tab ? 'true' : 'false'); b.setAttribute('aria-controls', 'dx-spanel');
        if (S.signed) b.addEventListener('click', function () { S.tab = i; drawShort(); startRot(); }); tabs.appendChild(b);
      });
      panel.setAttribute('aria-labelledby', 'dx-tab' + S.tab);
      if (!S.signed) { panel.appendChild(lockPanel('Our Short List is for members. Create a free account to see the lenders, inspectors, home warranty companies, and lawyers we would call ourselves.')); return; }
      if (!S.ready.p) { panel.appendChild(el('p', 'meta', 'One moment.')); return; }
      var items = catItems(S.tab);
      if (!items.length) { panel.appendChild(empty('We are adding our ' + CATS[S.tab].one + ' now.', 'Ask Dillon who to call')); return; }
      var g = el('div', 'dx-g3');
      items.slice(0, 3).forEach(function (p) {
        var card = el('div', 'card pad dx-card'); card.style.gap = '14px';
        if (p.why) { var q = el('div', 'dx-quote'); q.appendChild(el('p', 'eyebrow', 'Why we call them')); q.appendChild(el('p', '', p.why)); card.appendChild(q); }
        card.appendChild(badge('pr')); card.appendChild(el('h4', '', p.name)); card.appendChild(el('p', 'meta', [p.category, p.service_area ? 'serves ' + p.service_area : ''].filter(Boolean).join(', ')));
        var l = el('div', 'dx-acts'), t = safeTel(p.phone), m = safeMail(p.email), w = safeUrl(p.website);
        if (t) l.appendChild(a('tel:' + t, 'Call', 'btn')); if (m) l.appendChild(a('mailto:' + m, 'Email', 'btn line')); if (w) l.appendChild(a(w, 'Website', 'btn line', 'noopener'));
        if (l.children.length) card.appendChild(l); g.appendChild(card);
      });
      panel.appendChild(g);
      cap.textContent = 'Showing ' + Math.min(3, items.length) + ' of ' + items.length + ' ' + CATS[S.tab].one + '.' + (S.timer ? ' Rotates every 8 seconds, and pauses when you hover or tap pause.' : '');
    }

    // ---- 5. places to know, near the member's favorite community
    function community() { var v = ls('tl_area'); if (v && v !== '__other') return String(v); var f = ls('tl_follows'); return f && f.length ? String(f[0]) : ''; }
    function near(item, comm, loose) { var t = norm(item), cm = norm(comm); if (!t) return !!loose; if (loose && /greater houston|all of houston|houston area|houston wide|citywide/.test(t)) return true; return t.indexOf(cm) > -1; }
    function drawNear() {
      var comm = community(), grid = $('dx-ngrid'), note = $('dx-nnote'); grid.textContent = ''; note.textContent = '';
      $('dx-pick').hidden = !!comm; $('dx-pillbox').hidden = !comm; $('dx-nmore-wrap').hidden = true;
      $('dx-nh').textContent = comm ? 'Near ' + comm : 'Near You'; $('dx-comm').textContent = 'Your community: ' + comm;
      if (!comm) return;
      if (!S.ready.b) return;
      var bz = S.bz.filter(function (b) { return near(b.a, comm, false); }).sort(function (x, y) { return (y.s || 0) - (x.s || 0) || x.n.localeCompare(y.n); }),
          pr = S.signed ? S.pr.filter(function (p) { return near(p.service_area, comm, true); }) : [],
          sp = S.sp.filter(function (s) { return near(s.service_area, comm, true); });
      var queues = [bz.map(function (d) { return { t: 'bz', d: d }; }), pr.map(function (d) { return { t: 'pr', d: d }; }), sp.map(function (d) { return { t: 'sp', d: d }; })], out = [], i = 0;
      while (out.length < 6 && queues.some(function (q) { return q.length; })) { var q = queues[i % 3]; if (q.length) out.push(q.shift()); i++; }
      out.forEach(function (x) { grid.appendChild(cardFor(x)); });
      if (!out.length) note.appendChild(empty('Nothing is listed near ' + comm + ' yet. Try the search above, or', 'ask Dillon'));
      else $('dx-nmore-wrap').hidden = false;
      if (!S.signed) { var n = el('p', 'meta', ''); n.style.marginTop = '20px'; n.appendChild(a(DX.signin, 'Sign in')); n.appendChild(document.createTextNode(' to include service providers near ' + comm + '.')); note.appendChild(n); }
    }
    function drawAll() { status(); markTabs(); markTiles(); drawResults(); drawMain(); drawShort(); drawNear(); }

    // ---- data
    function rows(res) { return res && !res.error && res.data ? res.data : []; }
    if (!c) { $('dx-q').disabled = true; return; }
    DX.areas.forEach(function (n) { var o = document.createElement('option'); o.textContent = n; $('dx-sel').appendChild(o); });
    var h0 = decodeURIComponent((location.hash || '').replace(/^#/, ''));
    if (h0.indexOf('search=') === 0) { S.q = h0.slice(7); $('dx-q').value = S.q; } else if (h0 === 'sponsors') S.type = 'sp'; else if (h0 === 'providers') S.type = 'pr'; else if (h0 === 'businesses') S.type = 'bz';
    c.from('directory_sponsors').select('id,name,tagline,website,logo_url,is_main,service_area').eq('published', true).order('sort_order').order('name').then(function (r) { S.sp = rows(r); S.ready.s = true; drawAll(); }, function () { S.ready.s = true; drawAll(); });
    fetch(DX.businesses).then(function (r) { return r.json(); }).then(function (j) { S.bz = Array.isArray(j) ? j : []; S.ready.b = true; drawAll(); }, function () { S.ready.b = true; drawAll(); });
    function loadProviders() { c.from('directory_providers').select('id,category,name,contact_name,phone,email,website,service_area,why').eq('published', true).order('sort_order').order('name').then(function (r) { S.pr = rows(r); S.ready.p = true; drawAll(); startRot(); }, function () { S.ready.p = true; drawAll(); }); }
    c.auth.getSession().then(function (r) { S.signed = !!(r && r.data && r.data.session); if (S.signed) loadProviders(); else S.ready.p = true; drawAll(); }, function () { S.ready.p = true; drawAll(); });
    c.auth.onAuthStateChange(function (ev) { if (ev === 'SIGNED_OUT') { S.signed = false; S.pr = []; S.ready.p = true; stopRot(); drawAll(); } });

    // ---- interaction
    var q = $('dx-q'), timer = null;
    q.addEventListener('input', function () { S.q = q.value; S.preset = ''; S.shown = 24; markTiles(); clearTimeout(timer); timer = setTimeout(function () { hashSync(); drawResults(); }, 120); });
    $('dx-form').addEventListener('submit', function (e) { e.preventDefault(); S.q = q.value; S.preset = ''; S.shown = 24; markTiles(); hashSync(); drawResults(); $('dx-results').hidden || $('dx-results').focus(); });
    $('dx-tabs').addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('.chip'); if (!b) return; S.type = b.getAttribute('data-t'); S.shown = 24; markTabs(); drawResults(); });
    $('dx-tiles').addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('.dx-tile'); if (!b) return; var p = b.getAttribute('data-p');
      S.preset = S.preset === p ? '' : p; S.q = ''; q.value = ''; S.type = ''; S.shown = 24; hashSync(); markTabs(); markTiles(); drawResults();
      if (S.preset) { var r = $('dx-results'); try { r.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'start' }); } catch (x) {} r.focus(); }
    });
    $('dx-clear').addEventListener('click', function () { S.q = ''; S.type = ''; S.preset = ''; q.value = ''; hashSync(); markTabs(); markTiles(); drawResults(); q.focus(); });
    $('dx-rmore').addEventListener('click', function () { S.shown += 24; drawResults(); });
    $('dx-prev').addEventListener('click', function () { step(-1); });
    $('dx-next').addEventListener('click', function () { step(1); });
    $('dx-pause').addEventListener('click', function () { S.paused = !S.paused; this.setAttribute('aria-pressed', S.paused ? 'true' : 'false'); this.setAttribute('aria-label', S.paused ? 'Start rotation' : 'Pause rotation'); if (S.paused) stopRot(); else startRot(); drawShort(); });
    var sh = $('dx-short'); sh.addEventListener('mouseenter', stopRot); sh.addEventListener('mouseleave', startRot); sh.addEventListener('focusin', stopRot); sh.addEventListener('focusout', startRot);
    $('dx-change').addEventListener('click', function () { var p = $('dx-pick'); p.hidden = !p.hidden; $('dx-pickt').textContent = 'Choose a different community.'; if (!p.hidden) $('dx-sel').focus(); });
    $('dx-setc').addEventListener('click', function () { var v = $('dx-sel').value; if (!v) return; lsSet('tl_area', v); drawNear(); });
    $('dx-nmore').addEventListener('click', function () { var comm = community(); S.q = comm; S.preset = ''; S.type = ''; q.value = comm; S.shown = 24; hashSync(); markTabs(); markTiles(); drawResults(); var r = $('dx-results'); try { r.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'start' }); } catch (x) {} r.focus(); });
  })();
