      card.appendChild(el('p', 'meta', [b.k, b.a].filter(Boolean).join(', ')));
      var l = el('div', 'dx-acts'); l.appendChild(a(b.u, b.r ? 'Read our review' : 'See the page', 'btn line')); card.appendChild(l); return card;
    }
    function cardFor(x) { return x.t === 'sp' ? sponsorCard(x.d) : x.t === 'pr' ? providerCard(x.d) : bizCard(x.d); }
    function lockPanel(text, acts) {
