---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url } from '../lib/data';
import { config } from '../config';
const mail = `mailto:${config.contactEmail}?subject=${encodeURIComponent('Local Directory access')}`;
---
<Base title="Local Directory" active="More" description="Local providers we know and trust, for members.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Members</p>
      <h1 style="margin-bottom:16px;max-width:860px">Providers we know and trust.</h1>
      <p class="lead" style="margin-bottom:28px">The Local Directory is a members only list of local pros we would call ourselves, shared with neighbors who are moving, buying, or settling in.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={mail}>Request access</a><a class="btn line" href={url('/account')}>Sign in</a></div>
    </div>
  </section>
  <section class="band">
    <div class="wrap split">
      <div class="main">
        <p class="eyebrow">How it works</p><h2 style="margin-bottom:24px">Opening soon, for members</h2>
        <div class="row" style="border-top:0"><span class="tag">1</span><div><b>Every pro is one we know</b><br /><span class="meta" style="font-size:16px">We list people we have worked with or heard good things about from neighbors.</span></div></div>
        <div class="row"><span class="tag">2</span><div><b>Members see the list</b><br /><span class="meta" style="font-size:16px">Sign in, and the directory opens. Sign in is being connected now.</span></div></div>
        <div class="row"><span class="tag">3</span><div><b>Ask us anything</b><br /><span class="meta" style="font-size:16px">Not sure who to call? Ask Dillon and he will point you the right way.</span></div></div>
      </div>
      <div class="side">
        <div class="card pad pick">
          <p class="eyebrow">Hear first</p><h3 style="margin-bottom:8px">Be the first to know.</h3>
          <p class="meta" style="margin-bottom:16px;font-size:16px">Join In the Loop and we will tell you when the directory opens.</p>
          <form action={config.newsletterAction} method="post">
            <label class="sr" for="ld-email">Your email</label><input id="ld-email" name="email" type="email" required placeholder="name@email.com" />
            <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" id="ld-return" />
            <button class="btn" type="submit" style="width:100%;margin-top:12px">Join In the Loop</button>
          </form>
        </div>
        <div class="card pad" style="margin-top:24px"><p class="eyebrow">Questions</p><p style="margin-bottom:16px">Looking for a specific kind of help right now?</p><a class="btn line" href={url('/ask-dillon')}>Ask Dillon</a></div>
      </div>
    </div>
  </section>
  <script is:inline>(function () { var r = document.getElementById('ld-return'); if (r) r.value = location.origin + location.pathname; })();</script>
</Base>
