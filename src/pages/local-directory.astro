    function empty(text, linkText) { var d = el('div', 'dx-empty'); d.appendChild(document.createTextNode(text + ' ')); if (linkText) d.appendChild(a(DX.ask, linkText)); return d; }

    // ---- 1. results, right under the search
    function drawResults() {
      var box = $('dx-results'), q = S.q.trim(), res = null, title = '';
