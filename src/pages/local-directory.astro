      var grid = $('dx-rgrid'); grid.textContent = '';
      list.slice(0, S.shown).forEach(function (x) { grid.appendChild(cardFor(x)); });
      if (!list.length && !(S.type === 'pr' && !S.signed)) { var ne = el('div', 'dx-note'); ne.appendChild(empty('Nothing matches that yet.', 'Ask Dillon who to call')); note.appendChild(ne); }
      $('dx-rmore-wrap').hidden = list.length <= S.shown;
      box.hidden = false;
    }
    function hashSync() { try { history.replaceState(null, '', location.pathname + location.search + (S.q.trim().length >= 2 ? '#search=' + encodeURIComponent(S.q.trim()) : '')); } catch (e) {} }
    function markTabs() { [].slice.call($('dx-tabs').querySelectorAll('.chip')).forEach(function (b) { var on = b.getAttribute('data-t') === S.type; b.classList.toggle('on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); }); }
    function markTiles() { [].slice.call($('dx-tiles').querySelectorAll('.dx-tile')).forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-p') === S.preset ? 'true' : 'false'); }); }
    function status() {
