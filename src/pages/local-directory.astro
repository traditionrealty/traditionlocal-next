---
import Base from '../layouts/Base.astro';
import AuthClient from '../components/AuthClient.astro';
import '../styles/pages.css';
import '../styles/dock.css';
import { url } from '../lib/data';
import { areaPages } from '../lib/helpers';
const here = Astro.url.pathname.replace(/\/?$/, '/');
const back = encodeURIComponent(here);
const areas = areaPages().map((p) => p.name).sort();
const DX = { businesses: url('/directory-businesses.json'), signin: url('/sign-in?next=' + back), create: url('/sign-in?next=' + back + '#create'), ask: url('/ask-dillon'), areas };
---
<Base title="Local Directory" active="More" description="Search the sponsors, service providers, and local businesses we know and trust.">
<div class="dx">
  <section class="band hero dock-hero">
    <div class="wrap">
      <p class="eyebrow">Local Directory</p>
      <h1 style="margin-bottom:12px">What Do You Need Help With?</h1>
      <p class="lead" style="margin-bottom:0">Search the directory, or start with the moment you are in. Members see it all, including the pros we would call ourselves.</p>
    </div>
  </section>

  <section class="band results dx-main">
    <div class="fdock" id="f-dock">
      <div class="wrap">
        <div class="fbar">
          <div class="fbar-row">
            <div class="fbar-search">
              <form id="dx-form" role="search" autocomplete="off">
                <label for="dx-q">Search the directory</label>
                <input id="dx-q" type="search" placeholder="Search by name, kind of help, or neighborhood" />
              </form>
            </div>
          </div>
          <div class="fbar-status">
            <div class="dx-tabs" id="dx-tabs" role="group" aria-label="Show">
              <button class="chip on" type="button" data-t="" aria-pressed="true">All</button>
              <button class="chip" type="button" data-t="sp" aria-pressed="false">Sponsors</button>
              <button class="chip" type="button" data-t="pr" aria-pressed="false">Service providers</button>
              <button class="chip" type="button" data-t="bz" aria-pressed="false">Businesses</button>
            </div>
            <span class="meta" id="dx-status"></span>
          </div>
        </div>
      </div>
    </div>
    <div class="wrap">
      <div id="dx-results" class="dx-results" tabindex="-1" hidden>
        <div class="dx-bar">
          <div><p class="eyebrow">Results</p><h2 id="dx-rt" aria-live="polite"></h2></div>
          <div class="dx-barr"><span class="dx-legend" aria-hidden="true"><span class="dx-badge sp">Sponsor</span><span class="dx-badge pr">Service provider</span><span class="dx-badge bz">Business</span></span><button type="button" class="btn line sm" id="dx-clear">Clear search</button></div>
        </div>
        <div id="dx-note"></div>
        <div id="dx-rgrid" class="dx-g3"></div>
        <p id="dx-rmore-wrap" hidden style="margin-top:28px"><button type="button" class="btn line" id="dx-rmore">Show more</button></p>
      </div>
    </div>
  </section>

  <section class="dx-sec" aria-label="Main sponsor">
    <div class="wrap">
      <div class="dx-bhead"><span class="dx-badge sp">Main sponsor</span><span class="meta">Sponsors pay to be listed. Their support keeps Tradition Local free for neighbors.</span></div>
      <div id="dx-main"></div>
    </div>
  </section>

  <section class="dx-sec dx-start" aria-label="Start here">
    <div class="wrap">
      <p class="eyebrow">Start here</p>
      <h2>What Are You Working On?</h2>
      <p class="dx-sub">Tap one and we will fill in matching sponsors, pros, and places right under the search box.</p>
      <div class="dx-g4" id="dx-tiles"><button type="button" class="dx-tile" data-p="moving" aria-pressed="false"><span class="dx-tico"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1D1A6D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg></span><h3>Moving in</h3><span class="dx-tt">Inspectors, movers, lenders, and the basics nearby.</span><span class="dx-go">Show matches above</span></button><button type="button" class="dx-tile" data-p="fixing" aria-pressed="false"><span class="dx-tico"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1D1A6D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6.5a4 4 0 0 0 5 5L9 22l-4-4L15.5 7.5z"/><path d="M14.5 6.5l3-3"/></svg></span><h3>Fixing up</h3><span class="dx-tt">Plumbers, roofers, painters, and trusted contractors.</span><span class="dx-go">Show matches above</span></button><button type="button" class="dx-tile" data-p="settling" aria-pressed="false"><span class="dx-tico"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1D1A6D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10h2a2 2 0 0 1 0 4h-2"/></svg></span><h3>Settling in</h3><span class="dx-tt">Coffee, groceries, and the places you will return to.</span><span class="dx-go">Show matches above</span></button><button type="button" class="dx-tile" data-p="going" aria-pressed="false"><span class="dx-tico"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1D1A6D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z"/></svg></span><h3>Going out</h3><span class="dx-tt">Dinner, dessert, and a night worth planning.</span><span class="dx-go">Show matches above</span></button></div>
    </div>
  </section>

  <section class="dx-sec dx-ivory" aria-label="Our short list" id="dx-short">
    <div class="wrap">
      <div class="dx-bar">
        <div><p class="eyebrow">Service providers</p><h2>Our Short List</h2><p class="dx-sub" style="margin-bottom:0">Three people we would call ourselves in each category, and why.</p></div>
        <div class="dx-barr" id="dx-ctl"><span class="meta dx-lock-l">Members only</span>
          <button type="button" class="dx-rnd" id="dx-prev" aria-label="Previous category"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1D1A6D" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
          <button type="button" class="dx-rnd" id="dx-pause" aria-label="Pause rotation" aria-pressed="false"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="#1D1A6D"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></button>
          <button type="button" class="dx-rnd" id="dx-next" aria-label="Next category"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1D1A6D" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button></div>
      </div>
      <div id="dx-stabs" class="dx-stabs" role="tablist" aria-label="Categories"></div>
      <div id="dx-spanel" role="tabpanel" aria-live="off"></div>
      <p id="dx-scap" class="meta" style="margin-top:20px;font-size:13px"></p>
    </div>
  </section>

  <section class="dx-sec" aria-label="Places to know" id="dx-near">
    <div class="wrap">
      <div class="dx-bar">
        <div><p class="eyebrow">Places to know</p><h2 id="dx-nh">Near You</h2><p class="dx-sub" style="margin-bottom:0">Businesses, service providers, and sponsors close to your favorite community.</p></div>
        <div class="dx-barr" id="dx-pillbox" hidden><span class="dx-pill"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1E7A43" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg><span id="dx-comm">Your community</span></span><button type="button" class="dx-link" id="dx-change">Change</button></div>
      </div>
      <div id="dx-pick" class="dx-lock" hidden>
        <p id="dx-pickt">Pick your favorite community and we will show places near it.</p>
        <div class="acts"><label class="sr" for="dx-sel">Your community</label><select id="dx-sel"><option value="">Choose a community</option></select><button type="button" class="btn" id="dx-setc">Show places near me</button></div>
      </div>
      <div id="dx-ngrid" class="dx-g3"></div>
      <div id="dx-nnote"></div>
      <p id="dx-nmore-wrap" hidden style="margin-top:28px"><button type="button" class="btn line" id="dx-nmore">See everything near this community</button></p>
    </div>
  </section>

  <section class="band navy">
    <div class="wrap dx-cta">
      <div><p class="eyebrow">Missing someone?</p><h2 style="color:#fff">Know a Great Pro or Business We Should Add?</h2></div>
      <a class="btn gold" href={DX.ask}>Tell Dillon</a>
    </div>
  </section>
</div>

<style is:global>
  .dx [hidden] { display: none !important; }
  .band.results.dx-main { padding-bottom: 0; }
  .dx-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .dx-tabs .chip { min-height: var(--control-h-sm); padding: 0 14px; font-size: var(--fs-small); font-weight: 500; }
  #dx-status a { font-weight: 700; }
  .dx-g3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .dx-g4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 960px) { .dx-g3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .dx-g4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .dx-g3, .dx-g4 { grid-template-columns: 1fr; } }
  .dx-results { padding: 40px 0 8px; outline: none; }
  .dx-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 22px; }
  .dx-bar h2 { margin: 0; }
  .dx-barr { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
  .dx-legend { display: inline-flex; flex-wrap: wrap; gap: 8px; }
  .dx-sec { padding: 64px 0 8px; }
  .dx-sec h2 { margin: 0 0 8px; }
  .dx-sub { font-size: 17px; max-width: 640px; margin: 0 0 24px; }
  .dx-ivory { background: var(--ivory); padding: 72px 0 64px; margin-top: 64px; }
  .dx-start + .dx-ivory { margin-top: 64px; }
  #dx-near { padding-bottom: 72px; }
  .dx-bhead { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 14px; }
  .dx-badge { display: inline-flex; align-items: center; padding: 3px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; line-height: 1.5; white-space: nowrap; }
  .dx-badge.sp { background: var(--gold); color: var(--navy); }
  .dx-badge.pr { background: var(--navy); color: #fff; }
  .dx-badge.bz { background: var(--green); color: #fff; }
  .dx-card { display: flex; flex-direction: column; gap: 8px; }
  .dx-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .dx-rate { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; font-weight: 700; }
  .dx-card h4 { margin: 6px 0 0; }
  .dx-card p { margin: 0; }
  .dx-acts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 8px; }
  .dx-acts .btn { min-height: 40px; padding: 0 16px; font-size: 14px; }
  .dx-split { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); overflow: hidden; border-color: var(--gold); padding: 0; }
  .dx-splitl { background: var(--navy); padding: 40px; display: flex; align-items: center; justify-content: center; min-height: 240px; }
  .dx-logobox { width: 100%; min-height: 104px; border-radius: var(--radius); background: rgba(255, 255, 255, .1); display: flex; align-items: center; justify-content: center; padding: 14px; color: #fff; font-family: var(--serif); font-weight: 600; font-size: 24px; text-align: center; }
  .dx-logobox img { max-width: 100%; max-height: 120px; object-fit: contain; background: #fff; border-radius: 8px; padding: 8px; }
  .dx-splitr { padding: 40px; display: flex; flex-direction: column; gap: 12px; justify-content: center; background: var(--ivory); }
  .dx-splitr h3 { font-size: 36px; line-height: 1.15; margin: 0; }
  .dx-splitr p { font-size: 18px; max-width: 560px; margin: 0; }
  @media (max-width: 760px) { .dx-split { grid-template-columns: 1fr; } .dx-splitl, .dx-splitr { padding: 28px; } }
  .dx-tile { text-align: left; display: flex; flex-direction: column; gap: 8px; padding: 20px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); color: var(--navy); font: inherit; cursor: pointer; }
  .dx-tile[aria-pressed="true"] { border: 2px solid var(--navy); background: var(--ivory); padding: 19px; }
  .dx-tile:hover { border-color: var(--navy); }
  .dx-tile h3 { margin: 4px 0 0; font-size: 22px; }
  .dx-tico { width: 48px; height: 48px; border-radius: 10px; background: #fff; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; }
  .dx-tt { color: var(--slate); font-size: 15px; }
  .dx-go { margin-top: 6px; font-weight: 700; color: var(--blue); font-size: 14px; }
  .dx-rnd { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--navy); background: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; }
  .dx-stabs { display: flex; flex-wrap: wrap; gap: 6px; border-bottom: 1px solid var(--line); margin-bottom: 28px; }
  .dx-stab { min-height: 48px; padding: 0 22px; border: 0; border-bottom: 4px solid transparent; background: transparent; color: var(--slate); font: 500 17px var(--sans); margin-bottom: -1px; cursor: pointer; }
  .dx-stab[aria-selected="true"] { border-bottom-color: var(--navy); color: var(--navy); font-weight: 700; }
  .dx-quote { border-left: 4px solid var(--gold); padding-left: 16px; margin-bottom: 4px; }
  .dx-quote .eyebrow { margin-bottom: 6px; }
  .dx-quote p { font-size: 18px; line-height: 1.5; }
  .dx-pill { display: inline-flex; align-items: center; gap: 8px; padding: 0 16px; min-height: 44px; border-radius: 999px; border: 1.5px solid var(--navy); font-weight: 700; font-size: 15px; }
  .dx-link { background: none; border: 0; padding: 8px 4px; color: var(--blue); font: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; }
  .dx-lock { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; padding: 24px; border: 1px solid var(--gold); background: var(--ivory); border-radius: var(--radius); }
  .dx-lock p { flex: 1 1 320px; margin: 0; font-size: 17px; }
  .dx-lock .acts { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .dx-lock select { min-width: 220px; }
  .dx-lock-l { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; margin-right: 8px; }
  .dx-empty { padding: 18px 22px; border-radius: var(--radius); background: var(--ivory); border: 1px solid var(--line); max-width: 720px; font-size: 16px; }
  .dx-empty a, .dx-note a { font-weight: 700; }
  .dx-note { margin-bottom: 20px; }
  .dx-cta { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
</style>

<AuthClient />
<script is:inline define:vars={{ DX }}>
  (function () {
    var A = window.TLAuth, c = A && A.client();
    var $ = function (i) { return document.getElementById(i); };
    var S = { signed: false, sp: [], pr: [], bz: [], ready: { s: false, p: false, b: false }, type: '', preset: '', q: '', shown: 24, tab: 0, paused: false, timer: null, mainPick: Math.floor(Math.random() * 1000) };
    var CATS = [{ l: 'Lenders', one: 'lenders', re: /lend|mortgage/i }, { l: 'Inspectors', one: 'inspectors', re: /inspect/i }, { l: 'Home warranty', one: 'home warranty providers', re: /warrant/i }, { l: 'Lawyers', one: 'lawyers', re: /lawyer|attorney|legal/i }];
    var PRESETS = {
      moving: { t: 'Moving in', pr: /lend|mortgage|inspect|mover|moving|warrant|lawyer|attorney|title|insur/i, bz: /grocer|supermarket|pharmac|market/i, sp: /lend|mortgage|inspect|mov|warrant|law|insur|title/i },
      fixing: { t: 'Fixing up', pr: /plumb|roof|paint|contractor|electric|hvac|heating|cooling|handyman|landscap|clean|pest|floor|remodel|repair|construct|window|foundation|garage|lock|pool|rekey/i, bz: /hardware|home improvement|furniture|garden|nursery|lumber|appliance/i, sp: /plumb|roof|paint|contract|electric|hvac|repair|remodel|clean|landscap/i },
      settling: { t: 'Settling in', pr: /insur|pet|vet|dent|doctor|physician|trainer|chiropract/i, bz: /coffee|grocer|market|gym|fitness|salon|bakery|cafe|yoga|barber|spa/i, sp: /coffee|grocer|gym|fitness|salon|bakery|cafe|yoga|barber|spa|pet|vet/i },
      going: { t: 'Going out', pr: /photograph|cater|event|dj|florist|limo|planner/i, bz: null, sp: /restaurant|bar|dessert|event|cater|dining|brew|wine|food/i }
    };
    var TYPES = { sp: 'Sponsors', pr: 'Service providers', bz: 'Businesses' };
    var STAR = '<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="#E7BC52"><path d="M12 2l3 7 7 .6-5.3 4.7 1.6 7.2L12 17.8 5.7 21.5l1.6-7.2L2 9.6 9 9z"/></svg>';

    function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null && text !== '') e.textContent = text; return e; }
    function a(href, text, cls, rel) { var x = el('a', cls, text); x.href = href; if (rel) { x.target = '_blank'; x.rel = rel; } return x; }
    function norm(s) { return String(s || '').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').trim(); }
    function safeUrl(u) { u = String(u || '').trim(); if (!u) return ''; if (!/^https?:\/\//i.test(u)) u = 'https://' + u; try { var p = new URL(u); return /^https?:$/.test(p.protocol) ? p.href : ''; } catch (e) { return ''; } }
    function safeImg(u) { u = String(u || '').trim(); return /^https:\/\//i.test(u) || /^\/[^\/]/.test(u) ? u : ''; }
    function safeTel(p) { var d = String(p || '').replace(/[^0-9+]/g, ''); return d.length >= 7 ? d : ''; }
    function safeMail(m) { m = String(m || '').trim(); return /^[^\s@<>"]+@[^\s@<>"]+\.[^\s@<>"]+$/.test(m) ? m : ''; }
    function plural(n, w) { return n + ' ' + w + (n === 1 ? '' : 's'); }
    function reduced() { try { return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { return false; } }
    function ls(k) { try { var v = localStorage.getItem(k); return v ? JSON.parse(v) : ''; } catch (e) { return ''; } }
    function lsSet(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }

    // ---- searching: every word must appear somewhere in the name, kind, area, or description
    function find(items, q, fields, nameKey) {
      var words = norm(q).split(' ').filter(Boolean); if (!words.length) return [];
      var out = [];
      items.forEach(function (it) {
        if (!it._h) it._h = norm(fields(it).join(' '));
        if (!words.every(function (w) { return it._h.indexOf(w) > -1; })) return;
        var nm = norm(it[nameKey]), score = 1;
        if (nm.indexOf(words[0]) === 0) score += 3; else if (words.every(function (w) { return nm.indexOf(w) > -1; })) score += 2;
        out.push({ it: it, s: score });
      });
      out.sort(function (x, y) { return y.s - x.s || String(x.it[nameKey]).localeCompare(String(y.it[nameKey])); });
      return out.map(function (o) { return o.it; });
    }
    function searchAll(q) {
      return {
        sp: find(S.sp, q, function (s) { return [s.name, s.tagline, s.service_area]; }, 'name'),
        pr: S.signed ? find(S.pr, q, function (p) { return [p.name, p.category, p.contact_name, p.why, p.service_area]; }, 'name') : null,
        bz: find(S.bz, q, function (b) { return [b.n, b.k, b.a, b.f ? 'food and drink' : 'shops and services']; }, 'n')
      };
    }
    function byPreset(key) {
      var P = PRESETS[key];
      var bz = S.bz.filter(function (b) { return key === 'going' ? (b.f && !/grocer|market/i.test(b.k)) : (P.bz && P.bz.test(b.k)); });
      bz.sort(function (x, y) { return (y.s || 0) - (x.s || 0) || x.n.localeCompare(y.n); });
      return {
        sp: S.sp.filter(function (s) { return P.sp.test([s.name, s.tagline].join(' ')); }),
        pr: S.signed ? S.pr.filter(function (p) { return P.pr.test([p.category, p.name].join(' ')); }) : null,
        bz: bz
      };
    }

    // ---- cards, each with a badge that says what it is
    function badge(kind) { return el('span', 'dx-badge ' + kind, kind === 'sp' ? 'Sponsor' : kind === 'pr' ? 'Service provider' : 'Business'); }
    function top(kind, rating) {
      var t = el('div', 'dx-top'); t.appendChild(badge(kind));
      if (rating > 0) { var r = el('span', 'dx-rate'); r.innerHTML = STAR; r.appendChild(document.createTextNode(rating + ' out of 5')); t.appendChild(r); }
      return t;
    }
    function sponsorCard(s) {
      var card = el('div', 'card pad dx-card'); card.appendChild(top('sp')); card.appendChild(el('h4', '', s.name));
      var meta = [s.tagline, s.service_area].filter(Boolean).join(' · '); if (s.tagline) card.appendChild(el('p', 'meta', s.tagline)); else if (s.service_area) card.appendChild(el('p', 'meta', s.service_area));
      var w = safeUrl(s.website); if (w) { var l = el('div', 'dx-acts'); l.appendChild(a(w, 'Visit website', 'btn line', 'sponsored noopener')); card.appendChild(l); }
      return card;
    }
    function providerCard(p) {
      var card = el('div', 'card pad dx-card'); card.appendChild(top('pr')); card.appendChild(el('h4', '', p.name));
      card.appendChild(el('p', 'meta', [p.category, p.service_area ? 'serves ' + p.service_area : ''].filter(Boolean).join(', ')));
      if (p.contact_name) card.appendChild(el('p', 'meta', 'Ask for ' + p.contact_name)); if (p.why) card.appendChild(el('p', '', p.why));
      var l = el('div', 'dx-acts'), t = safeTel(p.phone), m = safeMail(p.email), w = safeUrl(p.website);
      if (t) l.appendChild(a('tel:' + t, 'Call', 'btn line')); if (m) l.appendChild(a('mailto:' + m, 'Email', 'btn line')); if (w) l.appendChild(a(w, 'Website', 'btn line', 'noopener'));
      if (l.children.length) card.appendChild(l); return card;
    }
    function bizCard(b) {
