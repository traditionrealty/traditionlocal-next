---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { href, url } from '../lib/data';
import { areaPages, cleanList, REGIONS } from '../lib/helpers';
import { config } from '../config';
const areas = areaPages().map((p) => ({ n: p.name, u: href(p), r: p.region, b: p.bestFor, s: p.summary, t: [p.summary, p.bestFor, p.typicalHomes, p.localTake, cleanList(p.schools)].join(' ').toLowerCase() }));
const found = [...new Set(areas.map((a) => a.r).filter(Boolean))];
const regions = [...REGIONS.filter((r) => found.includes(r)), ...found.filter((r) => !REGIONS.includes(r))];
const priorities = [['food', 'Food and coffee nearby'], ['parks', 'Parks and space'], ['schools', 'Good schools'], ['commute', 'A shorter commute'], ['quiet', 'Quiet streets'], ['walk', 'Walkable and lively'], ['newer', 'Newer homes'], ['value', 'Value for the money']];
const homes = [['single', 'Single family home'], ['town', 'Townhome or condo'], ['newbuild', 'New construction'], ['acreage', 'Acreage or country living']];
---
<Base title="Find your fit" active="More" sub="makeithome" description="Answer a few questions to see which Houston neighborhoods match what you love.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Find your fit</p>
      <h1 style="margin-bottom:16px;max-width:880px">Which neighborhood fits your life?</h1>
      <p class="lead">Answer three quick questions. We will suggest areas from our neighborhood guides, and you can take it from there.</p>
    </div>
  </section>
  <section class="band">
    <div class="wrap split">
      <div class="main">
        <form class="panel" id="fit-form" novalidate>
          <fieldset style="border:0;padding:0;margin:0 0 28px"><legend style="font-size:13px;font-weight:700;margin-bottom:10px">1. What matters most? <span class="fit-hint">Pick as many as you like.</span></legend>
            <div class="chips">{priorities.map(([k, l]) => <label class="chip" style="cursor:pointer"><input type="checkbox" name="prior" value={k} data-label={l} style="position:absolute;opacity:0;width:1px;height:1px" />{l}</label>)}</div></fieldset>
          <fieldset style="border:0;padding:0;margin:0 0 28px"><legend style="font-size:13px;font-weight:700;margin-bottom:10px">2. What kind of home?</legend>
            <div class="chips">{homes.map(([k, l]) => <label class="chip" style="cursor:pointer"><input type="checkbox" name="home" value={k} data-label={l} style="position:absolute;opacity:0;width:1px;height:1px" />{l}</label>)}</div></fieldset>
          <fieldset style="border:0;padding:0;margin:0 0 28px"><legend style="font-size:13px;font-weight:700;margin-bottom:10px">3. Where in the Houston area? <span class="fit-hint">Leave blank for anywhere.</span></legend>
            <div class="chips">{regions.map((r) => <label class="chip" style="cursor:pointer"><input type="checkbox" name="region" value={r} data-label={r} style="position:absolute;opacity:0;width:1px;height:1px" />{r}</label>)}</div></fieldset>
          <div class="fit-foot"><p class="fit-status" id="fit-status" aria-live="polite">Choose what matters to you, and your matches appear below.</p><button class="btn line" type="reset" id="fit-reset">Start over</button></div>
        </form>
        <div id="fit-results" class="hidden" style="margin-top:40px">
          <p class="eyebrow">Your matches</p><h2 style="margin-bottom:8px">Neighborhoods to explore</h2>
          <p class="meta" id="fit-note" style="margin-bottom:24px"></p>
          <div class="grid g2" id="fit-grid"></div>
          <p class="fit-more hidden" id="fit-more-wrap"><button class="btn line" id="fit-more" type="button">Show 6 more matches</button></p>
          <div class="card pad hidden" id="fit-none"><b>We did not find a close match for that mix.</b><p class="meta" style="margin-top:4px">Try fewer choices, or ask Dillon and he will suggest a few areas.</p></div>
          <div class="card pad pick hidden" id="fit-locally" style="margin-top:24px;padding:32px">
            <p class="eyebrow">Keep exploring <span id="fit-locally-name"></span></p>
            <h3 style="margin-bottom:8px">Locally Plus, for where you might land.</h3>
            <p class="meta" style="margin-bottom:20px;font-size:16px">For now, signing up joins In the Loop, and Locally Plus for your top match follows when it opens.</p>
            <form action={config.newsletterAction} method="post" style="display:flex;gap:10px;flex-wrap:wrap">
              <div style="flex:1;min-width:220px"><label class="sr" for="fit-email">Your email</label><input id="fit-email" name="email" type="email" required placeholder="name@email.com" /></div>
              <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" class="nl-return" />
              <button class="btn" type="submit">Get Locally Plus</button>
            </form>
          </div>
        </div>
      </div>
      <div class="side">
        <div class="card pad" style="margin-bottom:24px"><p class="eyebrow">Your neighborhood visit list</p><div id="visit-list"></div><p class="meta" style="margin-top:8px">Saved on this device.</p></div>
        <div class="card pad"><p class="eyebrow">How this works</p><p class="meta" style="font-size:16px">Matches come from what we wrote in each neighborhood guide, so they are a starting point, not a verdict. Always visit before you decide.</p></div>
        <div class="card pad pick" style="margin-top:24px"><p class="eyebrow">Want a person?</p><h3 style="margin-bottom:8px">Ask Dillon.</h3><p class="meta" style="margin-bottom:16px;font-size:16px">Tell us what you are looking for, and he will reply personally.</p><a class="btn" href={url('/ask-dillon')} style="width:100%">Ask Dillon</a></div>
      </div>
    </div>
  </section>
  <style is:global>
    .fit-hint { font-size: 12px; font-weight: 400; font-style: italic; color: var(--slate); }
    .fit-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px 16px; }
    .fit-status { margin: 0; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--slate); }
    .fit-foot .btn { margin-left: auto; }
    .fit-more { margin: 24px 0 0; }
  </style>

  <script is:inline define:vars={{ AREAS: areas }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var PRIOR = { food: ['restaurant', 'food', 'coffee', 'dining', 'cafe', 'eat'], parks: ['park', 'trail', 'green', 'yard', 'space', 'lake', 'outdoor', 'nature'], schools: ['school', 'isd', 'families', 'family'], commute: ['commute', 'downtown', 'freeway', 'minutes', 'central', 'close to', 'galleria', 'medical center', 'energy corridor'], quiet: ['quiet', 'peaceful', 'tucked', 'established', 'tree', 'private', 'calm', 'small town', 'laid back'], walk: ['walkable', 'walk', 'lively', 'nightlife', 'urban', 'inner loop', 'inside the loop', 'bike', 'townhome'], newer: ['new construction', 'new build', 'newer', 'master planned', 'new homes', 'developing', 'growing'], value: ['affordable', 'value', 'budget', 'starter', 'price'] };
      var HOME = { single: ['single family', 'ranch', 'bungalow', 'yard', 'detached'], town: ['townhome', 'townhouse', 'condo', 'high rise', 'patio home', 'loft'], newbuild: ['new construction', 'new build', 'newer', 'new homes', 'master planned'], acreage: ['acreage', 'rural', 'acre', 'country', 'horse'] };
      var form = $('fit-form');
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      function paint() { form.querySelectorAll('label.chip').forEach(function (l) { l.classList.toggle('on', l.querySelector('input').checked); }); }
      form.addEventListener('change', paint);
      function picked(name) { return [].map.call(form.querySelectorAll('input[name=' + name + ']:checked'), function (i) { return { k: i.value, l: i.dataset.label }; }); }
      function hits(text, words) { var n = 0; words.forEach(function (w) { if (text.indexOf(w) > -1) n++; }); return n; }
      var shown = 6, STEP = 6;
      function update() {
        var pr = picked('prior'), hm = picked('home'), rg = picked('region').map(function (x) { return x.k; });
        var any = pr.length || hm.length, st = $('fit-status'), res = $('fit-results');
        if (!any && !rg.length) { res.classList.add('hidden'); st.textContent = 'Choose what matters to you, and your matches appear below.'; return; }
        var scored = AREAS.filter(function (a) { return !rg.length || rg.indexOf(a.r) > -1; }).map(function (a) {
          var score = 0, why = [];
          pr.forEach(function (p) { var h = hits(a.t, PRIOR[p.k]); if (h) { score += Math.min(h, 2) * 2; why.push(p.l); } });
          hm.forEach(function (p) { var h = hits(a.t, HOME[p.k]); if (h) { score += Math.min(h, 2) * 2; why.push(p.l); } });
          return { a: a, score: score, why: why };
        });
        var all = scored.filter(function (x) { return any ? x.score >= 2 : true; }).sort(function (x, y) { return y.score - x.score || x.a.n.localeCompare(y.a.n); });
        var top = all.slice(0, shown), n = all.length;
        res.classList.remove('hidden');
        st.innerHTML = n ? n + (n === 1 ? ' area mentions' : ' areas mention') + ' what you picked. <a href="#fit-results">See the closest</a>' : 'No close match yet. Try fewer choices.';
        $('fit-note').textContent = any ? 'Ranked by how closely each guide matches your choices.' : 'Add what matters most or the kind of home, and these will be ranked for you.';
        $('fit-grid').innerHTML = top.map(function (x) { return '<div class="card pad"><div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">' + (x.a.r ? '<span class="tag soft">' + esc(x.a.r) + '</span>' : '') + x.why.map(function (w) { return '<span class="tag">' + esc(w) + '</span>'; }).join('') + '</div><h4 style="margin-bottom:6px"><a href="' + esc(x.a.u) + '" style="text-decoration:none">' + esc(x.a.n) + '</a></h4><p class="meta" style="font-size:15px;margin-bottom:14px">' + esc(x.a.b || x.a.s) + '</p><button type="button" class="btn line sm add-visit" data-n="' + esc(x.a.n) + '" data-u="' + esc(x.a.u) + '">Add to my visit list</button></div>'; }).join('');
        $('fit-more-wrap').classList.toggle('hidden', n <= shown);
        $('fit-locally').classList.toggle('hidden', top.length === 0); if (top.length) $('fit-locally-name').textContent = top[0].a.n;
        $('fit-none').classList.toggle('hidden', top.length > 0);
      }
      form.addEventListener('change', function () { shown = STEP; update(); });
      form.addEventListener('submit', function (e) { e.preventDefault(); });
      $('fit-more').addEventListener('click', function () { shown += STEP; update(); });
      function visits() { try { return JSON.parse(localStorage.getItem('tl_visit') || '[]'); } catch (e) { return []; } }
      function saveVisits(v) { try { localStorage.setItem('tl_visit', JSON.stringify(v)); } catch (e) {} }
      function drawVisits() {
        var v = visits();
        $('visit-list').innerHTML = v.length ? v.map(function (x, i) { return '<div class="row" style="padding:10px 0"><a href="' + esc(x.u) + '" style="flex:1;font-weight:700">' + esc(x.n) + '</a><span class="meta">Day ' + (i + 1) + '</span><button type="button" class="btn line sm rm-visit" data-i="' + i + '">Remove</button></div>'; }).join('') : '<p class="meta">Add a neighborhood to start your list. Try a day in each.</p>';
      }
      document.addEventListener('click', function (e) {
        var a = e.target.closest('.add-visit');
        if (a) { var v = visits(); if (!v.some(function (x) { return x.u === a.dataset.u; })) v.push({ n: a.dataset.n, u: a.dataset.u }); saveVisits(v); drawVisits(); a.textContent = 'On your list'; return; }
        var r = e.target.closest('.rm-visit'); if (r) { var v2 = visits(); v2.splice(+r.dataset.i, 1); saveVisits(v2); drawVisits(); }
      });
      document.querySelectorAll('.nl-return').forEach(function (el) { el.value = location.origin + location.pathname; });
      drawVisits();
      form.addEventListener('reset', function () { setTimeout(function () { paint(); shown = STEP; update(); }, 0); });
      update();
    })();
  </script>
</Base>
