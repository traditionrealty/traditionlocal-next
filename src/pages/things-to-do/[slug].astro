---
import Base from '../../layouts/Base.astro';
import things from '../../data/things.json';
import businesses from '../../data/businesses.json';
import areas from '../../data/areas.json';
import { url } from '../../lib/util';
export function getStaticPaths() {
  return (things as any[]).map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const area = (areas as any[]).find((a) => a.slug === t.area);
const same = (things as any[]).filter((x) => x.slug !== t.slug && ((t.area && x.area === t.area) || (!t.area && x.city === t.city))).slice(0, 6);
const eats = t.area ? (businesses as any[]).filter((b) => b.area === t.area && !b.closed).sort((a, b) => Number(b.saraPick) - Number(a.saraPick)).slice(0, 4) : [];
const full = [t.address, t.city, t.state + ' ' + t.zip].filter(Boolean).join(', ');
const map = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(full);
const host = t.website ? t.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') : '';
---
<Base title={`${t.name} in ${t.city}`} description={`${t.name} is a ${t.kind.toLowerCase()} in ${t.city}, Texas. Address, website and where to eat nearby.`}>
  <section class="band">
    <div class="wrap">
      <p class="crumb"><a href={url('/')}>Home</a> <span aria-hidden="true">&rsaquo;</span> <a href={url('/things-to-do')}>Places to visit</a> <span aria-hidden="true">&rsaquo;</span> {t.name}</p>
      <p class="kicker">{t.typeLabel} &middot; {t.city}</p>
      <h1>{t.name}</h1>
      <p class="lede">{t.kind} in {t.city}{area ? <> &middot; <a class="onblue" href={url('/cities/' + area.slug)}>{area.name}</a></> : ''}</p>
    </div>
  </section>
  <section class="wrap detail">
    <div class="main">
      {t.status !== 'open' && <div class="alert"><strong>Temporarily closed.</strong> {t.note}</div>}
      <div class="card">
        <h2>Visit</h2>
        <dl>
          <div><dt>Address</dt><dd><a href={map} target="_blank" rel="noopener">{full}</a></dd></div>
          {t.website && <div><dt>Website</dt><dd><a href={t.website} target="_blank" rel="noopener">{host}</a></dd></div>}
          <div><dt>County</dt><dd>{t.county} County</dd></div>
          <div><dt>Kind of place</dt><dd>{t.kind}</dd></div>
        </dl>
        <p class="muted small">Hours, admission and access can change, so check the operator's website before you go. Last checked {t.verified}.</p>
      </div>
      {same.length > 0 && (
        <div class="card">
          <h2>More to see {t.area ? 'in ' + (area?.name || t.city) : 'in ' + t.city}</h2>
          <ul class="links">{same.map((x: any) => <li><a href={url('/things-to-do/' + x.slug)}>{x.name}</a> <span class="muted small">{x.kind}</span></li>)}</ul>
        </div>
      )}
    </div>
    <aside>
      {eats.length > 0 && (
        <div class="card">
          <h2>Eat nearby</h2>
          <ul class="links">{eats.map((b: any) => <li><a href={url('/eat/' + b.slug)}>{b.name}</a>{b.saraPick ? <span class="pick">Sara's Pick</span> : ''}</li>)}</ul>
          <a class="btn blue sm" href={url('/cities/' + area.slug + '#eat')}>All of {area.name}</a>
        </div>
      )}
      <div class="card tint"><h2>Planning a Saturday?</h2><p>Pair a park or museum with a coffee and a good lunch.</p><a class="btn gold sm" href={url('/weekend-ideas')}>Weekend ideas</a></div>
    </aside>
  </section>
</Base>
<style>
  .crumb { font-size: 14px; color: rgba(255,255,255,.8); margin: 0 0 16px; } .crumb a { color: #dfe6fb; }
  .onblue { color: var(--gold); }
  .detail { display: grid; grid-template-columns: 1fr 340px; gap: 24px; padding-top: 32px; padding-bottom: 56px; align-items: start; }
  @media (max-width: 860px) { .detail { grid-template-columns: 1fr; } }
  .main, aside { display: flex; flex-direction: column; gap: 18px; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 22px; }
  .card.tint { background: var(--cream); }
  .card h2 { font-size: 24px; margin-bottom: 12px; }
  dl { margin: 0; } dl div { display: grid; grid-template-columns: 130px 1fr; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--line); }
  dt { color: var(--muted); font-size: 14px; } dd { margin: 0; }
  .links { list-style: none; padding: 0; margin: 0 0 14px; } .links li { padding: 7px 0; border-bottom: 1px solid var(--line); display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .pick { font-size: 12px; font-weight: 700; background: var(--gold-soft); color: var(--brown); border-radius: 99px; padding: 2px 9px; }
  .alert { background: #fbe9e7; color: #8a2c1f; border: 1px solid #f2c9c3; border-radius: 12px; padding: 14px 18px; }
  .small { font-size: 14px; } .muted { color: var(--muted); } .btn.sm { padding: 8px 18px; font-size: 14px; }
</style>
