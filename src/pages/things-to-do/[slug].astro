---
import Base from '../../layouts/Base.astro';
import '../../styles/pages.css';
import { profiles, byName, href, media, eventDates, url } from '../../lib/data';
import { eventsAtPlace, placesIn } from '../../lib/helpers';
export function getStaticPaths() { return profiles.filter((p) => p.type === 'Place').map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const m = media(p), area = byName(p.area), events = eventsAtPlace(p), near = placesIn(p.area).filter((x) => x.slug !== p.slug).slice(0, 3);
const web = p.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const status = p.status === 'Open' ? 'Open' : p.status === 'Closed' ? 'Closed' : 'Status not confirmed';
---
<Base title={p.name} description={p.summary} active="Things to do">
  <section class="band hero">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center">
      <div style="grid-column:span 7">
        <p class="meta" style="margin-bottom:12px"><a href={url('/things-to-do')} style="font-weight:700">Things to do</a> &rsaquo; {p.subCategory || 'Place'}</p>
        <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap"><span class="tag">{p.subCategory || 'Place'}</span><span class="tag soft">{status}</span></div>
        <h1 style="margin-bottom:16px">{p.name}</h1>
        <p class="lead" style="margin-bottom:28px">{p.summary || 'We are still building this profile.'}</p>
        {p.website && <a class="btn" href={p.website} rel="noopener">Visit {web}</a>}
      </div>
      <div style="grid-column:span 5">{m ? <figure style="margin:0"><img class="photo" style="height:380px;border-radius:16px" src={m.src} alt={m.alt} />{m.credit && <figcaption class="credit">{m.credit}</figcaption>}</figure> : <div class="ph" style="height:380px;border-radius:16px">Photo coming soon</div>}</div>
    </div>
  </section>
  <section class="band">
    <div class="wrap split">
      <div class="main">
        {events.length > 0 && <><p class="eyebrow">What is happening here</p><h2 style="margin-bottom:12px">Events at {p.name}</h2>{events.map((e) => <div class="row"><span class="tag">{eventDates(e)}</span><div style="flex:1;min-width:220px"><b style="font-size:18px">{e.title}</b></div><a class="btn line sm" href={href(e)}>See the event</a></div>)}</>}
        {p.description && <><p class="eyebrow" style="margin-top:40px">About</p><h2 style="margin-bottom:20px">What to know</h2><p style="font-size:18px">{p.description}</p></>}
      </div>
      <div class="side"><div class="card pad"><h3 style="margin-bottom:20px">Good to know</h3>
        {p.area && <p class="fact"><span>Area</span><b>{area ? <a href={href(area)}>{p.area}</a> : p.area}</b></p>}
        {p.address && <p class="fact"><span>Address</span><b>{p.address}{p.postalCity && `, ${p.postalCity}`}</b></p>}
        {p.phone && <p class="fact"><span>Phone</span><b>{p.phone}</b></p>}
        <p class="fact"><span>Status</span><b>{status}</b></p>
        {!p.address && <p class="meta">Address and hours are still being confirmed.</p>}
      </div></div>
    </div>
  </section>
  {near.length > 0 && <section class="band tint"><div class="wrap"><p class="eyebrow">Nearby</p><h2 style="margin-bottom:28px">Around {p.name}</h2><div class="grid g3">{near.map((x) => <a class="card pad" href={href(x)} style="text-decoration:none"><h4 style="margin-bottom:4px">{x.name}</h4><p class="meta">{x.subCategory}</p></a>)}</div></div></section>}
</Base>
