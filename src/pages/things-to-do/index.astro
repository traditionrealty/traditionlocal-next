---
import Base from '../../layouts/Base.astro';
import '../../styles/pages.css';
import '../../styles/events.css';
import { profiles, events, isClosed, href, eventDates, url } from '../../lib/data';
import { venuePlace } from '../../lib/helpers';
import { config } from '../../config';
const today = new Date(); const t0 = new Date(today.getFullYear(), today.getMonth(), today.getDate());
const toDate = (s: string) => { const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s || ''); return m ? new Date(+m[3], +m[1] - 1, +m[2]) : null; };
const pad = (n: number) => String(n).padStart(2, '0');
const iso = (d: Date) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
const dated = events().map((e) => ({ e, a: toDate(e.starts), b: toDate(e.ends || e.starts), place: venuePlace(e) })).filter((x) => x.a && x.b) as { e: any; a: Date; b: Date; place: any }[];
const list = dated.filter((x) => x.b >= t0).sort((x, y) => +x.a - +y.a || x.e.title.localeCompare(y.e.title));
// The sheet has many spellings for the same kind of event. These nine groups are what visitors choose from.
const GROUPS = ['Music and nightlife', 'Arts and culture', 'Holidays and festivals', 'Family', 'Food and drink', 'Film', 'Sports and outdoors', 'Talks and classes', 'Community'];
const MAP: Record<string, string> = { 'live music': GROUPS[0], 'nightlife': GROUPS[0], 'arts': GROUPS[1], 'gallery exhibits': GROUPS[1], 'museum exhibitions': GROUPS[1], 'museum exhibits': GROUPS[1], 'exhibit': GROUPS[1], 'exhibits': GROUPS[1], 'theater district': GROUPS[1], 'theatre & performing arts': GROUPS[1], 'theater': GROUPS[1], 'holiday': GROUPS[2], 'festivals': GROUPS[2], 'festival': GROUPS[2], 'kid-friendly': GROUPS[3], 'family': GROUPS[3], 'food & drink': GROUPS[4], 'shopping': GROUPS[4], 'film': GROUPS[5], 'sports & outdoors': GROUPS[6], 'sports': GROUPS[6], 'lectures and seminars': GROUPS[7], 'talks': GROUPS[7] };
const groupOf = (t: string) => MAP[(t || '').trim().toLowerCase()] || GROUPS[8];
const isFree = (e: any) => /^free$/i.test(e.eventType || '') || /^free/i.test(String(e.cost || '').trim()) || (e.tags || []).some((t: string) => /^free$/i.test(t));
const EVENTS = list.map((x) => ({ t: x.e.title, u: href(x.e), s: iso(x.a), f: iso(x.b), v: x.place ? x.place.name : (x.e.venue || x.e.profile || ''), g: groupOf(x.e.eventType), fr: isFree(x.e) ? 1 : 0 }));
// Events tagged Featured or Our pick in the sheet show up in Our picks. The section stays hidden when none are tagged.
const picks = list.filter((x) => x.e.tags.some((t: string) => /^(featured|our picks?|picks?)$/i.test(t))).slice(0, 3);
const places = profiles.filter((p) => p.type === 'Place' && !isClosed(p)).sort((a, b) => a.name.localeCompare(b.name));
const placeAreas = [...new Set(places.map((p) => p.area).filter(Boolean))].sort();
const clip = (s: string, n: number) => { const t = (s || '').replace(/\s+/g, ' ').trim(); return t.length > n ? t.slice(0, n - 1).trimEnd() + '…' : t; };
---
<Base title="Things to do" active="Things to do" description="Events, places, and weekend ideas, checked and sorted for you.">
  <section class="band hero tt-hero">
    <div class="wrap">
      <p class="eyebrow">Make a little time for local</p>
      <h1 style="margin-bottom:12px">Things to do in Houston</h1>
      <p class="lead" style="margin-bottom:0">Festivals, markets, music, and small neighborhood happenings, checked and sorted for you.</p>
    </div>
  </section>

  {picks.length > 0 && (
    <section class="band tint" id="our-picks"><div class="wrap"><p class="eyebrow">Our picks</p><h2 style="margin-bottom:28px">Worth planning around</h2>
      <div class="grid g3">{picks.map((x) => <a class="card pad pick" href={href(x.e)} style="text-decoration:none"><span class="tag">{eventDates(x.e)}</span><h4 style="margin:12px 0 6px">{x.e.title}</h4><p class="meta">{x.place ? x.place.name : (x.e.venue || x.e.profile || 'Houston')}</p></a>)}</div></div></section>
  )}

  <section class="band tt-main" id="events">
    <div class="wrap">
      <div class="tt-bar" id="t-bar">
        <div class="tt-seg" id="t-when" role="group" aria-label="When"><button type="button" data-w="today" aria-pressed="false">Today</button><button type="button" data-w="weekend" aria-pressed="false"><span class="l">This weekend</span><span class="s">Weekend</span></button><button type="button" class="on" data-w="week" aria-pressed="true"><span class="l">Next 7 days</span><span class="s">7 days</span></button><button type="button" data-w="month" aria-pressed="false"><span class="l">Next 30 days</span><span class="s">30 days</span></button><button type="button" data-w="all" aria-pressed="false">All</button></div>
        <div class="tt-sel"><label class="sr" for="t-group">Type of event</label><select id="t-group"><option value="">All types</option>{GROUPS.map((g) => <option>{g}</option>)}</select></div>
        <button type="button" class="tt-free" id="t-free" aria-pressed="false">Free</button>
        <button type="button" class="tt-opencal" id="cal-open" aria-haspopup="dialog">Calendar</button>
        <span class="tt-count" id="t-count" aria-live="polite">&nbsp;</span>
      </div>
      <p class="tt-note hidden" id="t-note"></p>
      <div class="tt-strip" id="t-strip" role="group" aria-label="Pick a day"></div>
      <div class="tt-split">
        <div id="t-list"></div>
        <aside class="tt-cal" id="t-calbox" aria-label="Calendar">
          <div class="tt-cal-in" id="t-calin">
            <div class="tt-cal-head"><button type="button" id="cal-prev" aria-label="Previous month">&lsaquo;</button><h3 id="cal-title" aria-live="polite">&nbsp;</h3><button type="button" id="cal-next" aria-label="Next month">&rsaquo;</button></div>
            <div class="tt-dow" aria-hidden="true"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
            <div class="tt-grid" id="cal-grid"></div>
            <p class="tt-legend"><span class="tt-dot"></span>Days with events.<strong>Tap one to see just that day.</strong></p>
            <p class="tt-clear hidden" id="cal-clear"><button type="button" class="flink" id="day-clear">Show everything again</button></p>
            <button type="button" class="btn tt-sheet" id="sheet-done">Done</button>
          </div>
        </aside>
      </div>
      <noscript><ul>{list.slice(0, 100).map((x) => <li><a href={href(x.e)}>{x.e.title}</a>, {eventDates(x.e)}</li>)}</ul></noscript>
    </div>
  </section>

  <section class="band tint hidden" id="ongoing">
    <div class="wrap">
      <p class="eyebrow">Ongoing</p><h2 style="margin-bottom:8px">Exhibits and tours you can catch any day</h2>
      <p class="meta" id="ong-count" style="margin-bottom:12px"></p>
      <div id="t-ong"></div>
      <p style="margin-top:24px"><button class="btn line hidden" id="ong-more" type="button">Show all</button></p>
    </div>
  </section>

  <section class="band navy" id="loop-signup">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap">
      <div style="max-width:560px"><p class="eyebrow">In the Loop</p><h2 style="color:#fff;margin-bottom:10px">Start your week in the loop.</h2><p style="font-size:18px;color:#fff">Every Monday: a short, useful list of what is worth doing and the best new places to eat.</p></div>
      <form class="card pad" action={config.newsletterAction} method="post" style="flex:1;min-width:300px;max-width:460px">
        <label for="tl-email">Your email</label><input id="tl-email" name="email" type="email" required placeholder="name@email.com" />
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" class="nl-return" />
        <button class="btn" type="submit" style="width:100%;margin-top:14px">Join In the Loop</button>
        <p class="meta" style="margin-top:10px">Free, and one click to leave.</p>
      </form>
    </div>
  </section>

  <section class="band tint" id="places">
    <div class="wrap">
      <p class="eyebrow">Places to visit</p><h2 style="margin-bottom:16px">Worth a trip any day</h2>
      <div class="card pad search" style="margin-bottom:12px;display:flex;gap:16px;flex-wrap:wrap;max-width:760px"><div style="flex:2;min-width:220px"><label for="p-find">Find a place</label><input id="p-find" type="search" placeholder="Try park, market, or a name" autocomplete="off" /></div><div style="flex:1;min-width:200px"><label for="p-area">Area</label><select id="p-area"><option value="">All of Greater Houston</option>{placeAreas.map((a) => <option>{a}</option>)}</select></div></div>
      <p class="meta" id="p-count" style="margin-bottom:16px" aria-live="polite"></p>
      <div class="grid g3" id="p-grid">
        {places.map((p, i) => <a class={i < 12 ? 'card pad p-item' : 'card pad p-item hidden'} href={href(p)} data-area={p.area} data-find={[p.name, p.summary, p.subCategory, p.area].join(' ').toLowerCase()} style="text-decoration:none"><h4 style="margin-bottom:4px">{p.name}</h4>{(p.subCategory || p.area) && <p class="meta">{[p.subCategory, p.area].filter(Boolean).join(', ')}</p>}{p.summary && <p class="meta" style="margin-top:6px;font-size:15px">{clip(p.summary, 115)}</p>}</a>)}
      </div>
      <p style="margin-top:24px"><button class="btn line hidden" id="p-more" type="button">Show more places</button></p>
    </div>
  </section>

  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
      <div><h4 style="margin-bottom:4px">Hosting something local?</h4><p>Tell us about your event, and we will share it with neighbors.</p></div>
      <a class="btn" href={'mailto:traditionlocal@gmail.com?subject=' + encodeURIComponent('List my event')}>List your event</a>
    </div>
  </section>

  <script is:inline>document.querySelectorAll('.nl-return').forEach(function (el) { el.value = location.origin + location.pathname; });</script>
  <script is:inline define:vars={{ EVENTS }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var DAY = 86400000, PAGE = 20, ONG = 5;
      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      var SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      function iso(d) { return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
      function parse(s) { var p = s.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }
      function addDays(d, n) { var x = new Date(d.getFullYear(), d.getMonth(), d.getDate()); x.setDate(x.getDate() + n); return x; }
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      var now = new Date(), today = new Date(now.getFullYear(), now.getMonth(), now.getDate()), TODAY = iso(today), TOMORROW = iso(addDays(today, 1));
      var state = { when: 'week', group: '', free: false, day: null, shown: PAGE, ongAll: false, fell: '', view: new Date(today.getFullYear(), today.getMonth(), 1) };
      function span(e) { return Math.round((parse(e.f) - parse(e.s)) / DAY) + 1; }
      var SHORTEV = EVENTS.filter(function (e) { return span(e) <= 14; }), LONGEV = EVENTS.filter(function (e) { return span(e) > 14; });
      var lastEnd = SHORTEV.reduce(function (m, e) { return e.f > m ? e.f : m; }, TODAY), lastD = parse(lastEnd), MAXV = new Date(lastD.getFullYear(), lastD.getMonth(), 1), MINV = new Date(today.getFullYear(), today.getMonth(), 1);
      function live(e) { return e.f >= TODAY; }
      function passes(e) { return (!state.group || e.g === state.group) && (!state.free || e.fr); }
      function weekend() { var dow = today.getDay(), fri = dow === 6 ? addDays(today, -1) : dow === 0 ? addDays(today, -2) : addDays(today, 5 - dow); return [iso(fri), iso(addDays(fri, 2))]; }
      function whenOk(e, w) {
        if (w === 'today') return e.s <= TODAY;
        if (w === 'weekend') { var r = weekend(), from = r[0] > TODAY ? r[0] : TODAY; return e.s <= r[1] && e.f >= from; }
        if (w === 'week') return e.s <= iso(addDays(today, 7));
        if (w === 'month') return e.s <= iso(addDays(today, 30));
        return true;
      }
      function visible() { return SHORTEV.filter(function (e) { return live(e) && passes(e) && (state.day ? (e.s <= state.day && state.day <= e.f) : whenOk(e, state.when)); }); }
      function keyOf(e) { return state.day ? state.day : (e.s < TODAY ? TODAY : e.s); }
      function dayLabel(k) { var d = parse(k), full = DAYS[d.getDay()] + ', ' + MONTHS[d.getMonth()] + ' ' + d.getDate(); return k === TODAY ? 'Today, ' + full : k === TOMORROW ? 'Tomorrow, ' + full : full; }
      function shortDate(k) { var d = parse(k); return SHORT[d.getMonth()] + ' ' + d.getDate(); }
      function row(e, k) {
        var d = parse(k), thr = e.f > k ? 'Through ' + shortDate(e.f) + '. ' : '';
        return '<a class="tt-row" href="' + esc(e.u) + '"><span class="tt-d"><span class="tt-w">' + DAYS[d.getDay()].slice(0, 3).toUpperCase() + '</span><span class="tt-n">' + d.getDate() + '</span><span class="tt-m">' + SHORT[d.getMonth()] + '</span></span><span class="tt-b"><span class="tt-t">' + esc(e.t) + '</span><span class="tt-mt">' + esc(thr + [e.v || 'Houston', e.g].join(', ')) + '</span></span><span class="tt-go" aria-hidden="true"></span></a>';
      }
      function ongRow(e) {
        var f = parse(e.f), yr = f.getFullYear() !== today.getFullYear() ? ' ' + f.getFullYear() : '';
        return '<a class="tt-row" href="' + esc(e.u) + '"><span class="tt-d"><span class="tt-w">THROUGH</span><span class="tt-n">' + f.getDate() + '</span><span class="tt-m">' + SHORT[f.getMonth()] + yr + '</span></span><span class="tt-b"><span class="tt-t">' + esc(e.t) + '</span><span class="tt-mt">' + esc([e.v || 'Houston', e.g].join(', ')) + '</span></span><span class="tt-go" aria-hidden="true"></span></a>';
      }
      function emptyHtml() {
        return '<div class="card pad tt-empty"><b>Nothing listed for that choice yet.</b><p class="meta" style="margin-top:4px">Try a longer window or another type of event.</p><p style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">' + (state.day ? '<button class="btn line sm" id="e-day" type="button">Show everything again</button>' : '') + ((state.when === 'today' || state.when === 'weekend') && !state.day ? '<button class="btn line sm" id="e-week" type="button">Show the next 7 days</button>' : '') + (state.when !== 'all' && !state.day ? '<button class="btn line sm" id="e-all" type="button">See all upcoming</button>' : '') + (state.group || state.free ? '<button class="btn line sm" id="e-clear" type="button">Clear type and free</button>' : '') + '</p></div>';
      }
      function renderList() {
        var items = visible().sort(function (a, b) { var ka = keyOf(a), kb = keyOf(b); return ka < kb ? -1 : ka > kb ? 1 : (a.t < b.t ? -1 : a.t > b.t ? 1 : 0); });
        var n = items.length, html = '', last = '';
        items.slice(0, state.shown).forEach(function (e) { var k = keyOf(e); if (k !== last) { html += '<h3 class="tt-dh">' + esc(dayLabel(k)) + '</h3>'; last = k; } html += row(e, k); });
        if (!n) html = emptyHtml();
        if (n > state.shown) html += '<p class="tt-more"><button class="btn line" id="t-more" type="button">Show ' + Math.min(PAGE, n - state.shown) + ' more</button></p>';
        $('t-list').innerHTML = html;
        $('t-count').textContent = n + (n === 1 ? ' event' : ' events');
      }
      function renderOng() {
        var items = LONGEV.filter(function (e) { return live(e) && passes(e); }).sort(function (a, b) { return a.f < b.f ? -1 : a.f > b.f ? 1 : (a.t < b.t ? -1 : 1); });
        var sec = $('ongoing'); sec.classList.toggle('hidden', !items.length); if (!items.length) return;
        var show = state.ongAll ? items : items.slice(0, ONG);
        $('t-ong').innerHTML = show.map(ongRow).join('');
        $('ong-count').textContent = items.length + (items.length === 1 ? ' ongoing event' : ' ongoing events') + ', the ones ending soonest first.';
        var more = $('ong-more'); more.classList.toggle('hidden', items.length <= ONG || state.ongAll); more.textContent = 'Show all ' + items.length;
      }
      function dayCount(k) { return SHORTEV.filter(function (e) { return live(e) && passes(e) && e.s <= k && k <= e.f; }).length; }
      function label(k, c) { var d = parse(k); return DAYS[d.getDay()] + ', ' + MONTHS[d.getMonth()] + ' ' + d.getDate() + (c ? ', ' + c + (c === 1 ? ' event' : ' events') : ', no events'); }
      function drawCal() {
        var y = state.view.getFullYear(), m = state.view.getMonth(), first = new Date(y, m, 1), dim = new Date(y, m + 1, 0).getDate(), html = '', i, d;
        $('cal-title').textContent = MONTHS[m] + ' ' + y;
        for (i = 0; i < first.getDay(); i++) html += '<span></span>';
        for (d = 1; d <= dim; d++) {
          var k = iso(new Date(y, m, d)), c = dayCount(k), past = k < TODAY, on = state.day === k;
          html += '<button type="button" class="tt-day' + (c ? ' has' : '') + (k === TODAY ? ' today' : '') + (on ? ' sel' : '') + '" data-d="' + k + '"' + (past ? ' disabled' : '') + ' aria-pressed="' + on + '" aria-label="' + label(k, c) + '">' + d + '</button>';
        }
        $('cal-grid').innerHTML = html;
        $('cal-prev').disabled = state.view <= MINV; $('cal-next').disabled = state.view >= MAXV;
        $('cal-clear').classList.toggle('hidden', !state.day);
        var n = state.day ? visible().length : 0;
        $('sheet-done').textContent = state.day ? 'Show ' + n + (n === 1 ? ' event' : ' events') + ' on ' + shortDate(state.day) : 'Done';
      }
      function drawStrip() {
        var html = '', i;
        for (i = 0; i < 14; i++) { var d = addDays(today, i), k = iso(d), c = dayCount(k), on = state.day === k; html += '<button type="button" class="tt-st' + (on ? ' sel' : '') + '" data-d="' + k + '" aria-pressed="' + on + '" aria-label="' + label(k, c) + '"><span>' + (i === 0 ? 'Today' : DAYS[d.getDay()].slice(0, 3)) + '</span><b>' + d.getDate() + '</b><span>' + (c || 'none') + '</span></button>'; }
        $('t-strip').innerHTML = html;
      }
      function syncBar() {
        [].forEach.call($('t-when').children, function (b) { var on = !state.day && b.dataset.w === state.when; b.classList.toggle('on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        $('t-free').classList.toggle('on', state.free); $('t-free').setAttribute('aria-pressed', state.free ? 'true' : 'false');
        var note = $('t-note');
        if (state.fell) { note.textContent = state.fell === 'month' ? 'Nothing starts in the next 7 days, so this shows the next 30.' : 'Nothing starts in the next 30 days, so this shows everything coming up.'; note.classList.remove('hidden'); } else note.classList.add('hidden');
      }
      function all() { renderList(); renderOng(); drawCal(); drawStrip(); syncBar(); }
      function pickDay(k) {
        state.day = state.day === k ? null : k; state.shown = PAGE; state.fell = '';
        if (state.day) { var d = parse(k); state.view = new Date(d.getFullYear(), d.getMonth(), 1); }
        all();
      }
      $('t-when').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; state.when = b.dataset.w; state.day = null; state.shown = PAGE; state.fell = ''; all(); });
      $('t-group').addEventListener('change', function () { state.group = this.value; state.shown = PAGE; all(); });
      $('t-free').addEventListener('click', function () { state.free = !state.free; state.shown = PAGE; all(); });
      $('cal-grid').addEventListener('click', function (e) { var b = e.target.closest('button'); if (b && !b.disabled) pickDay(b.dataset.d); });
      $('t-strip').addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) pickDay(b.dataset.d); });
      $('day-clear').addEventListener('click', function () { state.day = null; all(); });
      $('cal-prev').addEventListener('click', function () { state.view = new Date(state.view.getFullYear(), state.view.getMonth() - 1, 1); drawCal(); });
      $('cal-next').addEventListener('click', function () { state.view = new Date(state.view.getFullYear(), state.view.getMonth() + 1, 1); drawCal(); });
      $('t-list').addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        if (b.id === 't-more') { var prev = $('t-list').querySelectorAll('.tt-row').length; state.shown += PAGE; renderList(); var rows = $('t-list').querySelectorAll('.tt-row'); if (rows[prev]) rows[prev].focus(); }
        else if (b.id === 'e-week') { state.when = 'week'; state.day = null; state.fell = ''; all(); }
        else if (b.id === 'e-all') { state.when = 'all'; state.day = null; state.fell = ''; all(); }
        else if (b.id === 'e-clear') { state.group = ''; state.free = false; $('t-group').value = ''; all(); }
        else if (b.id === 'e-day') { state.day = null; all(); }
      });
      $('ong-more').addEventListener('click', function () { state.ongAll = true; renderOng(); });
      // phone: the calendar opens as a sheet
      var box = $('t-calbox'), opener = $('cal-open');
      function openSheet() { box.classList.add('open'); $('t-calin').setAttribute('role', 'dialog'); $('t-calin').setAttribute('aria-modal', 'true'); document.body.style.overflow = 'hidden'; var f = box.querySelector('.tt-day:not(:disabled)'); if (f) f.focus(); }
      function closeSheet() { box.classList.remove('open'); $('t-calin').removeAttribute('role'); $('t-calin').removeAttribute('aria-modal'); document.body.style.overflow = ''; opener.focus(); }
      opener.addEventListener('click', openSheet);
      $('sheet-done').addEventListener('click', closeSheet);
      box.addEventListener('click', function (e) { if (e.target === box && box.classList.contains('open')) closeSheet(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && box.classList.contains('open')) closeSheet(); });
      // a quiet week falls back to the next 30 days, then to everything
      if (!visible().length) { state.when = 'month'; state.fell = 'month'; if (!visible().length) { state.when = 'all'; state.fell = 'all'; if (!visible().length) { state.when = 'week'; state.fell = ''; } } }
      all();
      var pa = $('p-area'), pf = $('p-find'), pm = $('p-more'), pc = $('p-count'), pitems = [].slice.call(document.querySelectorAll('.p-item')), shown = 12, STEP = 12;
      function pRender() {
        var q = (pf.value || '').toLowerCase().trim().split(/\s+/).filter(Boolean), match = [];
        pitems.forEach(function (i) { var ok = (!pa.value || i.dataset.area === pa.value) && q.every(function (w) { return i.dataset.find.indexOf(w) > -1; }); i.classList.add('hidden'); if (ok) match.push(i); });
        match.slice(0, shown).forEach(function (i) { i.classList.remove('hidden'); });
        pc.textContent = match.length ? 'Showing ' + Math.min(shown, match.length) + ' of ' + match.length + (match.length === 1 ? ' place' : ' places') : 'No places match. Try a shorter word or a different area.';
        pm.classList.toggle('hidden', match.length <= shown);
      }
      pa.addEventListener('change', function () { shown = STEP; pRender(); });
      pf.addEventListener('input', function () { shown = STEP; pRender(); });
      pm.addEventListener('click', function () { shown += STEP; pRender(); });
      pRender();
    })();
  </script>
