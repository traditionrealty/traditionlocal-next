---
import Base from '../../layouts/Base.astro';
import '../../styles/pages.css';
import { profiles, events, href, eventDates, url } from '../../lib/data';
import { venuePlace } from '../../lib/helpers';
import { config } from '../../config';
const today = new Date(); const t0 = new Date(today.getFullYear(), today.getMonth(), today.getDate());
const toDate = (s: string) => { const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s || ''); return m ? new Date(+m[3], +m[1] - 1, +m[2]) : null; };
const pad = (n: number) => String(n).padStart(2, '0');
const iso = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const dated = events().map((e) => ({ e, a: toDate(e.starts), b: toDate(e.ends || e.starts), place: venuePlace(e) })).filter((x) => x.a && x.b) as { e: any; a: Date; b: Date; place: any }[];
const list = dated.filter((x) => x.b >= t0).sort((x, y) => +x.a - +y.a).map((x) => ({ ...x, s: +x.a, f: +x.b }));
// every dated event, for the week view and the calendar (the browser decides what today is)
const cal = dated.map((x) => ({ t: x.e.title, s: iso(x.a), f: iso(x.b), v: x.place ? x.place.name : (x.e.venue || x.e.profile || ''), k: x.e.eventType || '', u: href(x.e) }));
// Events tagged Featured or Our pick in the sheet show up in Our picks. The section stays hidden when none are tagged.
const picks = list.filter((x) => x.e.tags.some((t: string) => /^(featured|our picks?|picks?)$/i.test(t))).slice(0, 3);
const kinds = [...new Set(list.map((x) => x.e.eventType).filter(Boolean))].sort();
const places = profiles.filter((p) => p.type === 'Place').sort((a, b) => a.name.localeCompare(b.name));
const placeAreas = [...new Set(places.map((p) => p.area).filter(Boolean))].sort();
const DAY = 86400000;
---
<Base title="Things to do" active="Things to do" description="Events, places, and weekend ideas, checked and sorted for you.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Make a little time for local</p>
      <h1 style="margin-bottom:12px">Things to do in Houston</h1>
      <p class="lead" style="margin-bottom:28px">Festivals, markets, music, and small neighborhood happenings, checked and sorted for you.</p>
      <div class="tabs" id="t-when"><button class="chip on" data-w="all" aria-pressed="true">All upcoming</button><button class="chip" data-w="weekend" aria-pressed="false">This weekend</button><button class="chip" data-w="week" aria-pressed="false">Next 7 days</button><button class="chip" data-w="month" aria-pressed="false">Next 30 days</button></div>
      {kinds.length > 0 && <div class="tabs" id="t-kind" style="margin-top:12px"><button class="chip on" data-k="" aria-pressed="true">Any kind</button>{kinds.map((k) => <button class="chip" data-k={k} aria-pressed="false">{k}</button>)}</div>}
    </div>
  </section>

  {picks.length > 0 && (
    <section class="band tint" id="our-picks"><div class="wrap"><p class="eyebrow">Our picks</p><h2 style="margin-bottom:28px">Worth planning around</h2>
      <div class="grid g3">{picks.map((x) => <a class="card pad pick" href={href(x.e)} style="text-decoration:none"><span class="tag">{eventDates(x.e)}</span><h4 style="margin:12px 0 6px">{x.e.title}</h4><p class="meta">{x.place ? x.place.name : (x.e.venue || x.e.profile || 'Houston')}</p></a>)}</div></div></section>
  )}

  <section class="band" id="this-week">
    <div class="wrap">
      <p class="eyebrow">This week</p>
      <h2 style="margin-bottom:6px">Happening this week</h2>
      <p class="meta" id="wk-range" style="margin-bottom:24px">&nbsp;</p>
      <div class="grid g3" id="wk-grid"></div>
      <div class="card pad hidden" id="wk-empty"><b>Nothing listed for the rest of this week yet.</b><p class="meta" style="margin-top:4px">Check the calendar below, or see everything coming up.</p></div>
      <p class="meta" id="wk-ongoing" style="margin-top:20px"></p>
    </div>
  </section>

  <section class="band tint" id="calendar">
    <div class="wrap">
      <p class="eyebrow">Calendar</p>
      <h2 style="margin-bottom:24px">Pick a day</h2>
      <div class="cal">
        <div class="cal-head">
          <button class="btn line sm" id="cal-prev" type="button" aria-label="Previous month">&lsaquo; Previous</button>
          <h3 id="cal-title" aria-live="polite" style="font-size:24px">&nbsp;</h3>
          <button class="btn line sm" id="cal-next" type="button" aria-label="Next month">Next &rsaquo;</button>
        </div>
        <div class="cal-grid" id="cal-dow"><div class="cal-dow">Sun</div><div class="cal-dow">Mon</div><div class="cal-dow">Tue</div><div class="cal-dow">Wed</div><div class="cal-dow">Thu</div><div class="cal-dow">Fri</div><div class="cal-dow">Sat</div></div>
        <div class="cal-grid" id="cal-grid"></div>
      </div>
      <div class="card pad" id="cal-day" style="margin-top:20px" aria-live="polite"></div>
      <div id="cal-ongoing" style="margin-top:20px"></div>
    </div>
  </section>

  <section class="band navy" id="loop-signup">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap">
      <div style="max-width:560px"><p class="eyebrow">In the Loop</p><h2 style="color:#fff;margin-bottom:10px">Start your week in the loop.</h2><p style="font-size:18px;color:#fff">Every Monday: a short, useful list of what is worth doing and the best new places to eat.</p></div>
      <form class="card pad" action={config.newsletterAction} method="post" style="flex:1;min-width:300px;max-width:460px">
        <label for="tl-email">Your email</label><input id="tl-email" name="email" type="email" required placeholder="name@email.com" />
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" class="nl-return" />
        <button class="btn" type="submit" style="width:100%;margin-top:14px">Join In the Loop</button>
        <p class="meta" style="margin-top:10px">Free, and one click to leave.</p>
      </form>
    </div>
  </section>

  <section class="band" id="coming-up">
    <div class="wrap">
      <p class="eyebrow">Events</p><h2 style="margin-bottom:8px">Coming up</h2><p class="meta" id="t-count" style="margin-bottom:12px">{list.length} events</p>
      <div id="t-list">
        {list.map((x) => (
          <div class="row t-item" data-s={x.s} data-f={x.f} data-k={x.e.eventType}>
            <span class="tag">{eventDates(x.e)}</span>
            <div style="flex:1;min-width:240px"><a href={href(x.e)} style="font-size:18px;font-weight:700;text-decoration:none">{x.e.title}</a><br /><span class="meta">{x.place ? <a href={href(x.place)}>{x.place.name}</a> : (x.e.venue || x.e.profile || 'Houston')}{x.e.eventType && `, ${x.e.eventType}`}</span></div>
            <a class="btn line sm" href={href(x.e)}>See details</a>
          </div>
        ))}
      </div>
      <div class="card pad hidden" id="t-empty" style="margin-top:8px"><b>Nothing listed for that choice yet.</b><p class="meta" style="margin-top:4px">Try another time or kind of event.</p></div>
    </div>
  </section>

  <section class="band tint" id="places">
    <div class="wrap">
      <p class="eyebrow">Places to visit</p><h2 style="margin-bottom:16px">Worth a trip any day</h2>
      <div class="card pad search" style="margin-bottom:24px"><label for="p-area">Area</label><select id="p-area"><option value="">All of Greater Houston</option>{placeAreas.map((a) => <option>{a}</option>)}</select></div>
      <div class="grid g3" id="p-grid">
        {places.map((p) => <a class="card pad p-item" href={href(p)} data-area={p.area} style="text-decoration:none"><h4 style="margin-bottom:4px">{p.name}</h4><p class="meta">{[p.subCategory, p.area].filter(Boolean).join(', ')}</p></a>)}
      </div>
    </div>
  </section>

  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
      <div><h4 style="margin-bottom:4px">Hosting something local?</h4><p>Tell us about your event, and we will share it with neighbors.</p></div>
      <a class="btn" href={`mailto:traditionlocal@gmail.com?subject=${encodeURIComponent('List my event')}`}>List your event</a>
    </div>
  </section>

  <style is:global>
    .cal { background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
    .cal-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 16px 20px; background: var(--ivory); border-bottom: 1px solid var(--line); flex-wrap: wrap; }
    .cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
    .cal-dow { padding: 8px; font-size: 12px; font-weight: 700; text-align: center; color: var(--slate); border-bottom: 1px solid var(--line); }
    .cal-day { min-height: 92px; padding: 6px; border: 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #fff; text-align: left; font: inherit; color: var(--navy); cursor: pointer; min-width: 0; }
    .cal-day:nth-child(7n) { border-right: 0; }
    .cal-day:hover { background: var(--ivory); }
    .cal-day.off { background: #FAF9F6; color: #A7A9B0; }
    .cal-day.sel { outline: 3px solid var(--blue); outline-offset: -3px; }
    .cal-day .n { display: inline-block; font-size: 13px; font-weight: 700; min-width: 24px; text-align: center; }
    .cal-day.today .n { background: var(--navy); color: #fff; border-radius: 999px; }
    .cal-day .ev { display: block; font-size: 11px; line-height: 1.3; margin-top: 3px; background: var(--butter); border-radius: 4px; padding: 1px 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cal-day .more { display: block; font-size: 11px; color: var(--slate); margin-top: 2px; }
    .cal-day .dot { display: none; width: 7px; height: 7px; border-radius: 999px; background: var(--gold); margin-top: 6px; }
    @media (max-width: 640px) { .cal-day { min-height: 56px; padding: 4px; } .cal-day .ev, .cal-day .more { display: none; } .cal-day .dot.has { display: block; } }
  </style>

  <script is:inline>document.querySelectorAll('.nl-return').forEach(function (el) { el.value = location.origin + location.pathname; });</script>
  <script is:inline define:vars={{ DAY, EVENTS: cal }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var now = new Date(), today = new Date(now.getFullYear(), now.getMonth(), now.getDate()), t0 = today.getTime();
      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      var DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      var SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      var kind = '', when = 'all', picked = null, view = new Date(today.getFullYear(), today.getMonth(), 1);
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      function parse(s) { var p = s.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }
      function iso(d) { return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
      function span(e) { return Math.round((parse(e.f) - parse(e.s)) / DAY) + 1; }
      function short(e) { return span(e) <= 14; }
      function visible() { return EVENTS.filter(function (e) { return !kind || e.k === kind; }); }
      function onDay(e, iso1) { return e.s <= iso1 && iso1 <= e.f; }
      function dateLabel(e) { var a = parse(e.s), b = parse(e.f); var x = SHORT[a.getMonth()] + ' ' + a.getDate(); return e.s === e.f ? x : x + ' to ' + SHORT[b.getMonth()] + ' ' + b.getDate(); }
      function card(e) { return '<a class="card pad" href="' + esc(e.u) + '" style="text-decoration:none"><span class="tag">' + esc(dateLabel(e)) + '</span><h4 style="margin:12px 0 6px">' + esc(e.t) + '</h4><p class="meta">' + esc([e.v, e.k].filter(Boolean).join(', ')) + '</p></a>'; }
      function row(e) { return '<div class="row"><span class="tag">' + esc(dateLabel(e)) + '</span><div style="flex:1;min-width:220px"><a href="' + esc(e.u) + '" style="font-size:18px;font-weight:700;text-decoration:none">' + esc(e.t) + '</a><br><span class="meta">' + esc([e.v, e.k].filter(Boolean).join(', ')) + '</span></div><a class="btn line sm" href="' + esc(e.u) + '">See details</a></div>'; }

      // this week: Monday through Sunday, from today on
      function week() {
        var dow = (today.getDay() + 6) % 7, mon = new Date(today); mon.setDate(today.getDate() - dow);
        var sun = new Date(mon); sun.setDate(mon.getDate() + 6);
        var from = iso(today), to = iso(sun);
        $('wk-range').textContent = DAYS[mon.getDay()].slice(0, 3) + ' ' + SHORT[mon.getMonth()] + ' ' + mon.getDate() + ' to ' + DAYS[sun.getDay()].slice(0, 3) + ' ' + SHORT[sun.getMonth()] + ' ' + sun.getDate();
        var hits = visible().filter(function (e) { return e.f >= from && e.s <= to; }).sort(function (a, b) { return a.s < b.s ? -1 : a.s > b.s ? 1 : 0; });
        var now1 = hits.filter(short), ongoing = hits.filter(function (e) { return !short(e); });
        $('wk-grid').innerHTML = now1.map(card).join('');
        $('wk-empty').classList.toggle('hidden', now1.length > 0);
        $('wk-ongoing').innerHTML = ongoing.length ? 'Also on all week: ' + ongoing.map(function (e) { return '<a href="' + esc(e.u) + '" style="font-weight:700">' + esc(e.t) + '</a>'; }).join(', ') + '.' : '';
      }

      // calendar
      function eventsOn(iso1) { return visible().filter(function (e) { return onDay(e, iso1); }); }
      function drawCal() {
        var y = view.getFullYear(), m = view.getMonth();
        $('cal-title').textContent = MONTHS[m] + ' ' + y;
        var first = new Date(y, m, 1), start = new Date(first); start.setDate(1 - first.getDay());
        var html = '';
        for (var i = 0; i < 42; i++) {
          var d = new Date(start); d.setDate(start.getDate() + i); var k = iso(d);
          if (i >= 35 && d.getMonth() !== m) break;
          var evs = eventsOn(k).filter(short), cls = 'cal-day' + (d.getMonth() !== m ? ' off' : '') + (d.getTime() === t0 ? ' today' : '') + (picked === k ? ' sel' : '');
          var all = eventsOn(k).length;
          html += '<button type="button" class="' + cls + '" data-d="' + k + '" aria-label="' + DAYS[d.getDay()] + ', ' + MONTHS[d.getMonth()] + ' ' + d.getDate() + (all ? ', ' + all + (all === 1 ? ' event' : ' events') : '') + '"><span class="n">' + d.getDate() + '</span>' +
            evs.slice(0, 2).map(function (e) { return '<span class="ev">' + esc(e.t) + '</span>'; }).join('') + (evs.length > 2 ? '<span class="more">+' + (evs.length - 2) + ' more</span>' : '') + '<span class="dot' + (evs.length ? ' has' : '') + '"></span></button>';
        }
        $('cal-grid').innerHTML = html;
        // long running events that touch this month
        var ms = iso(new Date(y, m, 1)), me = iso(new Date(y, m + 1, 0));
        var og = visible().filter(function (e) { return !short(e) && e.f >= ms && e.s <= me; }).sort(function (a, b) { return a.s < b.s ? -1 : 1; });
        $('cal-ongoing').innerHTML = og.length ? '<p class="eyebrow" style="margin-bottom:6px">On all month</p>' + og.map(row).join('') : '';
        drawDay();
      }
      function drawDay() {
        var box = $('cal-day');
        if (!picked) { box.innerHTML = '<p class="meta">Choose a day to see what is on.</p>'; return; }
        var d = parse(picked), evs = eventsOn(picked), one = evs.filter(short), long = evs.filter(function (e) { return !short(e); });
        var body = one.length ? one.map(row).join('') : '<p class="meta">' + (long.length ? 'No single day events listed.' : 'Nothing listed for this day.') + '</p>';
        if (long.length) body += '<p class="meta" style="margin-top:12px">Also on: ' + long.map(function (e) { return '<a href="' + esc(e.u) + '" style="font-weight:700">' + esc(e.t) + '</a>'; }).join(', ') + '.</p>';
        box.innerHTML = '<h4 style="margin-bottom:6px">' + DAYS[d.getDay()] + ', ' + MONTHS[d.getMonth()] + ' ' + d.getDate() + '</h4>' + body;
      }
      $('cal-prev').addEventListener('click', function () { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); drawCal(); });
      $('cal-next').addEventListener('click', function () { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); drawCal(); });
      $('cal-grid').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; picked = b.dataset.d; var d = parse(picked); if (d.getMonth() !== view.getMonth()) view = new Date(d.getFullYear(), d.getMonth(), 1); drawCal(); });

      // the list below, with the same filters as before
      function run() {
        var items = document.querySelectorAll('.t-item'), n = 0, r = weekendRange();
        items.forEach(function (i) { var s = +i.dataset.s, f = +i.dataset.f, ok = true;
          if (when === 'weekend') ok = s <= r[1] && f >= Math.max(r[0], t0); else if (when === 'week') ok = s <= t0 + 7 * DAY; else if (when === 'month') ok = s <= t0 + 30 * DAY;
          if (kind && i.dataset.k !== kind) ok = false; i.classList.toggle('hidden', !ok); if (ok) n++; });
        $('t-count').textContent = n + (n === 1 ? ' event' : ' events'); $('t-empty').classList.toggle('hidden', n > 0);
      }
      function weekendRange() { var d = new Date(t0), dow = d.getDay(); var fri = dow === 6 ? t0 - DAY : dow === 0 ? t0 - 2 * DAY : t0 + (5 - dow) * DAY; return [fri, fri + 2 * DAY]; }
      function wire(id, key) { var el = $(id); if (!el) return; el.addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; if (key === 'w') when = b.dataset.w; else kind = b.dataset.k;
        [].forEach.call(el.children, function (c) { c.classList.toggle('on', c === b); c.setAttribute('aria-pressed', c === b ? 'true' : 'false'); }); run(); week(); drawCal(); }); }
      wire('t-when', 'w'); wire('t-kind', 'k'); run(); week(); drawCal();
      var pa = $('p-area'); pa.addEventListener('change', function () { document.querySelectorAll('.p-item').forEach(function (i) { i.classList.toggle('hidden', !!pa.value && i.dataset.area !== pa.value); }); });
    })();
  </script>
</Base>
