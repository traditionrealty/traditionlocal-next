---
import Base from '../../layouts/Base.astro';
import Prefs from '../../components/Prefs.astro';
import FilterKit from '../../components/FilterKit.astro';
import '../../styles/pages.css';
import '../../styles/dock.css';
import { href, url, media } from '../../lib/data';
import { config } from '../../config';
import { areaPages, foodIn, subsIn, cleanList, REGIONS } from '../../lib/helpers';
// Card pictures, the same rules as the Food page. A real photo or a Google Maps screenshot shows on the card (maps only while config.cardMapPhotos is on).
// The shared placeholder graphic is not a picture of the area, so those cards get a clean tile instead.
const pic = (p: any) => {
  const m = media(p); if (!m) return { photo: '', mapPhoto: '' };
  const note = `${p.heroCredit || ''} ${m.alt || ''}`;
  if (/permanently closed|placeholder/i.test(note)) return { photo: '', mapPhoto: '' };
  return /google maps/i.test(note) ? { photo: '', mapPhoto: m.src } : { photo: m.src, mapPhoto: '' };
};
const list = areaPages().map((p) => ({ p, ...pic(p), biz: foodIn(p.name).length, subs: subsIn(p.name).length })).sort((a, b) => a.p.name.localeCompare(b.p.name));
const found = [...new Set(list.map((x) => x.p.region).filter(Boolean))];
const regions = [...REGIONS.filter((r) => found.includes(r)), ...found.filter((r) => !REGIONS.includes(r))];
const text = (p: any) => [p.summary, p.bestFor, p.typicalHomes, p.localTake, cleanList(p.schools)].join(' ').toLowerCase();
const compare = Object.fromEntries(list.map(({ p, biz, subs }) => [p.name, { u: href(p), r: p.region || '', b: p.bestFor || p.summary, h: p.typicalHomes || '', s: cleanList(p.schools), biz, subs }]));
const loves = [['food', 'Food and coffee nearby'], ['parks', 'Parks and space'], ['schools', 'Good schools'], ['commute', 'A shorter commute'], ['quiet', 'Quiet streets'], ['walk', 'Walkable and lively'], ['newer', 'Newer homes'], ['value', 'Value for the money']];
const areaRows = list.map(({ p }) => ({ s: 'n:' + p.slug, n: p.name, r: p.region || '', u: href(p) }));
const heart = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.6-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.4-9.5 9-9.5 9z"/></svg>';
---
<Base title="Neighborhoods" active="Neighborhoods" description="Area guides and subdivision profiles from people who live here.">
  <section class="band hero dock-hero">
    <div class="wrap">
      <p class="eyebrow">Around town</p>
      <h1 style="margin-bottom:12px;max-width:900px">Find the Neighborhood That Fits Your Life</h1>
      <p class="lead" style="margin-bottom:0">A local perspective on where to eat, what to do, and what it is like to live there.</p>
    </div>
  </section>
  <section class="band results" id="browse">
    <div class="fdock" id="n-dock">
      <div class="wrap">
        <div class="fbar" id="n-bar">
          <div class="fbar-row">
            <div class="fbar-search"><label for="n-q">Search</label><input id="n-q" type="search" placeholder="Try Sugar Land, Montrose, or Cinco Ranch" autocomplete="off" /></div>
            <button class="chip fbar-toggle" type="button" aria-expanded="false" aria-controls="n-panel">Filters <span class="fcount hidden" id="n-badge"></span></button>
            <div class="fbar-panel" id="n-panel">
              <div class="fpop-wrap" id="n-loves"><span class="flabel">What matters most</span>
                <details class="fpop"><summary><span class="ftext">Anything</span></summary><div class="fpop-menu">{loves.map(([k, l]) => <label><input type="checkbox" value={k} />{l}</label>)}</div></details>
              </div>
              <div class="fsel"><label for="n-region">Region</label><select id="n-region"><option value="">All regions</option>{regions.map((r) => <option>{r}</option>)}</select></div>
            </div>
          </div>
          <div class="fbar-status">
            <span class="fquiz">Not sure? <a href={url('/find-your-fit')} style="font-weight:700">Take the 3 question quiz</a>.</span>
            <div class="fpills" id="n-pills"></div><button class="flink hidden" id="n-clear" type="button">Clear all</button>
            <div class="fbar-meta"><span class="meta" id="n-count">{list.length} areas</span><a class="btn line sm" href={url('/account#saved')}>Saved neighborhoods (<span id="n-saved">0</span>)</a><button class="btn line sm" id="n-mail" type="button">Email my list</button></div>
          </div>
        </div>
      </div>
    </div>
    <div class="wrap">
      <h2 class="sr">All Neighborhoods</h2>
      <div class={'grid g3' + (config.cardPhotos ? ' cp-on' : '') + (config.cardPhotos && config.cardMapPhotos ? ' cp-maps' : '')} id="n-grid">
        {list.map(({ p, biz, subs, photo, mapPhoto }, i) => (
          <div class={i < 24 ? 'card tcard n-item' : 'card tcard n-item hidden'} data-region={p.region} data-name={p.name.toLowerCase()} data-text={text(p)}>
            <a href={href(p)}>
              <div class={mapPhoto ? 'tc-photo has-map' : 'tc-photo'}>
                {photo ? <img src={photo} alt="" width="640" height="480" loading="lazy" decoding="async" /> : (
                  <>
                    {mapPhoto && <img class="tc-map" src={mapPhoto} alt="" width="640" height="480" loading="lazy" decoding="async" />}
                    <span class="tc-ph" aria-hidden="true">{config.mark && <img src={url(config.mark)} alt="" width="40" height="40" />}<span>{p.region || p.type}</span></span>
                  </>
                )}
              </div>
              <div class="tc-body">
                <div class="tc-tags"><span class="tag">{p.type}</span>{p.region && <span class="tag soft">{p.region}</span>}</div>
                <h4 style="margin-bottom:8px">{p.name}</h4>
                <p class="meta" style="margin-bottom:12px">{p.summary}</p>
                <p class="meta"><b>{biz}</b> places reviewed, <b>{subs}</b> subdivisions</p>
              </div>
            </a>
            <button class="save" type="button" data-slug={'n:' + p.slug} data-name={p.name} aria-label={'Save ' + p.name} aria-pressed="false" set:html={heart}></button>
            <div style="padding:0 24px 20px"><button class="chip cmp" type="button" data-n={p.name} aria-pressed="false">Compare</button></div>
          </div>
        ))}
      </div>
      <script is:inline>
        (function () { var g = document.getElementById('n-grid'), m = /[?&]photos=(on|all)\b/.exec(location.search); if (g && m) { g.classList.add('cp-on'); g.classList.toggle('cp-maps', m[1] === 'all'); } })();
      </script>
      <p style="margin-top:24px"><button class="btn line hidden" id="n-more" type="button">Show more areas</button></p>
      <div class="card pad hidden" id="n-empty"><b>No areas match yet.</b><p class="meta" style="margin-top:4px">Try another name, region, or interest.</p></div>
    </div>
  </section>
  <section class="band tint" id="compare">
    <div class="wrap">
      <p class="eyebrow">Compare</p><h2 style="margin-bottom:8px">Side by Side, in Plain Language</h2>
      <p class="meta" id="cmp-hint" style="margin-bottom:20px">Tap Compare on two or three areas above.</p>
      <div id="cmp-out" class="card hidden" style="overflow:auto"></div>
    </div>
  </section>
  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap">
      <div style="max-width:700px"><p class="eyebrow" style="color:var(--navy)">A neighbor to ask</p><h3 style="margin-bottom:8px">Curious About Living Somewhere?</h3><p style="font-size:17px">Dillon is a local Realtor who loves these neighborhoods. Questions are always welcome, with no pressure.</p></div>
      <a class="btn" href={url('/ask-dillon')}>Ask Dillon</a>
    </div>
  </section>
  <FilterKit />
  <Prefs />
  <script is:inline define:vars={{ COMPARE: compare, AREAS: areaRows }}>
    (function () {
      var PRIOR = { food: ['restaurant', 'food', 'coffee', 'dining', 'cafe', 'eat'], parks: ['park', 'trail', 'green', 'yard', 'space', 'lake', 'outdoor', 'nature'], schools: ['school', 'isd', 'families', 'family'], commute: ['commute', 'downtown', 'freeway', 'minutes', 'central', 'close to', 'galleria', 'medical center', 'energy corridor'], quiet: ['quiet', 'peaceful', 'tucked', 'established', 'tree', 'private', 'calm', 'small town', 'laid back'], walk: ['walkable', 'walk', 'lively', 'nightlife', 'urban', 'inner loop', 'inside the loop', 'bike', 'townhome'], newer: ['new construction', 'new build', 'newer', 'master planned', 'new homes', 'developing', 'growing'], value: ['affordable', 'value', 'budget', 'starter', 'price'] };
      var $ = function (id) { return document.getElementById(id); };
      var picks = [];
      var TLD = window.TL;
      function savedCount() { $('n-saved').textContent = TLD.saved().filter(function (s) { return s.indexOf('n:') === 0; }).length; }
      document.addEventListener('tl:saved', savedCount); savedCount();
      $('n-mail').addEventListener('click', function () {
        var s = TLD.saved(), rows = AREAS.filter(function (x) { return s.indexOf(x.s) > -1; });
        if (!rows.length) { alert('Save a neighborhood first by tapping its heart.'); return; }
        var body = rows.map(function (x) { return x.n + (x.r ? ' (' + x.r + ')' : '') + ': ' + location.origin + x.u; }).join('\n');
        location.href = 'mailto:?subject=' + encodeURIComponent('My saved neighborhoods from Tradition Local') + '&body=' + encodeURIComponent(body);
      });
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      var region = $('n-region');
      var loves = TLF.checks($('n-loves'), function (it, k) { var t = it.dataset.text; return PRIOR[k].some(function (w) { return t.indexOf(w) > -1; }); });
      var kit = TLF.init({ bar: $('n-bar'), items: [].slice.call(document.querySelectorAll('.n-item')), search: $('n-q'), step: 24, noun: ['area', 'areas'], count: $('n-count'), empty: $('n-empty'), more: $('n-more'), clear: $('n-clear'), pills: $('n-pills'), badge: $('n-badge'), filters: [TLF.select(region, 'region'), loves] });
      region.addEventListener('change', kit.refresh); loves.menu.addEventListener('change', function () { loves.sync(); kit.refresh(); });
      var ROWS = [['Region', 'r'], ['Best for', 'b'], ['Typical homes', 'h'], ['Schools', 's'], ['Places we reviewed', 'biz'], ['Subdivision guides', 'subs']];
      function drawCompare() {
        document.querySelectorAll('.cmp').forEach(function (b) { var on = picks.indexOf(b.dataset.n) > -1; b.classList.toggle('on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); b.textContent = on ? 'Comparing' : 'Compare'; });
        var out = $('cmp-out'); $('cmp-hint').textContent = picks.length < 2 ? 'Tap Compare on two or three areas above.' : 'Comparing ' + picks.length + ' areas. Tap Comparing again to remove one.';
        if (picks.length < 2) { out.classList.add('hidden'); return; }
        var h = '<table style="width:100%;border-collapse:collapse;min-width:560px"><thead><tr><th style="text-align:left;padding:14px 18px;border-bottom:1px solid var(--line)"></th>' + picks.map(function (n) { return '<th style="text-align:left;padding:14px 18px;border-bottom:1px solid var(--line);font-family:var(--serif);font-size:20px"><a href="' + esc(COMPARE[n].u) + '">' + esc(n) + '</a></th>'; }).join('') + '</tr></thead><tbody>';
        ROWS.forEach(function (r) { h += '<tr><td style="padding:12px 18px;border-bottom:1px solid var(--line);font-size:13px;font-weight:700;color:var(--slate);vertical-align:top">' + r[0] + '</td>' + picks.map(function (n) { var v = COMPARE[n][r[1]]; return '<td style="padding:12px 18px;border-bottom:1px solid var(--line);vertical-align:top">' + esc(v === '' || v === undefined ? 'Not listed yet' : v) + '</td>'; }).join('') + '</tr>'; });
        out.innerHTML = h + '</tbody></table>'; out.classList.remove('hidden');
      }
      document.addEventListener('click', function (e) { var b = e.target.closest('.cmp'); if (!b) return; var n = b.dataset.n, i = picks.indexOf(n); if (i > -1) picks.splice(i, 1); else { picks.push(n); if (picks.length > 3) picks.shift(); } drawCompare(); if (picks.length >= 2 && i < 0) $('compare').scrollIntoView({ behavior: 'smooth', block: 'nearest' }); });
    })();
  </script>
</Base>
