---
import Base from '../../layouts/Base.astro';
import Prefs from '../../components/Prefs.astro';
import '../../styles/pages.css';
import { href, url } from '../../lib/data';
import { areaPages, bizIn, subsIn, REGIONS } from '../../lib/helpers';
const list = areaPages().map((p) => ({ p, biz: bizIn(p.name).length, subs: subsIn(p.name).length })).sort((a, b) => a.p.name.localeCompare(b.p.name));
const regions = REGIONS.filter((r) => list.some((x) => x.p.region === r));
---
<Base title="Neighborhoods" active="Neighborhoods" description="Area guides and subdivision profiles from people who live here.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Around town</p>
      <h1 style="margin-bottom:12px;max-width:900px">Find the neighborhood that fits your life.</h1>
      <p class="lead" style="margin-bottom:28px">A local perspective on where to eat, what to do, and what it is like to live there.</p>
      <div class="card pad search"><label for="n-q">Search an area</label><input id="n-q" type="search" placeholder="Try Sugar Land, Montrose, or Cinco Ranch" /></div>
      <div class="tabs" id="n-regions" style="margin-top:20px"><button class="chip on" data-r="" aria-pressed="true">All</button>{regions.map((r) => <button class="chip" data-r={r} aria-pressed="false">{r}</button>)}</div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <p class="meta" id="n-count" style="margin-bottom:16px">{list.length} areas</p>
      <div class="grid g3">
        {list.map(({ p, biz, subs }) => (
          <a class="card pad n-item" href={href(p)} data-region={p.region} data-name={p.name.toLowerCase()} style="text-decoration:none">
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px"><span class="tag">{p.type}</span>{p.region && <span class="tag soft">{p.region}</span>}</div>
            <h4 style="margin-bottom:8px">{p.name}</h4>
            <p class="meta" style="margin-bottom:12px">{p.summary}</p>
            <p class="meta"><b>{biz}</b> places reviewed, <b>{subs}</b> subdivisions</p>
          </a>
        ))}
      </div>
      <div class="card pad hidden" id="n-empty"><b>No areas match yet.</b><p class="meta" style="margin-top:4px">Try another name or region.</p></div>
    </div>
  </section>
  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap">
      <div style="max-width:700px"><p class="eyebrow" style="color:var(--navy)">A neighbor to ask</p><h3 style="margin-bottom:8px">Curious about living somewhere?</h3><p style="font-size:17px">Dillon is a local Realtor who loves these neighborhoods. Questions are always welcome, with no pressure.</p></div>
      <a class="btn" href={url('/ask-dillon')}>Ask Dillon</a>
    </div>
  </section>
  <Prefs />
  <script is:inline>
    (function () {
    var q = document.getElementById('n-q'), items = [].slice.call(document.querySelectorAll('.n-item')), region = '';
    function run() { var t = q.value.trim().toLowerCase(), n = 0; items.forEach(function (i) { var ok = (!region || i.dataset.region === region) && (!t || i.dataset.name.indexOf(t) > -1); i.classList.toggle('hidden', !ok); if (ok) n++; });
      document.getElementById('n-count').textContent = n + (n === 1 ? ' area' : ' areas'); document.getElementById('n-empty').classList.toggle('hidden', n > 0); }
    q.addEventListener('input', run);
    document.getElementById('n-regions').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; region = b.dataset.r; [].forEach.call(this.children, function (c) { c.classList.toggle('on', c === b); c.setAttribute('aria-pressed', c === b ? 'true' : 'false'); }); run(); });
    })();
  </script>
</Base>
