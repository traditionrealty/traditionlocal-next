---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url, IS_PREVIEW } from '../lib/data';
import { listings } from '../lib/listings';
import MoreWays from '../components/MoreWays.astro';
const help = [
  ['Relocation', 'Moving to Houston? Start with the neighborhood, then sort out the details.', '/relocation'],
  ['Apartment locating', 'Tell us what matters, and we will help you narrow the list of rentals.', '/apartments'],
  ['New builds', 'Newer and master planned communities to compare side by side.', '/new-builds'],
  ['Commercial real estate', 'Buying, selling, or leasing space for a business.', '/commercial'],
  ['International clients', 'Moving to or buying in Houston from another country.', '/international'],
  ['Find your fit', 'Not sure where to live yet? Answer a few questions and explore.', '/find-your-fit'],
];
const principles = [
  ['Neighborhood first', 'We start with where you want to live and how you want to live there, not with a list of homes.'],
  ['A clear process', 'You always know what happens next, and why. Good moves feel calm because the steps are clear.'],
  ['No pressure', 'Questions are always welcome, at any stage, whether you are ready this month or next year.'],
];
---
<Base title="Tradition Realty Group" active="" description="Dillon Loren's real estate business. Neighborhood knowledge from Tradition Local, applied to your move.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Tradition Realty Group</p>
      <h1 style="margin-bottom:16px;max-width:900px">Real estate, with a neighbor's point of view.</h1>
      <p class="lead" style="margin-bottom:28px;max-width:760px">Tradition Realty Group is Dillon Loren's real estate business, started in 2016. It is where the neighborhood knowledge on Tradition Local meets the work of helping someone move.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/ask-dillon')}>Ask Dillon</a><a class="btn line" href="tel:+12817266969">Call (281) 726 6969</a></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <div class="main">
        <p class="eyebrow">How it connects</p><h2 style="margin-bottom:16px">Tradition Local first. Real estate when you are ready.</h2>
        <p style="font-size:18px;margin-bottom:14px">Tradition Local is where we get to know Houston together: honest reviews, neighborhood guides, and things to do. There is no sales pitch in any of it.</p>
        <p style="font-size:18px">Tradition Realty Group is for the day you decide to move, rent, buy, or sell. By then you already know the neighborhoods, so the conversation starts a few steps ahead.</p>
      </div>
      <div class="side">
        <div class="card pad">
          <p class="eyebrow">Your Realtor</p>
          <h3 style="margin-bottom:8px">Dillon Loren</h3>
          <p class="meta" style="font-size:16px;margin-bottom:14px">A Realtor with Tradition Realty Group at Keller Williams Memorial, with about ten years of experience helping families and young couples find a place that fits.</p>
          <a href={url('/about')} style="font-weight:700">Meet Sara and Dillon</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band tint" id="listings">
    <div class="wrap">
      <p class="eyebrow">{listings.length > 0 ? 'Featured listings' : 'Find a home'}</p><h2 style="margin-bottom:12px">{listings.length > 0 ? 'Homes worth a look.' : 'Looking for your next home?'}</h2>
      {listings.length > 0 ? (
        <>
          <p class="meta" style="font-size:17px;margin-bottom:28px;max-width:720px">A few of Dillon's own listings. Tap one for the full details and photos.</p>
          <div class="grid g3">
            {listings.map((l) => (
              <a class="card ls" href={l.link || url('/ask-dillon')} rel="noopener">
                {l.photo && <img src={l.photo} alt={l.address} loading="lazy" />}
                <div class="ls-body">
                  <div style="display:flex;gap:8px;flex-wrap:wrap"><span class="tag">{l.status}</span>{IS_PREVIEW && l.example && <span class="tag soft">Example</span>}</div>
                  {l.price && <div class="ls-price">{l.price}</div>}
                  <h4>{l.address}</h4>
                  <p class="meta">{l.city}</p>
                  {l.facts && <p class="meta" style="margin-top:6px">{l.facts}</p>}
                  {l.summary && <p class="meta" style="margin-top:10px;font-size:15px">{l.summary}</p>}
                  <span class="ls-link">{l.link ? 'View listing' : 'Ask about this home'}</span>
                </div>
              </a>
            ))}
          </div>
        </>
      ) : (
        <p class="meta" style="font-size:17px;margin-bottom:8px;max-width:720px">Search every home on the market with Dillon on Keller Williams.</p>
      )}
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px"><a class="btn" href="https://traditionrealtygroup.kw.com/search" rel="noopener">Search all homes</a><a class="btn line" href={url('/ask-dillon')}>Ask Dillon about a home</a></div>
      {listings.length > 0 && <p class="meta" style="font-size:13px;max-width:820px;margin-top:22px">Featured listings are offered by Dillon Loren, a Realtor with Tradition Realty Group at Keller Williams Memorial, Texas real estate license 681837. Details are believed accurate but are not guaranteed, and prices and availability can change. Please read the <a href="https://www.har.com/mhf/terms/dispBrokerInfo?sitetype=aws&amp;cid=681837" target="_blank" rel="noopener">Texas Real Estate Commission Information About Brokerage Services</a> and the <a href="https://content.harstatic.com/pdf/TREC_CPN.pdf" target="_blank" rel="noopener">Consumer Protection Notice</a>. Equal Housing Opportunity.</p>}
    </div>
  </section>

  <MoreWays cards={help} />

  <section class="band tint">
    <div class="wrap">
      <p class="eyebrow">How we work</p><h2 style="margin-bottom:28px">Calm, clear, and personal.</h2>
      <div class="grid g3">{principles.map(([t, d]) => <div class="card pad"><h4 style="margin-bottom:8px">{t}</h4><p class="meta" style="font-size:16px">{d}</p></div>)}</div>
    </div>
  </section>

  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap">
      <div style="max-width:700px"><h3 style="margin-bottom:8px">Thinking about a move?</h3><p style="font-size:17px">Tell Dillon what you are looking for. He will reply personally, with no pressure.</p></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/ask-dillon')}>Ask Dillon</a><a class="btn line" href="https://traditionrealtygroup.kw.com/" rel="noopener">Explore Listings For Sale</a></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="meta" style="font-size:14px;max-width:760px">Dillon Loren is a Realtor with Tradition Realty Group at Keller Williams Memorial. <a href={url('/disclosures')}>Texas real estate disclosures</a></p>
    </div>
  </section>
  <style>
    .ls { display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: transform .18s, box-shadow .18s; }
    .ls:hover { transform: translateY(-3px); box-shadow: 0 10px 26px rgba(29, 26, 109, .14); }
    .ls img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
    .ls-body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
    .ls-price { font-family: var(--serif); font-weight: 600; font-size: 30px; line-height: 1.1; margin: 12px 0 6px; }
    .ls-link { margin-top: auto; padding-top: 14px; font-weight: 700; color: var(--blue); }
  </style>
</Base>
