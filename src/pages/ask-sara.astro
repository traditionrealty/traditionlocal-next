---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url } from '../lib/data';
import { config } from '../config';
const topics = [['Food and coffee', 'Where to eat, from family favorites to special nights.'], ['Culture and events', 'Festivals, markets, museums, and community traditions.'], ['Hidden gems', 'Local spots most visitors never find.'],
  ['Planning a visit', 'Where to go and what to do on a trip.'], ['Living or moving abroad', 'Questions about Portugal and other destinations.'], ['Apartments', 'Finding a community that fits your life.']];
---
<Base title="Ask Sara" active="More" sub="makeithome" description="Ask Sara about food, culture, and living well, in Houston and beyond. She will reply personally.">
  <section class="band hero"><div class="wrap"><p class="eyebrow">Food, culture, and living well</p><h1 style="margin-bottom:16px">Ask Sara</h1><p class="lead">Wondering where to eat, what to do, or what life is like in a new place? Send Sara a note, and she will reply personally.</p></div></section>
  <section class="band">
    <div class="wrap split">
      <div class="main">
        <div class="panel" id="as-thanks" hidden style="border-color:var(--gold)">
          <p class="eyebrow">Thank you</p><h2 id="as-title" style="margin-bottom:12px">Your Note Is In</h2>
          <p style="font-size:18px;margin-bottom:20px">Sara will reply personally. In the meantime, here are a few places to start.</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/food')}>Find great food</a><a class="btn line" href={url('/things-to-do')}>Things to do</a></div>
        </div>
        <form class="panel" id="as-form" novalidate data-endpoint={config.formsAction + '/contact'} data-contact={config.contactEmail}>
          <fieldset style="border:0;padding:0;margin:0 0 24px"><legend style="font-size:13px;font-weight:700;margin-bottom:10px">What would you like to ask about? Choose any that fit.</legend>
            <div class="chips" id="as-topics">{topics.map(([t]) => <label class="chip" style="cursor:pointer"><input type="checkbox" name="topics" value={t} style="position:absolute;opacity:0;width:1px;height:1px" />{t}</label>)}</div></fieldset>
          <div class="grid g2" style="margin-bottom:20px">
            <div><label for="as-first">First name</label><input id="as-first" type="text" autocomplete="given-name" placeholder="Your first name" /><p class="msg-err" id="as-first-err" hidden>Please add your first name.</p></div>
            <div><label for="as-email">Email</label><input id="as-email" type="email" autocomplete="email" placeholder="name@email.com" /><p class="msg-err" id="as-email-err" hidden>Enter an email address like name@company.com</p></div>
          </div>
          <div style="margin-bottom:20px"><label for="as-note">Your question</label><textarea id="as-note" placeholder="Tell Sara what you are curious about, where you are going, or what you hope to find."></textarea><p class="msg-err" id="as-note-err" hidden>Please add a short note.</p></div>
          <input id="as-company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <button class="btn" id="as-send" type="submit" style="min-height:52px">Send to Sara</button>
          <p class="msg-err" id="as-fail" hidden></p>
          <p class="meta" style="margin-top:14px">We only use your email to reply. You can read how we handle your information on the <a href={url('/privacy')}>Privacy page</a>.</p>
        </form>
      </div>
      <div class="side">
        <div class="card pad"><p class="eyebrow">What to expect</p>
          <ol class="wx" role="list">
            <li><span class="wx-n" aria-hidden="true">1</span><div><b>Sara Reads It</b><span class="meta">Every note is read by a person.</span></div></li>
            <li><span class="wx-n" aria-hidden="true">2</span><div><b>A Personal Reply</b><span class="meta">Local tips that fit what you asked.</span></div></li>
            <li><span class="wx-n" aria-hidden="true">3</span><div><b>No Pressure</b><span class="meta">Ask as much as you like.</span></div></li>
          </ol></div>
        <div class="card pad" style="margin-top:24px;background:var(--butter);border-color:var(--butter)"><p class="eyebrow" style="color:var(--navy)">Want a neighborhood guide instead?</p><p style="margin-bottom:16px">Ask Dillon about Houston areas, homes, and moving.</p><a class="btn" href={url('/ask-dillon')}>Ask Dillon</a></div>
      </div>
    </div>
  </section>
  <style>#as-topics { gap: 8px; } #as-topics .chip { min-height: 34px; padding: 0 12px; font-size: 13px; }</style>
  <script is:inline>
    var form = document.getElementById('as-form'), $ = function (id) { return document.getElementById(id); };
    function paint() { form.querySelectorAll('label.chip').forEach(function (l) { l.classList.toggle('on', l.querySelector('input').checked); }); }
    form.addEventListener('change', paint); paint();
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var first = $('as-first').value.trim(), em = $('as-email').value.trim(), note = $('as-note').value.trim();
      var nameOk = first.length > 0, emOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em), noteOk = note.length > 2;
      $('as-first-err').hidden = nameOk; $('as-email-err').hidden = emOk; $('as-note-err').hidden = noteOk;
      if (!nameOk || !emOk || !noteOk) return;
      var picked = [].map.call(form.querySelectorAll('input[name=topics]:checked'), function (x) { return x.value; });
      var message = 'ASK SARA' + (picked.length ? '\nTopics: ' + picked.join(', ') : '') + '\n\n' + note;
      var btn = $('as-send'), fail = $('as-fail'); fail.hidden = true; btn.disabled = true; btn.textContent = 'Sending...';
      try {
        var res = await fetch(form.dataset.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason: 'A question', name: first, email: em, message: message, company: $('as-company').value }) });
        var out = await res.json(); if (!out.ok) throw new Error('rejected');
        $('as-title').textContent = 'Thank you, ' + first + '.'; form.hidden = true; $('as-thanks').hidden = false; window.scrollTo({ top: 0 });
      } catch (err) {
        fail.textContent = 'We could not send your note. Please try again in a moment, or email us at ' + form.dataset.contact + '.'; fail.hidden = false;
      } finally { btn.disabled = false; btn.textContent = 'Send to Sara'; }
    });
  </script>
</Base>
