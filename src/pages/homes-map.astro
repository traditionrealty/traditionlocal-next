---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { readTable, url } from '../lib/data';

// Pins for new developments and apartments. Coordinates live in data/homes_map_points.csv (kind, slug, lat, lng, precision).
// "exact" is a street address match. "area" places the pin in the right ZIP code, spread out so pins do not stack.
const pts = readTable('homes_map_points.csv');
const dev = new Map(readTable('developments.csv').map((r: any) => [r.slug, r]));
const apt = new Map(readTable('apartment_communities.csv').map((r: any) => [r.slug, r]));
const num = (s: any) => { const n = parseInt(String(s || '').replace(/[^0-9]/g, ''), 10); return isFinite(n) ? n : 0; };
const pins = pts.map((r: any) => {
  const la = +r.lat, ln = +r.lng; if (!isFinite(la) || !isFinite(ln)) return null;
  if (r.kind === 'development') {
    const d: any = dev.get(r.slug); if (!d) return null;
    const bmin = num(d.beds_min), bmax = num(d.beds_max);
    const beds = bmax ? (bmin && bmin !== bmax ? bmin + ' to ' + bmax + ' bedrooms' : bmax + ' bedrooms') : '';
    const sf = num(d.sqft_min) && num(d.sqft_max) ? num(d.sqft_min).toLocaleString('en-US') + ' to ' + num(d.sqft_max).toLocaleString('en-US') + ' sq ft' : '';
    return { n: d.name, k: 'd', a: d.area || d.city || '', s: [d.builders ? 'Builders: ' + d.builders : '', beds, sf].filter(Boolean).join(' | '), b: bmax, h: url('/developments/' + r.slug + '/'), la, ln, x: r.precision === 'exact' ? 1 : 0 };
  }
  const p: any = apt.get(r.slug); if (!p) return null;
  const lay = String(p.layouts || '').split('|').map((s: string) => s.trim()).filter(Boolean);
  const mb = Math.max(0, ...lay.map((s: string) => { const m = /(\d)\s*Bedroom/i.exec(s); return m ? +m[1] : 0; }));
  return { n: p.name, k: 'a', a: p.area || p.city || '', s: [p.address, lay.join(', ')].filter(Boolean).join(' | '), b: mb, h: url('/apartments/' + r.slug + '/'), la, ln, x: r.precision === 'exact' ? 1 : 0 };
}).filter(Boolean);
const areas = [...new Set(pins.map((p: any) => p.a).filter(Boolean))].sort();
const nd = pins.filter((p: any) => p.k === 'd').length, na = pins.filter((p: any) => p.k === 'a').length;
---
<Base title="New Homes and Apartments Map" active="Make It Home" description="Every new development and apartment community we cover, on one map of Greater Houston.">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <section class="band hero" style="padding-top:28px;padding-bottom:4px">
    <div class="wrap">
      <p class="eyebrow">Prototype</p>
      <h1 style="margin-bottom:6px">New Homes and Apartments Map</h1>
      <p class="lead">See where new developments and apartment communities sit across Greater Houston. Tap a pin, then open the full page for builders, plans or layouts.</p>
    </div>
  </section>
  <section class="band" style="padding-top:8px">
    <div class="wrap">
      <div class="card pad search" style="margin-bottom:14px;display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end">
        <div style="flex:2;min-width:220px"><label for="m-find">Search by name or builder</label><input id="m-find" type="search" placeholder="Try a community or a builder" autocomplete="off" /></div>
        <div style="flex:1;min-width:180px"><label for="m-area">Area</label><select id="m-area"><option value="">All of Greater Houston</option>{areas.map((a: string) => <option>{a}</option>)}</select></div>
        <div style="flex:1;min-width:140px"><label for="m-beds">Bedrooms</label><select id="m-beds"><option value="0">Any</option><option value="2">2 or more</option><option value="3">3 or more</option><option value="4">4 or more</option></select></div>
      </div>
      <div class="m-chips" id="m-chips" role="group" aria-label="Show on the map">
        <button type="button" class="chip on" data-k="all">Everything ({pins.length})</button>
        <button type="button" class="chip" data-k="d"><i class="dot d"></i>New developments ({nd})</button>
        <button type="button" class="chip" data-k="a"><i class="dot a"></i>Apartments ({na})</button>
      </div>
      <p class="meta" id="m-count" aria-live="polite" style="margin:10px 0 12px"></p>
      <div class="m-wrap">
        <div id="m-map" role="region" aria-label="Map of new developments and apartments"></div>
        <ol id="m-list" class="m-list" aria-label="Results"></ol>
      </div>
      <p class="meta" style="margin-top:12px;font-size:14px">New development pins sit inside the right ZIP code, not on the exact lot, and cluster together when zoomed out. Apartment pins with a solid ring are on the street address. Map data from OpenStreetMap contributors.</p>
    </div>
  </section>
  <style is:global>
    .m-chips{display:flex;flex-wrap:wrap;gap:8px}
    .m-chips .chip{display:inline-flex;align-items:center;gap:8px;cursor:pointer}
    .m-chips .chip.on{background:#1D1A6D;color:#fff;border-color:#1D1A6D}
    .dot{display:inline-block;width:12px;height:12px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px #1D1A6D}
    .dot.d{background:#004AAD}.dot.a{background:#E7BC52}
    .m-wrap{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(280px,1fr);gap:16px;align-items:start}
    #m-map{height:640px;border-radius:16px;overflow:hidden;border:1px solid rgba(29,26,109,.15);z-index:0}
    .m-list{list-style:none;margin:0;padding:0;height:640px;overflow:auto;display:flex;flex-direction:column;gap:8px}
    .m-list li{background:#fff;border:1px solid rgba(29,26,109,.12);border-radius:12px;padding:10px 12px;cursor:pointer}
    .m-list li:hover{border-color:#004AAD;box-shadow:0 2px 10px rgba(0,74,173,.15)}
    .m-list b{display:block;color:#1D1A6D;font-family:Fraunces,serif}
    .m-list span{font-size:14px;color:#555}
    .m-pop b{font-family:Fraunces,serif;color:#1D1A6D;font-size:16px}
    .m-pop a{display:inline-block;margin-top:8px;font-weight:600}
    @media (max-width:820px){.m-wrap{grid-template-columns:1fr}#m-map{height:460px}.m-list{height:auto;max-height:420px}}
  </style>
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
  <script define:vars={{ PINS: pins }}>
    (function () {
      var COL = { d: '#004AAD', a: '#E7BC52' };
      var NAME = { d: 'New development', a: 'Apartment' };
      var map = L.map('m-map', { scrollWheelZoom: true }).setView([29.76, -95.37], 10);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
      var layer = L.markerClusterGroup({ showCoverageOnHover: false, maxClusterRadius: 45 }).addTo(map);
      var kind = 'all', $ = function (i) { return document.getElementById(i); };
      var list = $('m-list'), find = $('m-find'), area = $('m-area'), beds = $('m-beds'), count = $('m-count');
      var esc = function (s) { return String(s || '').replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      PINS.forEach(function (p) {
        p.m = L.circleMarker([p.la, p.ln], { radius: 9, color: '#1D1A6D', weight: 2, fillColor: COL[p.k], fillOpacity: 0.9 });
        p.m.bindPopup('<div class="m-pop"><b>' + esc(p.n) + '</b><br>' + esc(NAME[p.k] + (p.a ? ', ' + p.a : '')) + (p.s ? '<br><small>' + esc(p.s) + '</small>' : '') + '<br><a href="' + esc(p.h) + '">Open the full page</a></div>');
        p.find = (p.n + ' ' + p.a + ' ' + p.s).toLowerCase();
      });
      function render(fit) {
        var q = find.value.trim().toLowerCase(), a = area.value, b = +beds.value, shown = [];
        layer.clearLayers(); list.innerHTML = '';
        PINS.forEach(function (p) {
          if (kind !== 'all' && p.k !== kind) return;
          if (a && p.a !== a) return;
          if (b && p.b < b) return;
          if (q && p.find.indexOf(q) < 0) return;
          shown.push(p);
        });
        layer.addLayers(shown.map(function (p) { return p.m; }));
        shown.sort(function (x, y) { return x.n.localeCompare(y.n); }).slice(0, 200).forEach(function (p) {
          var li = document.createElement('li');
          li.innerHTML = '<b>' + esc(p.n) + '</b><span>' + esc(NAME[p.k] + (p.a ? ', ' + p.a : '')) + '</span>';
          li.addEventListener('click', function () { layer.zoomToShowLayer(p.m, function () { p.m.openPopup(); }); });
          list.appendChild(li);
        });
        count.textContent = shown.length ? 'Showing ' + shown.length + ' on the map' + (shown.length > 200 ? ' (first 200 in the list)' : '') : 'Nothing matches that search. Try a different area or clear the filters.';
        if (fit && shown.length) map.fitBounds(L.latLngBounds(shown.map(function (p) { return [p.la, p.ln]; })).pad(0.1), { maxZoom: 15 });
      }
      $('m-chips').addEventListener('click', function (e) {
        var bt = e.target.closest('button'); if (!bt) return; kind = bt.getAttribute('data-k');
        [].forEach.call($('m-chips').children, function (c) { c.classList.toggle('on', c === bt); });
        render(true);
      });
      find.addEventListener('input', function () { render(true); });
      area.addEventListener('change', function () { render(true); });
      beds.addEventListener('change', function () { render(true); });
      render(true);
    })();
  </script>
</Base>
