---
import Base from '../../layouts/Base.astro';
import { businesses, reviewsFor, href, stars } from '../../lib/data';
const list = businesses().sort((a, b) => a.name.localeCompare(b.name));
const areas = [...new Set(list.map((b) => b.area).filter(Boolean))].sort();
---
<Base title="Food" active="Food">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Eat like a local</p>
      <h1 style="margin-bottom:12px">What sounds good?</h1>
      <p class="lead" style="margin-bottom:28px">Reviews from Sara, with a rating you can trust.</p>
      <div class="card pad" style="max-width:520px"><label for="f-area">Area</label><select id="f-area"><option value="">Anywhere</option>{areas.map((a) => <option>{a}</option>)}</select></div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <p class="meta" id="f-count" style="margin-bottom:16px">{list.length} places</p>
      <div class="grid g3">
        {list.map((b) => { const r = reviewsFor(b.name)[0]; return (
          <a class="card pad f-item" data-area={b.area} href={href(b)} style="text-decoration:none">
            {r && stars(r.rating) > 0 && <span class="tag">{stars(r.rating)} out of 5</span>}
            <h4 style="margin:12px 0 4px">{b.name}</h4><p class="meta">{[b.tags[0], b.area].filter(Boolean).join(', ')}</p>
          </a>); })}
      </div>
    </div>
  </section>
  <script is:inline>
    var sel = document.getElementById('f-area'), items = [].slice.call(document.querySelectorAll('.f-item')), cnt = document.getElementById('f-count');
    function run() { var a = sel.value, n = 0; items.forEach(function (i) { var show = !a || i.dataset.area === a; i.style.display = show ? '' : 'none'; if (show) n++; }); cnt.textContent = n + (n === 1 ? ' place' : ' places'); }
    var q = new URLSearchParams(location.search).get('area'); if (q) sel.value = q;
    sel.addEventListener('change', run); run();
  </script>
</Base>
