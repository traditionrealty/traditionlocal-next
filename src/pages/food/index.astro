---
import Base from '../../layouts/Base.astro';
import Prefs from '../../components/Prefs.astro';
import '../../styles/pages.css';
import { businesses, href, url } from '../../lib/data';
import { category, foodTab, cuisineRegion, topRating, isFood, FOOD_TABS, WORLD } from '../../lib/helpers';

const cards = businesses().filter((b) => b.status !== 'Closed' && isFood(b)).map((b) => ({ b, cat: category(b), tab: foodTab(b), world: cuisineRegion(b), rating: topRating(b.name) }))
  .sort((x, y) => y.rating - x.rating || x.b.name.localeCompare(y.b.name));
const areaCount: Record<string, number> = {};
cards.forEach((c) => { if (c.b.area) areaCount[c.b.area] = (areaCount[c.b.area] || 0) + 1; });
const areas = Object.keys(areaCount).sort();
const topAreas = Object.entries(areaCount).sort((a, b) => b[1] - a[1]).slice(0, 6).map((x) => x[0]);
const worldLists: Record<string, typeof cards> = {};
WORLD.forEach(([k]) => { worldLists[k] = (k === 'all' ? cards.filter((c) => c.world) : cards.filter((c) => c.world === k)).slice(0, 9); });
// small index the page script uses for "Eat by neighborhood" and for saved places
const index = cards.map((c) => ({ s: c.b.slug, n: c.b.name, a: c.b.area, c: c.cat, r: c.rating, u: href(c.b) }));
const heart = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.6-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.4-9.5 9-9.5 9z"/></svg>';
---
<Base title="Food" active="Food" description="Reviews from Sara, with a rating you can trust.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Eat like a local</p>
      <h1 style="margin-bottom:12px">What sounds good?</h1>
      <p class="lead" style="margin-bottom:28px">Reviews from Sara, with a rating you can trust. Start with a craving, an area, or what is new. <a href={url('/how-we-review')} style="font-weight:700">How we review places</a></p>
      <div class="card pad"><div class="filters">
        <div><label for="f-q">Search</label><input id="f-q" type="search" placeholder="Try thai, coffee, or a place name" /></div>
        <div><label for="f-area">Area</label><select id="f-area"><option value="">Anywhere</option>{areas.map((a) => <option>{a}</option>)}</select></div>
        <div><label for="f-rating">Rating</label><select id="f-rating"><option value="0">Any</option><option value="5">5 out of 5</option><option value="4">4 or higher</option><option value="3">3 or higher</option></select></div>
      </div></div>
      <div class="tabs" id="f-tabs" style="margin-top:20px">{FOOD_TABS.map(([k, l], i) => <button class={`chip${i === 0 ? ' on' : ''}`} data-tab={k} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}</div>
    </div>
  </section>

  <section class="band" id="browse">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:24px;flex-wrap:wrap;gap:12px">
        <div><p class="eyebrow">Browse</p><h2>Every place we have reviewed</h2><p class="meta" id="f-count" style="margin-top:6px">{cards.length} places</p></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn line" href={url('/account#saved')}>Saved places (<span id="f-saved">0</span>)</a><button class="btn line" id="f-mail" type="button">Email my list</button></div>
      </div>
      <div class="grid g3" id="f-grid">
        {cards.map((c) => (
          <div class="card tcard f-item" data-area={c.b.area} data-tab={c.tab} data-r={c.rating} data-name={`${c.b.name} ${c.cat} ${c.b.area}`.toLowerCase()}>
            <a href={href(c.b)}>
              {c.rating > 0 && <span class="tag">{c.rating} out of 5</span>}
              <h4 style="margin:12px 0 4px">{c.b.name}</h4><p class="meta">{[c.cat, c.b.area].filter(Boolean).join(', ')}</p>
            </a>
            <button class="save" data-slug={c.b.slug} data-name={c.b.name} set:html={heart}></button>
          </div>
        ))}
      </div>
      <div class="card pad hidden" id="f-empty" style="margin-top:8px"><b>No places match yet.</b><p class="meta" style="margin-top:4px">Try a different area, rating, or search.</p></div>
      <p style="margin-top:24px"><a href="mailto:traditionlocal@gmail.com?subject=Suggest%20a%20place" style="font-weight:700">Know a favorite we missed? Suggest a place</a></p>
    </div>
  </section>

  <section class="band tint">
    <div class="wrap">
      <p class="eyebrow">Eat around the world</p>
      <h2 style="margin-bottom:24px">Follow a cuisine</h2>
      <div class="tabs" id="w-tabs" style="margin-bottom:24px">{WORLD.map(([k, l], i) => <button class={`chip${i === 0 ? ' on' : ''}`} data-world={k} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}</div>
      {WORLD.map(([k], i) => (
        <div class={`w-block${i === 0 ? '' : ' hidden'}`} data-world={k}>
          {worldLists[k].length ? (
            <div class="grid g3">{worldLists[k].map((c) => <a class="card pad" href={href(c.b)} style="text-decoration:none">{c.rating > 0 && <span class="tag">{c.rating} out of 5</span>}<h4 style="margin:12px 0 4px">{c.b.name}</h4><p class="meta">{[c.cat, c.b.area].filter(Boolean).join(', ')}</p></a>)}</div>
          ) : (
            <div class="card pad" style="max-width:640px"><b>We are still finding places for this region.</b><p class="meta" style="margin-top:4px">Know a favorite? Tell us and we will look into it.</p></div>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Eat by neighborhood</p>
      <h2 style="margin-bottom:12px">Start close to home</h2>
      <p class="meta" id="n-note" style="font-size:16px;margin-bottom:24px">Showing the busiest areas. Set your area in your account and it opens first.</p>
      <div class="tabs" id="n-tabs" style="margin-bottom:24px"></div>
      <div class="grid g3" id="n-grid"></div>
      <p style="margin-top:24px"><a id="n-link" href={url('/neighborhoods')} style="font-weight:700">See all neighborhoods</a></p>
    </div>
  </section>

  <Prefs />
  <script is:inline define:vars={{ INDEX: index, TOP: topAreas, BASE: url('') }}>
    var TLD = window.TL;
    // filters
    var q = document.getElementById('f-q'), sel = document.getElementById('f-area'), items = [].slice.call(document.querySelectorAll('.f-item')), tab = 'all';
    function run() {
      var term = q.value.trim().toLowerCase(), a = sel.value, n = 0, minR = +document.getElementById('f-rating').value;
      items.forEach(function (i) { var ok = (!a || i.dataset.area === a) && (tab === 'all' || i.dataset.tab === tab) && (!minR || +i.dataset.r >= minR) && (!term || i.dataset.name.indexOf(term) > -1); i.classList.toggle('hidden', !ok); if (ok) n++; });
      document.getElementById('f-count').textContent = n + (n === 1 ? ' place' : ' places');
      document.getElementById('f-empty').classList.toggle('hidden', n > 0);
    }
    var pre = new URLSearchParams(location.search).get('area'); if (pre) sel.value = pre;
    var pr = new URLSearchParams(location.search).get('rating'); if (pr && /^[1-5]$/.test(pr)) document.getElementById('f-rating').value = pr;
    q.addEventListener('input', run); sel.addEventListener('change', run); document.getElementById('f-rating').addEventListener('change', run);
    document.getElementById('f-tabs').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; tab = b.dataset.tab; [].forEach.call(this.children, function (c) { c.classList.toggle('on', c === b); c.setAttribute('aria-pressed', c === b ? 'true' : 'false'); }); run(); });
    run();
    // cuisine tabs
    document.getElementById('w-tabs').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; [].forEach.call(this.children, function (c) { c.classList.toggle('on', c === b); c.setAttribute('aria-pressed', c === b ? 'true' : 'false'); });
      document.querySelectorAll('.w-block').forEach(function (d) { d.classList.toggle('hidden', d.dataset.world !== b.dataset.world); }); });
    // saved count
    function savedCount() { document.getElementById('f-saved').textContent = TLD.saved().length; }
    document.addEventListener('tl:saved', savedCount); savedCount();
    document.getElementById('f-mail').addEventListener('click', function () {
      var s = TLD.saved(), rows = INDEX.filter(function (x) { return s.indexOf(x.s) > -1; });
      if (!rows.length) { alert('Save a place first by tapping its heart.'); return; }
      var body = rows.map(function (x) { return x.n + (x.a ? ' (' + x.a + ')' : '') + ': ' + location.origin + x.u; }).join('\n');
      location.href = 'mailto:?subject=' + encodeURIComponent('My saved places from Tradition Local') + '&body=' + encodeURIComponent(body);
    });
    // eat by neighborhood: the reader's area and followed areas come first
    var mine = TLD.area(), fol = TLD.follows(), names = [];
    [mine].concat(fol, TOP).forEach(function (a) { if (a && names.indexOf(a) < 0) names.push(a); });
    names = names.slice(0, 8);
    var current = names[0], tabs = document.getElementById('n-tabs'), grid = document.getElementById('n-grid');
    function label(a) { return a + (a === mine ? ' (your area)' : fol.indexOf(a) > -1 ? ' (following)' : ''); }
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
    function draw() {
      tabs.innerHTML = names.map(function (a) { return '<button class="chip' + (a === current ? ' on' : '') + '" data-a="' + esc(a) + '" aria-pressed="' + (a === current) + '">' + esc(label(a)) + '</button>'; }).join('');
      var list = INDEX.filter(function (x) { return x.a === current; }).sort(function (a, b) { return b.r - a.r; }).slice(0, 6);
      grid.innerHTML = list.length ? list.map(function (x) { return '<a class="card pad" href="' + esc(x.u) + '" style="text-decoration:none">' + (x.r ? '<span class="tag">' + x.r + ' out of 5</span>' : '') + '<h4 style="margin:12px 0 4px">' + esc(x.n) + '</h4><p class="meta">' + esc([x.c, x.a].filter(Boolean).join(', ')) + '</p></a>'; }).join('') : '<div class="card pad" style="max-width:640px"><b>No reviews here yet.</b><p class="meta" style="margin-top:4px">We are adding more every week.</p></div>';
      document.getElementById('n-note').textContent = current === mine ? 'Showing your area first.' : fol.indexOf(current) > -1 ? 'Showing an area you follow.' : 'Showing the busiest areas. Set your area in your account and it opens first.';
    }
    tabs.addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; current = b.dataset.a; draw(); });
    draw();
  </script>
</Base>
