---
import Base from '../../layouts/Base.astro';
import OpeningsPanel from '../../components/OpeningsPanel.astro';
import { openingsOf } from '../../lib/openings';
import Prefs from '../../components/Prefs.astro';
import FilterKit from '../../components/FilterKit.astro';
import '../../styles/pages.css';
import { businesses, href, url, isClosed } from '../../lib/data';
import { category, foodTab, cuisineRegion, topRating, isFood, FOOD_TABS, WORLD } from '../../lib/helpers';

const cards = businesses().filter((b) => !isClosed(b) && isFood(b)).map((b) => ({ b, cat: category(b), tab: foodTab(b), world: cuisineRegion(b), rating: topRating(b.name) }))
  .sort((x, y) => y.rating - x.rating || x.b.name.localeCompare(y.b.name));
const areaCount: Record<string, number> = {};
cards.forEach((c) => { if (c.b.area) areaCount[c.b.area] = (areaCount[c.b.area] || 0) + 1; });
const areas = Object.keys(areaCount).sort();
// small index the page script uses for "Eat by neighborhood" and for saved places
const index = cards.map((c) => ({ s: c.b.slug, n: c.b.name, a: c.b.area, c: c.cat, r: c.rating, u: href(c.b) }));
const heart = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.6-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.4-9.5 9-9.5 9z"/></svg>';
---
<Base title="Food" active="Food" description="Reviews from Sara, with a rating you can trust.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Eat like a local</p>
      <h1 style="margin-bottom:12px">What sounds good?</h1>
      <p class="lead" style="margin-bottom:28px">Reviews from Sara, with a rating you can trust. Start with a craving, an area, or what is new. <a href={url('/how-we-review')} style="font-weight:700">How we review places</a></p>
      <div class="fbar" id="f-bar">
        <div class="fbar-row">
          <div class="fbar-search"><label for="f-q">Search</label><input id="f-q" type="search" placeholder="Try thai, coffee, or a place name" autocomplete="off" /></div>
          <button class="chip fbar-toggle" type="button" aria-expanded="false" aria-controls="f-panel">Filters <span class="fcount hidden" id="f-badge"></span></button>
          <div class="fbar-panel" id="f-panel">
            <div class="fsel"><label for="f-area">Area</label><select id="f-area"><option value="">Anywhere</option>{areas.map((a) => <option>{a}</option>)}</select></div>
            <div class="fsel"><label for="f-world">Cuisine</label><select id="f-world"><option value="">Any cuisine</option>{WORLD.filter(([k]) => k !== 'all').map(([k, l]) => <option value={k}>{l}</option>)}</select></div>
            <div class="fsel"><label for="f-rating">Rating</label><select id="f-rating"><option value="0">Any</option><option value="5">5 out of 5</option><option value="4">4 or higher</option><option value="3">3 or higher</option></select></div>
            <div class="fbar-cats tabs" id="f-tabs">{FOOD_TABS.map(([k, l], i) => <button class={i === 0 ? 'chip on' : 'chip'} data-tab={k} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}</div>
          </div>
        </div>
        <div class="fbar-status"><div class="fpills" id="f-pills"></div><button class="flink hidden" id="f-mine" type="button"></button><button class="flink hidden" id="f-clear" type="button">Clear all</button><span class="meta" id="f-count">{cards.length} places</span></div>
      </div>
    </div>
  </section>

  {openingsOf('open').length + openingsOf('watch').length + openingsOf('closed').length > 0 && (
    <section class="band" id="openings">
      <div class="wrap">
        <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:28px;flex-wrap:wrap;gap:12px">
          <div><p class="eyebrow">Openings and closings</p><h2>Come along for the first bite</h2></div>
          <a class="btn line" href={url('/openings-and-closings')}>See openings and closings</a>
        </div>
        <OpeningsPanel limit={4} />
      </div>
    </section>
  )}

  <section class="band" id="browse" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:24px;flex-wrap:wrap;gap:12px">
        <div><p class="eyebrow">Browse</p><h2>Every place we have reviewed</h2></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn line" href={url('/account#saved')}>Saved places (<span id="f-saved">0</span>)</a><button class="btn line" id="f-mail" type="button">Email my list</button></div>
      </div>
      <div class="grid g3" id="f-grid">
        {cards.map((c, i) => (
          <div class={i < 24 ? 'card tcard f-item' : 'card tcard f-item hidden'} data-world={c.world} data-area={c.b.area} data-tab={c.tab} data-r={c.rating} data-name={`${c.b.name} ${c.cat} ${c.b.area}`.toLowerCase()}>
            <a href={href(c.b)}>
              {c.rating > 0 && <span class="tag">{c.rating} out of 5</span>}
              <h4 style="margin:12px 0 4px">{c.b.name}</h4><p class="meta">{[c.cat, c.b.area].filter(Boolean).join(', ')}</p>
            </a>
            <button class="save" data-slug={c.b.slug} data-name={c.b.name} set:html={heart}></button>
          </div>
        ))}
      </div>
      <p style="margin-top:24px"><button class="btn line hidden" id="f-more" type="button">Show more places</button></p>
      <div class="card pad hidden" id="f-empty" style="margin-top:8px"><b>No places match yet.</b><p class="meta" style="margin-top:4px">Try a different area, rating, or search.</p></div>
      <p style="margin-top:24px"><a href="mailto:traditionlocal@gmail.com?subject=Suggest%20a%20place" style="font-weight:700">Know a favorite we missed? Suggest a place</a></p>
    </div>
  </section>

  <FilterKit />
  <Prefs />
  <script is:inline define:vars={{ INDEX: index, BASE: url('') }}>
    var TLD = window.TL;
    // filters
    var $ = function (id) { return document.getElementById(id); };
    var area = $('f-area'), world = $('f-world'), rating = $('f-rating'), tabs = $('f-tabs');
    var pre = new URLSearchParams(location.search).get('area'); if (pre) area.value = pre;
    var pr = new URLSearchParams(location.search).get('rating'); if (pr && /^[1-5]$/.test(pr)) rating.value = pr;
    var cats = TLF.chips(tabs, 'tab', 'all');
    var kit = TLF.init({ bar: $('f-bar'), items: [].slice.call(document.querySelectorAll('.f-item')), search: $('f-q'), step: 24, noun: ['place', 'places'], count: $('f-count'), empty: $('f-empty'), more: $('f-more'), clear: $('f-clear'), pills: $('f-pills'), badge: $('f-badge'),
      filters: [TLF.select(area, 'area'), TLF.select(world, 'world'), TLF.min(rating, 'r', 'Rating: '), cats] });
    [area, world, rating].forEach(function (s) { s.addEventListener('change', kit.refresh); });
    tabs.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) { cats.set(b); kit.refresh(); } });
    // saved count
    function savedCount() { document.getElementById('f-saved').textContent = TLD.saved().length; }
    document.addEventListener('tl:saved', savedCount); savedCount();
    document.getElementById('f-mail').addEventListener('click', function () {
      var s = TLD.saved(), rows = INDEX.filter(function (x) { return s.indexOf(x.s) > -1; });
      if (!rows.length) { alert('Save a place first by tapping its heart.'); return; }
      var body = rows.map(function (x) { return x.n + (x.a ? ' (' + x.a + ')' : '') + ': ' + location.origin + x.u; }).join('\n');
      location.href = 'mailto:?subject=' + encodeURIComponent('My saved places from Tradition Local') + '&body=' + encodeURIComponent(body);
    });
    // a shortcut to the reader's own area
    var mine = TLD.area(), mineBtn = $('f-mine');
    if (mine && mineBtn && [].some.call(area.options, function (o) { return o.value === mine; })) {
      mineBtn.textContent = 'Only ' + mine; mineBtn.classList.remove('hidden');
      mineBtn.addEventListener('click', function () { area.value = mine; kit.refresh(); });
    }
  </script>
</Base>
