---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url } from '../lib/data';
import { config } from '../config';
const notices = [
  ['Consumer Protection Notice', 'A notice from the Texas Real Estate Commission about consumer protection, including how to file a complaint.', 'Texas Real Estate Commission Consumer Protection Notice', 'https://content.harstatic.com/pdf/TREC_CPN.pdf'],
  ['Information About Brokerage Services', 'Explains the roles a real estate license holder can have, and the duties a license holder owes you.', 'Texas Real Estate Commission Information About Brokerage Services', 'https://www.har.com/mhf/terms/dispBrokerInfo?sitetype=aws&cid=681837'],
];
---
<Base title="Texas real estate disclosures" active="" description="Required Texas real estate notices, plus who we are and how we are licensed.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Texas real estate disclosures</p>
      <h1 style="margin-bottom:16px;max-width:900px">Required notices, in one place.</h1>
      <p class="lead" style="max-width:720px">Texas asks real estate license holders to share a few notices. Here they are, along with who we are and how we are licensed.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Official Texas notices</p><h2 style="margin-bottom:28px">Please read these first.</h2>
      <div class="grid g2">
        {notices.map(([t, d, label, link]) => (
          <div class="card pad">
            <h3 style="margin-bottom:8px">{t}</h3>
            <p class="meta" style="font-size:16px;margin-bottom:18px">{d}</p>
            <a class="btn" href={link} target="_blank" rel="noopener">{label}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band tint">
    <div class="wrap split">
      <div class="main">
        <p class="eyebrow">Who we are</p><h2 style="margin-bottom:16px">Licensed in Texas.</h2>
        <p style="font-size:18px;margin-bottom:14px">Dillon Loren is a licensed Texas Realtor with Tradition Realty Group at Keller Williams Memorial. Texas real estate license number 681837.</p>
        <p style="font-size:18px;margin-bottom:14px">Real estate services are provided through Keller Williams Memorial, 1220 Augusta Drive, Suite 300, Houston, Texas 77057, (713) 461 9393. Each Keller Williams office is independently owned and operated.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px"><a class="btn line" href={config.brokerage.url} rel="noopener">Dillon on Keller Williams</a><a class="btn line" href="https://kwmemorial.com/" rel="noopener">Keller Williams Memorial</a></div>
      </div>
      <div class="side">
        <div class="card pad"><p class="eyebrow">Fair housing</p><p style="font-size:17px">We support the Fair Housing Act and equal housing opportunity for everyone. Equal Housing Opportunity.</p></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap" style="max-width:860px">
      <p class="eyebrow">About our content</p><h2 style="margin-bottom:16px">Opinions, not advice.</h2>
      <p style="font-size:18px;margin-bottom:14px">Tradition Local is community media. Our reviews, neighborhood guides, and videos are our own opinions and are meant for general information. They are not legal, financial, or real estate advice.</p>
      <p style="font-size:18px;margin-bottom:14px">Prices, schools, and other details change, so please check anything that matters to you before you decide. We do not show property listings on this site.</p>
      <p style="font-size:18px">If a place has a relationship with us, we say so in the review. You can read more in <a href={url('/how-we-review')} style="font-weight:700">How we review places</a>.</p>
    </div>
  </section>

  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap">
      <div style="max-width:700px"><h3 style="margin-bottom:8px">Questions about these notices?</h3><p style="font-size:17px">Send us a note, and we will point you in the right direction.</p></div>
      <a class="btn" href={url('/contact')}>Contact us</a>
    </div>
  </section>
</Base>
