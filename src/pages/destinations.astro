---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url } from '../lib/data';
const goals = ['Second Homes', 'Luxury Homes', 'Investment', 'Living Abroad', 'Residency', 'Citizenship', 'Golden Visas', 'Retirement', 'New Developments', 'Emerging Destinations'];
const regions = [
  { name: 'North America', countries: ['United States', 'Canada', 'Mexico'] },
  { name: 'Central America', countries: ['Costa Rica', 'Panama', 'Belize'] },
  { name: 'Caribbean', countries: ['Bahamas', 'Dominican Republic', 'Cayman Islands', 'Turks & Caicos'] },
  { name: 'South America', countries: ['Colombia', 'Uruguay', 'Argentina', 'Paraguay', 'Brazil'] },
  { name: 'Western Europe', countries: ['Portugal', 'Spain', 'France', 'Italy', 'United Kingdom'] },
  { name: 'Mediterranean & Balkans', countries: ['Greece', 'Cyprus', 'Malta', 'Croatia', 'Montenegro', 'Albania', 'Serbia'] },
  { name: 'Middle East & Türkiye', countries: ['UAE', 'Türkiye', 'Qatar', 'Saudi Arabia'] },
  { name: 'Caucasus', countries: ['Georgia'] },
  { name: 'North Africa', countries: ['Morocco', 'Egypt'] },
  { name: 'South & Southeast Asia', countries: ['Thailand', 'Malaysia', 'Vietnam', 'Indonesia', 'Singapore'] },
  { name: 'East Asia', countries: ['Japan'] },
  { name: 'Oceania & Indian Ocean', countries: ['Australia', 'Mauritius'] },
];
const ready: Record<string, string> = { Portugal: '/portugal' };
const phase1 = [
  { name: 'Mexico', region: 'North America', bg: '#FFE29A' },
  { name: 'UAE', region: 'Middle East & Türkiye', bg: '#E6EEF8' },
  { name: 'Portugal', region: 'Western Europe', bg: '#E8F5EC' },
  { name: 'Spain', region: 'Western Europe', bg: '#FFF4D6' },
  { name: 'Türkiye', region: 'Middle East & Türkiye', bg: '#E6EEF8' },
  { name: 'Greece', region: 'Mediterranean & Balkans', bg: '#FFE29A' },
  { name: 'Costa Rica', region: 'Central America', bg: '#E8F5EC' },
  { name: 'Panama', region: 'Central America', bg: '#FFF4D6' },
];
const slides = [
  { city: 'Lisbon', country: 'Portugal', region: 'Western Europe', bg: '#FFE29A', tags: ['Living Abroad', 'Second Homes', 'Residency'], href: '/portugal' },
  { city: 'Dubai', country: 'United Arab Emirates', region: 'Middle East & Türkiye', bg: '#E6EEF8', tags: ['Luxury Homes', 'Investment', 'New Developments'], href: '' },
  { city: 'Bodrum', country: 'Türkiye', region: 'Middle East & Türkiye', bg: '#E8F5EC', tags: ['Second Homes', 'Luxury Homes', 'Retirement'], href: '' },
  { city: 'Athens', country: 'Greece', region: 'Mediterranean & Balkans', bg: '#FFF4D6', tags: ['Investment', 'Residency', 'Living Abroad'], href: '' },
  { city: 'Cabo San Lucas', country: 'Mexico', region: 'North America', bg: '#FFE29A', tags: ['Second Homes', 'Retirement', 'Luxury Homes'], href: '' },
];
const pool = [
  { country: 'Portugal', cities: ['Lisbon', 'Porto'] },
  { country: 'United Arab Emirates', cities: ['Dubai', 'Abu Dhabi'] },
  { country: 'Türkiye', cities: ['Bodrum', 'Istanbul'] },
  { country: 'Greece', cities: ['Athens', 'Crete'] },
  { country: 'Mexico', cities: ['Cabo San Lucas', 'Tulum'] },
  { country: 'Spain', cities: ['Barcelona', 'Marbella'] },
  { country: 'Costa Rica', cities: ['Guanacaste', 'Tamarindo'] },
  { country: 'Panama', cities: ['Panama City', 'Boquete'] },
];
const tints = ['#FFE29A', '#E6EEF8', '#E8F5EC', '#FFF4D6'];
const tiles = pool.slice(0, 4).map((c, k) => ({ name: c.cities[0], sub: c.country, bg: tints[k] }));
---
<Base title="Destinations" active="More" description="Guides to places around the world, with honest notes on living, buying and staying.">
  <section class="band hero">
    <div class="wrap dest-hero">
      <div>
        <p class="eyebrow">Beyond Houston</p>
        <h1 style="margin-bottom:16px;max-width:760px">Discover a place. Make it home.</h1>
        <p class="lead" style="margin-bottom:28px;max-width:560px">Explore destinations around the world, see how living and buying work in each one, and understand your residency options before you decide.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="#regions">Browse by region</a><a class="btn line" href={url('/portugal')}>See the Portugal guide</a></div>
      </div>
      <div class="dest-tiles" data-pool={JSON.stringify(pool)} data-tints={JSON.stringify(tints)}>
        {tiles.map((t) => <div class="dest-tile" style={'background:' + t.bg}><b>{t.name}</b><span>{t.sub}</span></div>)}
      </div>
    </div>
  </section>

  <section class="band tint" id="spotlight" aria-label="International Spotlight">
    <div class="wrap">
      <div class="dest-head"><div><p class="eyebrow">International Spotlight</p><h2>Featured destination</h2></div><p class="meta" data-count aria-live="polite"></p></div>
      <div data-spot>
        {slides.map((s, i) => (
          <article class="spot-slide" data-slide data-city={s.city} hidden={i > 0}>
            <div class="spot-art" style={'background:' + s.bg}>{s.city}</div>
            <div class="spot-body">
              <p class="eyebrow">{s.region}</p>
              <h3>{s.city}</h3>
              <p class="meta">{s.country}</p>
              <div class="dest-tags">{s.tags.map((t) => <span class="tag soft">{t}</span>)}</div>
              {s.href ? <p><a class="btn" href={url(s.href)}>Read the {s.country} guide</a></p> : <p class="meta"><span class="pill-note">Guide coming soon</span></p>}
            </div>
          </article>
        ))}
      </div>
      <div class="spot-ctl" data-ctl hidden>
        <div class="spot-dots" data-dots></div>
        <div style="display:flex;gap:10px;align-items:center"><button type="button" class="btn line sm" data-pause>Pause</button><button type="button" class="spot-nav" data-prev aria-label="Previous destination">&lsaquo;</button><button type="button" class="spot-nav" data-next aria-label="Next destination">&rsaquo;</button></div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Start with your goal</p>
      <h2>What are you looking for?</h2>
      <div class="dest-goals">{goals.map((g) => <div class="card pad"><h4>{g}</h4></div>)}</div>
      <p class="meta">Guides for each goal open as destination pages are added.</p>
    </div>
  </section>

  <section class="band tint" id="regions">
    <div class="wrap">
      <p class="eyebrow">Browse by region</p>
      <h2>Twelve regions, one map</h2>
      <div class="dest-regions">
        {regions.map((r) => (
          <div class="dest-region">
            <h4>{r.name}</h4>
            <p class="meta">{r.countries.map((c, i) => (<Fragment>{i > 0 ? ', ' : ''}{ready[c] ? <a href={url(ready[c])}>{c}</a> : c}</Fragment>))}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">First destinations</p>
      <h2>Where we are starting</h2>
      <p class="meta" style="max-width:640px">An editorial order, not an investment ranking. Each guide opens only when its facts are checked against official sources.</p>
      <div class="dest-cards">
        {phase1.map((c) => (
          <div class="card dest-card">
            <div class="dest-card-art" style={'background:' + c.bg}></div>
            <div class="pad">
              <h4>{c.name}</h4>
              <p class="meta">{c.region}</p>
              {ready[c.name] ? <a class="btn sm" href={url(ready[c.name])}>Read the guide</a> : <span class="pill-note">Coming soon</span>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band tint">
    <div class="wrap dest-cross">
      <div>
        <p class="eyebrow">Moving to Houston?</p>
        <h3>Coming from another country?</h3>
        <p class="meta">Our International Clients page helps you get to know Houston before you arrive.</p>
      </div>
      <a class="btn line" href={url('/international')}>See International Clients</a>
    </div>
  </section>

  <section class="band" style="padding:40px 0">
    <div class="wrap"><p class="meta" style="max-width:760px;font-size:13px">Tradition Local shares general information to help you research. It is not legal, immigration, tax or investment advice. Rules change, so each guide shows the date it was last checked against official sources.</p></div>
  </section>
</Base>

<style is:global>
.dest-hero{display:grid;grid-template-columns:7fr 5fr;gap:64px;align-items:center}
.dest-tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:190px;gap:16px}
.dest-tile{border-radius:16px;padding:20px;display:flex;flex-direction:column;justify-content:flex-end;gap:4px;color:#1D1A6D;font-size:13px}
.dest-tile b{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:24px;line-height:1.2}
.dest-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:28px}
.spot-slide{display:grid;grid-template-columns:1fr 1fr;border-radius:16px;overflow:hidden;background:#fff;border:1px solid #EFEBE2;box-shadow:0 2px 12px rgba(29,26,109,.08);min-height:380px}
.spot-slide[hidden]{display:none}
.spot-art{display:flex;align-items:flex-end;padding:32px;font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:48px;line-height:1.1;color:#1D1A6D}
.spot-body{padding:44px;display:flex;flex-direction:column;justify-content:center;gap:12px}
.dest-tags{display:flex;gap:8px;flex-wrap:wrap}
.spot-ctl{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:20px}
.spot-ctl[hidden]{display:none}
.spot-dots{display:flex;align-items:center}
.spot-dot{width:44px;height:44px;border:0;background:none;padding:0;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.spot-dot i{display:block;height:10px;width:10px;border-radius:999px;background:#CFCBBE}
.spot-dot[aria-current="true"] i{width:28px;background:#1D1A6D}
.spot-nav{width:44px;height:44px;border-radius:50%;border:1.5px solid #1D1A6D;background:#fff;color:#1D1A6D;font-size:20px;cursor:pointer}
.dest-goals{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px;margin:28px 0 16px}
.dest-regions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px 24px;margin-top:28px}
.dest-region{border-top:2px solid #1D1A6D;padding-top:14px}
.dest-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:28px}
.dest-card-art{height:120px}
.dest-cross{display:flex;justify-content:space-between;align-items:center;gap:32px}
@media (max-width:900px){.dest-goals{grid-template-columns:repeat(3,minmax(0,1fr))}.dest-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:760px){.dest-hero{grid-template-columns:1fr;gap:32px}.dest-tiles{grid-auto-rows:150px}.spot-slide{grid-template-columns:1fr}.spot-art{min-height:200px;font-size:36px;padding:20px}.spot-body{padding:24px 20px}.dest-goals{grid-template-columns:repeat(2,minmax(0,1fr))}.dest-regions{grid-template-columns:1fr}.dest-cross{flex-direction:column;align-items:flex-start}.dest-head{flex-direction:column;align-items:flex-start;gap:8px}}
</style>

<script is:inline>
(function () {
  var reduce = false;
  try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
  var box = document.querySelector('.dest-tiles');
  if (box) {
    try {
      var pool = JSON.parse(box.getAttribute('data-pool'));
      var tints = JSON.parse(box.getAttribute('data-tints'));
      var pick = pool.slice().sort(function () { return Math.random() - 0.5; }).slice(0, 4);
      var tiles = box.querySelectorAll('.dest-tile');
      for (var k = 0; k < tiles.length && k < pick.length; k++) {
        var c = pick[k];
        var city = c.cities[Math.floor(Math.random() * c.cities.length)];
        tiles[k].style.background = tints[k];
        tiles[k].querySelector('b').textContent = city;
        tiles[k].querySelector('span').textContent = c.country;
      }
    } catch (e) {}
  }
  var slides = [].slice.call(document.querySelectorAll('[data-slide]'));
  var ctl = document.querySelector('[data-ctl]');
  var count = document.querySelector('[data-count]');
  if (!slides.length || !ctl) return;
  var i = Math.floor(Math.random() * slides.length);
  var paused = reduce;
  var held = false;
  var dots = ctl.querySelector('[data-dots]');
  var pauseBtn = ctl.querySelector('[data-pause]');
  slides.forEach(function (s, n) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'spot-dot';
    b.setAttribute('aria-label', 'Show ' + s.getAttribute('data-city'));
    b.innerHTML = '<i></i>';
    b.addEventListener('click', function () { show(n); });
    dots.appendChild(b);
  });
  function show(n) {
    i = (n + slides.length) % slides.length;
    slides.forEach(function (s, m) { s.hidden = m !== i; });
    [].slice.call(dots.children).forEach(function (d, m) {
      if (m === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
    });
    if (count) count.textContent = (i + 1) + ' of ' + slides.length;
  }
  function label() { pauseBtn.textContent = paused ? 'Play' : 'Pause'; }
  ctl.hidden = false;
  show(i);
  label();
  pauseBtn.addEventListener('click', function () { paused = !paused; label(); });
  ctl.querySelector('[data-prev]').addEventListener('click', function () { show(i - 1); });
  ctl.querySelector('[data-next]').addEventListener('click', function () { show(i + 1); });
  var area = document.querySelector('#spotlight');
  area.addEventListener('mouseenter', function () { held = true; });
  area.addEventListener('mouseleave', function () { held = false; });
  area.addEventListener('focusin', function () { held = true; });
  area.addEventListener('focusout', function () { held = false; });
  setInterval(function () { if (!paused && !held) show(i + 1); }, 6000);
})();
</script>
