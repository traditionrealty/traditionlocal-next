  <VideoScript />
  <script is:inline define:vars={{ WK: weekData }}>
    (function () {
      var now = new Date(), today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      var SH = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'], DAYN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      function p(s) { var a = s.split('-'); return new Date(+a[0], +a[1] - 1, +a[2]); }
      function iso(d) { return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
      function span(e) { return Math.round((p(e.f) - p(e.s)) / 86400000) + 1; }
      function label(e) { var a = p(e.s), b = p(e.f), x = SH[a.getMonth()] + ' ' + a.getDate(); return e.s === e.f ? x : x + ' to ' + SH[b.getMonth()] + ' ' + b.getDate(); }
      var dow = (today.getDay() + 6) % 7, mon = new Date(today); mon.setDate(today.getDate() - dow);
      var sun = new Date(mon); sun.setDate(mon.getDate() + 6);
      var from = iso(today), to = iso(sun);
      document.getElementById('hw-range').textContent = DAYN[mon.getDay()] + ' ' + SH[mon.getMonth()] + ' ' + mon.getDate() + ' to ' + DAYN[sun.getDay()] + ' ' + SH[sun.getMonth()] + ' ' + sun.getDate();
      var hits = WK.filter(function (e) { return e.f >= from && e.s <= to; }).sort(function (a, b) { return a.s < b.s ? -1 : a.s > b.s ? 1 : 0; });
      var shortOnes = hits.filter(function (e) { return span(e) <= 14; }), longOnes = hits.filter(function (e) { return span(e) > 14; });
      document.getElementById('hw-grid').innerHTML = shortOnes.slice(0, 4).map(function (e) { return '<a class="card pad" href="' + esc(e.u) + '" style="text-decoration:none"><span class="tag">' + esc(label(e)) + '</span><h4 style="margin:12px 0 6px">' + esc(e.t) + '</h4><p class="meta">' + esc(e.v) + '</p></a>'; }).join('');
      document.getElementById('hw-empty').classList.toggle('hidden', shortOnes.length > 0);
      var tabs = document.getElementById('ev-tabs'), soon = document.getElementById('ev-soon'), wk = document.getElementById('ev-week');
      function show(p) {
        wk.classList.toggle('hidden', p !== 'week'); if (soon) soon.classList.toggle('hidden', p !== 'soon');
        [].forEach.call(tabs.children, function (c) { var on = c.dataset.p === p; c.classList.toggle('on', on); c.setAttribute('aria-pressed', on ? 'true' : 'false'); });
      }
      tabs.children[0].textContent = 'This week' + (shortOnes.length ? ' (' + shortOnes.length + ')' : '');
      if (!soon) tabs.classList.add('hidden');
      tabs.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) show(b.dataset.p); });
      if (shortOnes.length === 0 && soon) show('soon');
      if (longOnes.length) {
        var soonest = longOnes.slice().sort(function (a, b) { return a.f < b.f ? -1 : a.f > b.f ? 1 : (a.t < b.t ? -1 : 1); }).slice(0, 4), n = longOnes.length;
        document.getElementById('wo-sub').textContent = n === 1 ? '1 exhibit, tour, or long running event' : n + ' exhibits, tours, and long running events';
        document.getElementById('wo-grid').innerHTML = soonest.map(function (e) { var q = e.f.split('-'), f = new Date(+q[0], +q[1] - 1, +q[2]); return '<a class="wo-row" href="' + esc(e.u) + '"><span class="wo-t">' + esc(e.t) + '</span><span class="wo-m">' + esc('Through ' + SH[f.getMonth()] + ' ' + f.getDate() + (e.v ? ', ' + e.v : '')) + '</span></a>'; }).join('');
        document.getElementById('hw-ongoing').classList.remove('hidden');
      }
    })();
  </script>
  <script is:inline define:vars={{ FOOD: foodIdx, FOODURL: url('/food') }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      $('finder').addEventListener('submit', function (e) {
        e.preventDefault();
        var a = $('h-area').value, c = $('h-craving').value;
        var list = FOOD.filter(function (x) { return (!a || x.a === a) && (!c || x.t === c); }).sort(function (x, y) { return y.r - x.r; }).slice(0, 4);
        $('finder-out').classList.remove('hidden');
        $('finder-again').classList.add('hidden');
        $('finder-h').textContent = a ? "Sara's favorites in " + a : "Sara's favorites";
        $('finder-list').innerHTML = list.length ? list.map(function (x) { return '<a class="card pad" href="' + esc(x.u) + '" style="text-decoration:none">' + (x.r ? '<span class="tag">' + x.r + ' out of 5</span>' : '') + '<h4 style="margin:12px 0 4px">' + esc(x.n) + '</h4><p class="meta">' + esc([x.c, x.a].filter(Boolean).join(', ')) + '</p></a>'; }).join('') : '<p class="meta" style="grid-column:1/-1">No reviews match yet. Try another area or craving.</p>';
        $('finder-more').href = FOODURL + (a ? '?area=' + encodeURIComponent(a) : '');
        $('finder-more').textContent = a ? 'See all food in ' + a : 'See all food';
      });
      var last = '';
      function surprise() {
        var a = $('h-area').value, c = $('h-craving').value;
        var pool = FOOD.filter(function (x) { return (!a || x.a === a) && (!c || x.t === c); });
        var liked = pool.filter(function (x) { return x.r >= 4; }); if (liked.length) pool = liked;
        $('finder-out').classList.remove('hidden');
        if (!pool.length) { $('finder-h').textContent = 'Nothing to surprise you with yet'; $('finder-list').innerHTML = '<p class="meta" style="grid-column:1/-1">Try another area or craving.</p>'; $('finder-again').classList.add('hidden'); return; }
        var x; do { x = pool[Math.floor(Math.random() * pool.length)]; } while (pool.length > 1 && x.n === last); last = x.n;
        $('finder-h').textContent = 'How about this one?' + (a ? ' In ' + a : '');
        $('finder-list').innerHTML = '<a class="card pad" href="' + esc(x.u) + '" style="text-decoration:none">' + (x.r ? '<span class="tag">' + x.r + ' out of 5</span>' : '') + '<h4 style="margin:12px 0 4px">' + esc(x.n) + '</h4><p class="meta">' + esc([x.c, x.a].filter(Boolean).join(', ')) + '</p></a>';
        $('finder-again').classList.remove('hidden');
        $('finder-more').href = FOODURL + (a ? '?area=' + encodeURIComponent(a) : '');
        $('finder-more').textContent = a ? 'See all food in ' + a : 'See all food';
      }
      $('surprise').addEventListener('click', surprise); $('finder-again').addEventListener('click', surprise);
      var fm = $('feed-more-btn');
      if (fm) fm.addEventListener('click', function () { var hid = document.querySelectorAll('.feed-more.hidden'); for (var i = 0; i < Math.min(6, hid.length); i++) hid[i].classList.remove('hidden'); if (document.querySelectorAll('.feed-more.hidden').length === 0) fm.classList.add('hidden'); });
      var hpf = $('hp-form'); if (hpf) hpf.addEventListener('submit', function () { try { var v = hpf.getAttribute('data-area'); if (v) localStorage.setItem('tl_area', JSON.stringify(v)); } catch (e) {} });
    })();
  </script>
