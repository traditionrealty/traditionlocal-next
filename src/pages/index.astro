---
import Base from '../layouts/Base.astro';
import { businesses, ofType, liveReviews, isClosed, reviewsFor, byName, events as allEvents, upcomingEvents, eventDates, dateText, href, media, posts, siteImage, stars, url } from '../lib/data';
import { config } from '../config';
import { isFood, foodTab, category, topRating, venuePlace, areaPages, foodIn } from '../lib/helpers';
import OpeningsPanel from '../components/OpeningsPanel.astro';
import { openingsOf } from '../lib/openings';
import VideoCard from '../components/VideoCard.astro';
import VideoScript from '../components/VideoScript.astro';
import { videos } from '../lib/videos';
import { spots, rotating } from '../lib/spotlight';
const events = upcomingEvents(5);
const heroPhoto = siteImage('home_hero');
const homeVideos = videos.slice(0, 3);
const tiles = [
  { n: businesses().filter((b) => !isClosed(b) && isFood(b) && topRating(b.name) > 0).length, unit: 'places reviewed', title: 'Where to Eat', blurb: 'Honest reviews, sorted by what you are craving.', cta: 'Browse food', path: '/food' },
  { n: areaPages().length, unit: 'neighborhood guides', title: 'Neighborhoods', blurb: 'Find the part of Houston that fits your life.', cta: 'Explore areas', path: '/neighborhoods' },
  { n: upcomingEvents(999).length, unit: 'coming up', title: 'Things to Do', blurb: 'Festivals, markets, and weekend plans.', cta: 'See the calendar', path: '/things-to-do' },
  { n: videos.length, unit: 'walks and reviews', title: 'Videos', blurb: 'Watch the neighborhood before you go.', cta: 'Watch now', path: '/videos' },
  { n: 8, unit: 'ways we can help', title: 'Make It Home', blurb: 'Buying, investing, or renting? Start with the neighborhood.', cta: 'Start here', path: '/make-it-home' },
];
const hasNew = openingsOf('open').length + openingsOf('watch').length + openingsOf('closed').length > 0;
const wkDate = (s: string) => { const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s || ''); return m ? new Date(+m[3], +m[1] - 1, +m[2]) : null; };
const wkIso = (d: Date) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
const weekData = allEvents().map((e) => { const a = wkDate(e.starts), b = wkDate(e.ends || e.starts), pl = venuePlace(e); return a && b ? { t: e.title, s: wkIso(a), f: wkIso(b), v: pl ? pl.name : (e.venue || e.profile || ''), u: href(e) } : null; }).filter(Boolean);
const areas = [...new Set(businesses().map((b) => b.area).filter(Boolean))].sort();
// A place counts as closed when its status says so, or when its photo is the Permanently closed notice (the status column is often still Unknown).
const looksClosed = (b: any) => isClosed(b) || /permanently closed|closed notice|temporarily closed/i.test((b && b.heroAlt) || '');
const picks = businesses().filter((b) => isFood(b) && !looksClosed(b)).map((b) => ({ b, r: reviewsFor(b.name).sort((x, y) => stars(y.rating) - stars(x.rating))[0] })).filter((x) => x.r && stars(x.r.rating) >= 4)
  .sort((x, y) => stars(y.r.rating) - stars(x.r.rating)).slice(0, 4);
const places = ofType('Neighborhood', 'City').filter((p) => p.show.living).slice(0, 8);
const POPULAR = ['Bellaire', 'Cypress', 'Energy Corridor', 'Galleria', 'The Heights', 'Katy', 'Memorial Villages', 'Oak Forest', 'Spring Branch', 'Sugar Land'];
const popular = POPULAR.map((n) => areaPages().find((p) => p.name === n)).filter(Boolean);
const hoodCount = areaPages().length;
const ts = (s: string) => { const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s || ''); return m ? +new Date(+m[3], +m[1] - 1, +m[2]) : 0; };
const snippet = (r: any) => { const t = (r.summary || r.body || '').replace(/\s+/g, ' ').trim(); return t.length > 150 ? t.slice(0, 150).replace(/\s+\S*$/, '') + '...' : t; };
const written = liveReviews().filter((r) => snippet(r));
const reviewPool = (written.length >= 6 ? written : liveReviews()).filter((r) => !looksClosed(byName(r.profile))).slice().sort((a, b) => ts(b.reviewDate) - ts(a.reviewDate));
// Articles and guides from the Content tab join the feed: one after every two reviews. Guides first.
const postPool = posts().filter((p) => snippet(p)).sort((a, b) => (b.type === 'Guide' ? 1 : 0) - (a.type === 'Guide' ? 1 : 0)).slice(0, 6);
const feedPool: any[] = [];
for (let i = 0, j = 0; feedPool.length < 18 && (i < reviewPool.length || j < postPool.length);) {
  for (let n = 0; n < 2 && i < reviewPool.length && feedPool.length < 18; n++) feedPool.push(reviewPool[i++]);
  if (j < postPool.length && feedPool.length < 18) feedPool.push(postPool[j++]);
}
const feed = feedPool.map((r) => { const post = r.type !== 'Review'; const biz = post ? undefined : byName(r.profile); return { r, post, biz, text: snippet(r), m: media(r) || (biz ? media(biz) : null) }; });
const foodIdx = businesses().filter((b) => isFood(b) && !isClosed(b)).map((b) => ({ n: b.name, u: href(b), a: b.area, c: category(b), r: topRating(b.name), t: foodTab(b) }));
---
<Base title="Home" active="">
  <section class="band hero">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center">
      <div style="grid-column:span 7">
        <p class="eyebrow">Houston, with a local perspective</p>
        <h1 style="margin-bottom:20px">Where Should We Go?</h1>
        <p class="lead" style="margin-bottom:28px">Honest reviews, weekend plans, and neighborhood guides from people who live here. Tell us what you're in the mood for.</p>
        <form class="card" id="finder" method="get" action={url('/food')} style="padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:end">
          <div><label for="h-area">Area</label><select id="h-area" name="area"><option value="">Anywhere</option>{areas.map((a) => <option>{a}</option>)}</select></div>
          <div><label for="h-craving">Craving</label><select id="h-craving"><option value="">Anything</option><option value="coffee">Coffee and cafes</option><option value="restaurant">Restaurants</option><option value="sweets">Bakeries and sweets</option><option value="market">Markets</option></select></div>
          <div style="grid-column:1/-1;display:flex;gap:12px;flex-wrap:wrap"><button class="btn" type="submit">Show me</button><button class="btn line" type="button" id="surprise">Surprise me</button></div>
        </form>
        <div id="finder-out" class="hidden" style="margin-top:20px" aria-live="polite">
          <p class="eyebrow" id="finder-h" style="margin-bottom:10px"></p>
          <div class="grid g2" id="finder-list"></div>
          <p style="margin-top:14px;display:flex;gap:18px;align-items:center;flex-wrap:wrap"><button class="btn line sm hidden" id="finder-again" type="button">Another one</button><a id="finder-more" href={url('/food')} style="font-weight:700">See all food</a></p>
        </div>
      </div>
      <div style="grid-column:span 5">{heroPhoto ? <img class="photo" style="height:400px;border-radius:16px" src={heroPhoto.src} alt={heroPhoto.alt} /> : <div class="ph" style="height:400px;border-radius:16px">Photo</div>}</div>
    </div>
  </section>

  <section class="band" id="home-explore">
    <div class="wrap">
      <p class="eyebrow">Start exploring</p>
      <h2 style="margin-bottom:28px">Find Your Way Around</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px">
        {tiles.map((t) => (
          <a class="card pad tile" href={url(t.path)} style="text-decoration:none">
            <div style="font-family:var(--serif);font-weight:600;font-size:40px;line-height:1">{t.n}</div>
            <p class="meta" style="margin:4px 0 14px;font-size:14px">{t.unit}</p>
            <h4 style="margin-bottom:6px">{t.title}</h4>
            <p class="meta" style="font-size:15px;margin-bottom:14px">{t.blurb}</p>
            <span style="font-weight:700;color:var(--blue)">{t.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {picks.length > 0 && (
    <section class="band tint" id="home-picks">
      <div class="wrap">
        <p class="eyebrow">Sara's Picks</p>
        <h2 style="margin-bottom:28px">Places We Love, and Why</h2>
        <div class="grid g4">
          {picks.map(({ b, r }) => { const m = media(b); return (
            <a class="card" href={href(b)} style="text-decoration:none">
              {m ? <img class="photo" style="height:180px" src={m.src} alt={m.alt} loading="lazy" /> : <div class="ph" style="height:180px">Photo coming soon</div>}
              <div class="pad"><span class="tag">{stars(r.rating)} out of 5</span><h4 style="margin:12px 0 4px">{b.name}</h4><p class="meta">{b.area}</p></div>
            </a>); })}
        </div>
        <p style="margin-top:24px"><a href={url('/food')} style="font-weight:700">See every place we have reviewed</a></p>
      </div>
    </section>
  )}

  <section class="band" id="meet">
    <div class="wrap ms">
      <div class="ms-av" aria-hidden="true"><span>S</span><span>D</span></div>
      <div class="ms-txt">
        <p class="eyebrow">Who we are</p>
        <h2>Meet Sara and Dillon</h2>
        <p>Sara visits the places she writes about. Dillon is a Realtor who answers questions personally.</p>
      </div>
      <div class="ms-btns"><a class="btn" href={url('/about')}>Meet Sara and Dillon</a><a class="btn line" href={url('/ask-dillon')}>Ask Dillon</a></div>
    </div>
  </section>

  {homeVideos.length > 0 && (
    <section class="band tint" id="home-videos">
      <div class="wrap">
        <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:28px;flex-wrap:wrap;gap:12px">
          <div><p class="eyebrow">Local videos</p><h2>Walk the Neighborhood With Us</h2></div>
          <a class="btn line" href={url('/videos')}>See all videos</a>
        </div>
        <div class="grid g3">{homeVideos.map((v) => <VideoCard v={v} />)}</div>
        <p style="margin-top:20px"><a href={config.youtube} rel="noopener" style="font-weight:700">Watch more on YouTube</a></p>
      </div>
    </section>
  )}

  {feed.length > 0 && (
    <section class="band" id="feed">
      <div class="wrap">
        <p class="eyebrow">The feed</p>
        <h2 style="margin-bottom:8px">Fresh From Sara, Dillon, and Our Contributors</h2>
        <p class="meta" style="margin-bottom:28px;font-size:17px">The newest reviews and stories, written by people who live here.</p>
        <div class="grid g3" id="feed-grid">
          {feed.map((x, i) => (
            <a class={i >= 6 ? 'card pad feed-more hidden' : 'card pad'} href={href(x.r)} style="text-decoration:none">
              {x.m && <img class="photo" style="height:150px;border-radius:8px;margin-bottom:14px" src={x.m.src} alt={x.m.alt} />}
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px"><span class="tag">{x.post ? x.r.type : 'Review'}</span>{!x.post && stars(x.r.rating) > 0 && <span class="tag soft">{stars(x.r.rating)} out of 5</span>}{(x.post ? x.r.profile : (x.biz && x.biz.area)) && <span class="tag soft">{x.post ? x.r.profile : x.biz.area}</span>}</div>
              <h4 style="margin-bottom:8px">{x.post ? x.r.title : (x.biz ? x.biz.name : x.r.title)}</h4>
              <p class="meta" style="font-size:15px;margin-bottom:12px">{x.text}</p>
              <p class="meta" style="font-weight:700;color:var(--blue)">{x.post ? 'Read the ' + x.r.type.toLowerCase() : 'Read the review' + (x.r.reviewDate ? ', ' + dateText(x.r.reviewDate) : '')}</p>
            </a>
          ))}
        </div>
        <p style="margin-top:28px;display:flex;gap:18px;align-items:center;flex-wrap:wrap">{feed.length > 6 && <button class="btn line" id="feed-more-btn" type="button">Show more</button>}<a href={url('/food')} style="font-weight:700">See every place we have reviewed</a></p>
      </div>
    </section>
  )}

  <section class="band navy">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center">
      <div style="grid-column:span 6">
        <p class="eyebrow">In the Loop</p>
        <h2 style="color:#fff;margin-bottom:16px">The Best of Houston, Once a Week</h2>
        <p style="font-size:19px;color:#fff;max-width:480px">Every Monday: food we trust, weekend plans, and what just opened. Free, friendly, and written by people who live here.</p>
        <p style="margin-top:14px"><a href={url('/how-we-review')} style="color:var(--butter);font-weight:700">How we review places</a></p>
      </div>
      <div style="grid-column:span 6">
        <form class="card pad" action={config.newsletterAction} method="post">
          <label for="home-email">Your email</label>
          <input id="home-email" name="email" type="email" required placeholder="name@email.com" />
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <input type="hidden" name="return" class="nl-return" />
          <button class="btn" type="submit" style="width:100%;margin-top:16px;min-height:52px">Count me in</button>
          <p class="meta" style="margin-top:12px">One click to leave anytime. We never sell your email.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="band" id="home-events">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:16px;flex-wrap:wrap;gap:12px">
        <div><p class="eyebrow">What's Happening</p><h2>Plan Something Fun</h2></div>
        <a class="btn line" href={url('/things-to-do')}>See the full calendar</a>
      </div>
      <div class="tabs" id="ev-tabs" style="margin-bottom:22px"><button class="chip on" data-p="week" aria-pressed="true">This week</button>{events.length > 0 && <button class="chip" data-p="soon" aria-pressed="false">Coming up</button>}</div>
      <div id="ev-week">
        <p class="meta" id="hw-range" style="margin-bottom:20px">&nbsp;</p>
        <div class="grid g4" id="hw-grid"></div>
        <div class="card pad hidden" id="hw-empty"><b>Nothing listed for the rest of this week yet.</b><p class="meta" style="margin-top:4px">Browse everything on the calendar, or check back soon.</p></div>
        <div class="wo hidden" id="hw-ongoing">
          <div class="wo-head"><div><span class="wo-lab">On all week</span><span class="wo-sub" id="wo-sub"></span></div><a class="wo-all" href={url('/things-to-do/#ongoing')}>See all ongoing</a></div>
          <div class="wo-grid" id="wo-grid"></div>
        </div>
      </div>
      {events.length > 0 && (
        <div id="ev-soon" class="hidden">
          <div class="grid g4">
            {events.map((e) => <a class="card pad" href={href(e)} style="text-decoration:none"><span class="tag">{eventDates(e)}</span><h4 style="margin:12px 0 6px">{e.title}</h4><p class="meta">{e.venue || e.profile}</p></a>)}
          </div>
        </div>
      )}
    </div>
  </section>

  {spots.length > 0 && (
    <section class="band tint" id="home-spotlight">
      <div class="wrap">
        <aside class="spot-wrap" aria-label="Neighborhood spotlight">
          {spots.map((s, i) => (
            <a class={i === 0 ? 'spot-card' : 'spot-card hidden'} href={s.link} rel={s.external ? 'noopener' : undefined}>
              <div class="spot-head">
                <p class="eyebrow">Neighborhood spotlight</p>
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px"><span class="tag">{s.label}</span>{s.region && <span class="tag soft">{s.region}</span>}{s.date && <span class="tag soft">{s.date}</span>}</div>
                <h2 class="spot-title">{s.title}</h2>
                <p class="spot-sum">{s.summary}</p>
              </div>
              <div class="spot-facts">
                {s.bestFor && <p class="meta"><b>Best for:</b> {s.bestFor}</p>}
                {s.homes && <p class="meta"><b>Typical homes:</b> {s.homes}</p>}
                {(s.places > 0 || s.subs > 0) && <p class="meta"><b>{s.places}</b> places reviewed, <b>{s.subs}</b> subdivisions</p>}
                <span class="btn spot-btn">{s.cta}</span>
              </div>
            </a>
          ))}
        </aside>
        <script is:inline>
          (function () {
            var cards = document.querySelectorAll('.spot-card');
            if (cards.length < 2) return;
            var last = -1;
            try { last = parseInt(sessionStorage.getItem('spotLast'), 10); if (isNaN(last)) last = -1; } catch (e) {}
            var pick = Math.floor(Math.random() * cards.length);
            if (pick === last) pick = (pick + 1 + Math.floor(Math.random() * (cards.length - 1))) % cards.length;
            try { sessionStorage.setItem('spotLast', String(pick)); } catch (e) {}
            [].forEach.call(cards, function (c, k) { c.classList.toggle('hidden', k !== pick); });
          })();
        </script>
      </div>
    </section>
  )}

  {places.length > 0 && (
    <section class="band" id="home-hood">
      <div class="wrap">
        <div class="hood-pick">
          <div>
            <p class="eyebrow">Locally Plus</p>
            <h2 style="margin-bottom:12px">Where Do You Call Home?</h2>
            <p style="font-size:17px;margin-bottom:18px">Pick your neighborhood, and Locally Plus brings you curated food picks, things to do, and more nearby.</p>
            <div class="hp-search">
              <label class="sr" for="hp-q">Search neighborhoods</label>
              <input id="hp-q" type="search" role="combobox" aria-expanded="false" aria-controls="hp-list" aria-autocomplete="list" autocomplete="off" placeholder={'Search ' + hoodCount + ' neighborhoods'} />
              <div id="hp-list" class="hp-list hidden" role="listbox"></div>
            </div>
            <div class="chips" id="hp-chips" style="margin-top:14px">{popular.map((p) => <a class="chip" href={href(p)} data-n={p.name}>{p.name}</a>)}</div>
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px"><a class="btn line" href={url('/neighborhoods')}>Browse all neighborhoods</a><a class="btn line" href={url('/find-your-fit')}>Not sure? Find your fit</a></div>
          </div>
          <div class="card hp-card" id="hp-card" aria-live="polite">
            <div id="hp-empty">
              <p class="eyebrow">Your area</p>
              <h3 style="margin-bottom:8px">Pick a Neighborhood</h3>
              <p class="meta" style="font-size:16px">Search or tap a popular area, and we will show you what is good there.</p>
            </div>
            <div id="hp-detail" class="hidden">
              <p class="eyebrow">Your area</p>
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px"><span class="tag soft hidden" id="hp-region"></span></div>
              <h3 id="hp-name" style="margin-bottom:6px"></h3>
              <p class="meta" id="hp-summary" style="font-size:16px;margin-bottom:10px"></p>
              <p class="meta hidden" id="hp-best" style="margin-bottom:4px"><b>Best for:</b> <span></span></p>
              <p class="meta hidden" id="hp-homes" style="margin-bottom:12px"><b>Typical homes:</b> <span></span></p>
              <div id="hp-top" class="hidden"><p style="font-size:13px;font-weight:700;margin-bottom:6px">Top rated places</p><ul class="hp-places" id="hp-places"></ul></div>
              <a class="btn line" id="hp-guide" href="#">Read the guide</a>
              <form class="hp-form" id="hp-form" action={config.newsletterAction} method="post">
                <label for="hp-email" id="hp-form-label">Get Locally Plus</label>
                <div class="hp-row" id="hp-row-guest"><input id="hp-email" name="email" type="email" required placeholder="name@email.com" /><button class="btn" type="submit">Join</button></div>
                <div id="hp-row-user" class="hidden"><button class="btn" type="submit" id="hp-add">Add to Locally Plus</button><p class="meta" id="hp-as" style="font-size:13px;margin-top:8px"></p></div>
                <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" class="nl-return" />
                <p class="meta" id="hp-note" style="font-size:13px;margin-top:8px"></p>
              </form>
            </div>
          </div>
        </div>
        <script is:inline define:vars={{ AREAS_URL: url('/area-preview.json') }}>
          (function () {
            var $ = function (id) { return document.getElementById(id); };
            var q = $('hp-q'); if (!q) return;
            var list = $('hp-list'), data = null, loading = null, matches = [], active = -1;
            function load() {
              if (data) return Promise.resolve(data);
              if (!loading) loading = fetch(AREAS_URL).then(function (r) { return r.json(); }).catch(function () { return []; }).then(function (j) { data = j; return j; });
              return loading;
            }
            function find(name) { var d = data || []; for (var i = 0; i < d.length; i++) if (d[i].n === name) return d[i]; return null; }
            function close() { list.classList.add('hidden'); q.setAttribute('aria-expanded', 'false'); q.removeAttribute('aria-activedescendant'); active = -1; }
            function paintList() {
              list.innerHTML = '';
              matches.forEach(function (a, i) {
                var o = document.createElement('button'); o.type = 'button'; o.className = 'hp-opt'; o.id = 'hp-o-' + i; o.setAttribute('role', 'option'); o.setAttribute('aria-selected', i === active ? 'true' : 'false'); o.textContent = a.n;
                if (a.g) { var s = document.createElement('small'); s.textContent = a.g; o.appendChild(s); }
                o.addEventListener('mousedown', function (e) { e.preventDefault(); choose(a); });
                list.appendChild(o);
              });
              if (!matches.length) { var n = document.createElement('p'); n.className = 'meta'; n.style.padding = '10px 12px'; n.textContent = 'No neighborhood found. Try a shorter name.'; list.appendChild(n); }
              list.classList.remove('hidden'); q.setAttribute('aria-expanded', 'true');
            }
            function search() {
              var t = q.value.trim().toLowerCase(); if (!t) { close(); return; }
              load().then(function (d) {
                var starts = d.filter(function (a) { return a.n.toLowerCase().indexOf(t) === 0; }), has = d.filter(function (a) { return a.n.toLowerCase().indexOf(t) > 0; });
                matches = starts.concat(has).slice(0, 8); active = matches.length ? 0 : -1; paintList();
                if (active > -1) q.setAttribute('aria-activedescendant', 'hp-o-0');
              });
            }
            function choose(a) {
              q.value = a.n; close();
              $('hp-name').textContent = a.n; $('hp-summary').textContent = a.s;
              var rg = $('hp-region'); rg.textContent = a.g; rg.classList.toggle('hidden', !a.g);
              [['hp-best', a.b], ['hp-homes', a.h]].forEach(function (x) { var p = $(x[0]); p.querySelector('span').textContent = x[1]; p.classList.toggle('hidden', !x[1]); });
              var ul = $('hp-places'); ul.innerHTML = '';
              a.t.forEach(function (t) { var li = document.createElement('li'), l = document.createElement('a'), r = document.createElement('span'); l.href = t[2]; l.textContent = t[0]; r.className = 'meta'; r.textContent = t[1] + ' out of 5'; li.appendChild(l); li.appendChild(r); ul.appendChild(li); });
              $('hp-top').classList.toggle('hidden', !a.t.length);
              var g = $('hp-guide'); g.href = a.u; g.textContent = 'Read the ' + a.n + ' guide';
              $('hp-form-label').textContent = 'Get Locally Plus for ' + a.n; $('hp-note').textContent = 'Get curated food picks, things to do, and more near ' + a.n + ', with Locally Plus.'; $('hp-add').textContent = 'Add ' + a.n + ' to Locally Plus'; $('hp-form').setAttribute('data-area', a.n);
              $('hp-empty').classList.add('hidden'); $('hp-detail').classList.remove('hidden');
