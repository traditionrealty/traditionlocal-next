---
import Base from '../layouts/Base.astro';
import { businesses, ofType, reviews, reviewsFor, byName, events as allEvents, upcomingEvents, eventDates, dateText, href, media, stars, url } from '../lib/data';
import { config } from '../config';
import { isFood, foodTab, category, topRating, venuePlace, areaPages } from '../lib/helpers';
import OpeningsPanel from '../components/OpeningsPanel.astro';
import { openingsOf } from '../lib/openings';
import VideoCard from '../components/VideoCard.astro';
import VideoScript from '../components/VideoScript.astro';
import { videos } from '../lib/videos';
import { spots, rotating } from '../lib/spotlight';
const events = upcomingEvents(5);
const homeVideos = videos.slice(0, 3);
const tiles = [
  { n: businesses().filter((b) => b.status !== 'Closed' && isFood(b) && topRating(b.name) > 0).length, unit: 'places reviewed', title: 'Where to eat', blurb: 'Honest reviews, sorted by what you are craving.', cta: 'Browse food', path: '/food' },
  { n: areaPages().length, unit: 'neighborhood guides', title: 'Neighborhoods', blurb: 'Find the part of Houston that fits your life.', cta: 'Explore areas', path: '/neighborhoods' },
  { n: upcomingEvents(999).length, unit: 'coming up', title: 'Things to do', blurb: 'Festivals, markets, and weekend plans.', cta: 'See the calendar', path: '/things-to-do' },
  { n: videos.length, unit: 'walks and reviews', title: 'Videos', blurb: 'Watch the neighborhood before you go.', cta: 'Watch now', path: '/videos' },
  { n: 6, unit: 'ways we can help', title: 'Make it home', blurb: 'Moving, renting, or buying? Start with the neighborhood.', cta: 'Start here', path: '/make-it-home' },
];
const hasNew = openingsOf('open').length + openingsOf('watch').length + openingsOf('closed').length > 0;
const wkDate = (s: string) => { const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s || ''); return m ? new Date(+m[3], +m[1] - 1, +m[2]) : null; };
const wkIso = (d: Date) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
const weekData = allEvents().map((e) => { const a = wkDate(e.starts), b = wkDate(e.ends || e.starts), pl = venuePlace(e); return a && b ? { t: e.title, s: wkIso(a), f: wkIso(b), v: pl ? pl.name : (e.venue || e.profile || ''), u: href(e) } : null; }).filter(Boolean);
const areas = [...new Set(businesses().map((b) => b.area).filter(Boolean))].sort();
const picks = businesses().filter(isFood).map((b) => ({ b, r: reviewsFor(b.name).sort((x, y) => stars(y.rating) - stars(x.rating))[0] })).filter((x) => x.r && stars(x.r.rating) >= 4)
  .sort((x, y) => stars(y.r.rating) - stars(x.r.rating)).slice(0, 4);
const places = ofType('Neighborhood', 'City').filter((p) => p.show.living).slice(0, 8);
const ts = (s: string) => { const m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s || ''); return m ? +new Date(+m[3], +m[1] - 1, +m[2]) : 0; };
const snippet = (r: any) => { const t = (r.summary || r.body || '').replace(/\s+/g, ' ').trim(); return t.length > 150 ? t.slice(0, 150).replace(/\s+\S*$/, '') + '...' : t; };
const written = reviews().filter((r) => snippet(r));
const feedPool = (written.length >= 6 ? written : reviews()).slice().sort((a, b) => ts(b.reviewDate) - ts(a.reviewDate)).slice(0, 18);
const feed = feedPool.map((r) => { const biz = byName(r.profile); return { r, biz, text: snippet(r), m: media(r) || (biz ? media(biz) : null) }; });
const foodIdx = businesses().filter(isFood).filter((b) => b.status !== 'Closed').map((b) => ({ n: b.name, u: href(b), a: b.area, c: category(b), r: topRating(b.name), t: foodTab(b) }));
---
<Base title="Home" active="">
  <section class="band hero">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center">
      <div style="grid-column:span 7">
        <p class="eyebrow">Houston, with a local perspective</p>
        <h1 style="margin-bottom:20px">Where should we go?</h1>
        <p class="lead" style="margin-bottom:28px">Honest reviews, weekend plans, and neighborhood guides from people who live here. Tell us what you're in the mood for.</p>
        <form class="card" id="finder" method="get" action={url('/food')} style="padding:24px;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:end">
          <div><label for="h-area">Area</label><select id="h-area" name="area"><option value="">Anywhere</option>{areas.map((a) => <option>{a}</option>)}</select></div>
          <div><label for="h-craving">Craving</label><select id="h-craving"><option value="">Anything</option><option value="coffee">Coffee and cafes</option><option value="restaurant">Restaurants</option><option value="sweets">Bakeries and sweets</option><option value="market">Markets</option></select></div>
          <div style="grid-column:1/-1;display:flex;gap:12px;flex-wrap:wrap"><button class="btn" type="submit">Show me</button><button class="btn line" type="button" id="surprise">Surprise me</button></div>
        </form>
        <div id="finder-out" class="hidden" style="margin-top:20px" aria-live="polite">
          <p class="eyebrow" id="finder-h" style="margin-bottom:10px"></p>
          <div class="grid g2" id="finder-list"></div>
          <p style="margin-top:14px;display:flex;gap:18px;align-items:center;flex-wrap:wrap"><button class="btn line sm hidden" id="finder-again" type="button">Another one</button><a id="finder-more" href={url('/food')} style="font-weight:700">See all food</a></p>
        </div>
      </div>
      <div style="grid-column:span 5"><div class="ph" style="height:400px;border-radius:16px">Photo</div></div>
    </div>
  </section>

  <section class="band" id="home-explore">
    <div class="wrap">
      <p class="eyebrow">Start exploring</p>
      <h2 style="margin-bottom:28px">Find your way around.</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px">
        {tiles.map((t) => (
          <a class="card pad tile" href={url(t.path)} style="text-decoration:none">
            <div style="font-family:var(--serif);font-weight:600;font-size:40px;line-height:1">{t.n}</div>
            <p class="meta" style="margin:4px 0 14px;font-size:14px">{t.unit}</p>
            <h4 style="margin-bottom:6px">{t.title}</h4>
            <p class="meta" style="font-size:15px;margin-bottom:14px">{t.blurb}</p>
            <span style="font-weight:700;color:var(--blue)">{t.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {picks.length > 0 && (
    <section class="band tint" id="home-picks">
      <div class="wrap">
        <p class="eyebrow">Sara's Picks</p>
        <h2 style="margin-bottom:28px">Places we love, and why</h2>
        <div class="grid g4">
          {picks.map(({ b, r }) => { const m = media(b); return (
            <a class="card" href={href(b)} style="text-decoration:none">
              {m ? <img class="photo" style="height:180px" src={m.src} alt={m.alt} loading="lazy" /> : <div class="ph" style="height:180px">Photo coming soon</div>}
              <div class="pad"><span class="tag">{stars(r.rating)} out of 5</span><h4 style="margin:12px 0 4px">{b.name}</h4><p class="meta">{b.area}</p></div>
            </a>); })}
        </div>
        <p style="margin-top:24px"><a href={url('/food')} style="font-weight:700">See every place we have reviewed</a></p>
      </div>
    </section>
  )}

  <section class="band" id="home-events">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:16px;flex-wrap:wrap;gap:12px">
        <div><p class="eyebrow">What is on</p><h2>Plan something fun</h2></div>
        <a class="btn line" href={url('/things-to-do')}>See the full calendar</a>
      </div>
      <div class="tabs" id="ev-tabs" style="margin-bottom:22px"><button class="chip on" data-p="week" aria-pressed="true">This week</button>{events.length > 0 && <button class="chip" data-p="soon" aria-pressed="false">Coming up</button>}</div>
      <div id="ev-week">
        <p class="meta" id="hw-range" style="margin-bottom:20px">&nbsp;</p>
        <div class="grid g4" id="hw-grid"></div>
        <div class="card pad hidden" id="hw-empty"><b>Nothing listed for the rest of this week yet.</b><p class="meta" style="margin-top:4px">Browse everything on the calendar, or check back soon.</p></div>
        <p class="meta" id="hw-ongoing" style="margin-top:18px"></p>
      </div>
      {events.length > 0 && (
        <div id="ev-soon" class="hidden">
          <div class="grid g4">
            {events.map((e) => <a class="card pad" href={href(e)} style="text-decoration:none"><span class="tag">{eventDates(e)}</span><h4 style="margin:12px 0 6px">{e.title}</h4><p class="meta">{e.venue || e.profile}</p></a>)}
          </div>
        </div>
      )}
    </div>
  </section>

  {hasNew && (
    <section class="band tint" id="new-this-month">
      <div class="wrap">
        <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:28px;flex-wrap:wrap;gap:12px">
          <div><p class="eyebrow">New this month</p><h2>Openings and closings</h2></div>
          <a class="btn line" href={url('/openings-and-closings')}>See openings and closings</a>
        </div>
        <OpeningsPanel limit={3} />
      </div>
    </section>
  )}

  <section class="band navy">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center">
      <div style="grid-column:span 6">
        <p class="eyebrow">In the Loop</p>
        <h2 style="color:#fff;margin-bottom:16px">The best of Houston, once a week.</h2>
        <p style="font-size:19px;color:#fff;max-width:480px">Every Monday: food we trust, weekend plans, and what just opened. Free, friendly, and written by people who live here.</p>
        <p style="margin-top:14px"><a href={url('/how-we-review')} style="color:var(--butter);font-weight:700">How we review places</a></p>
      </div>
      <div style="grid-column:span 6">
        <form class="card pad" action={config.newsletterAction} method="post">
          <label for="home-email">Your email</label>
          <input id="home-email" name="email" type="email" required placeholder="name@email.com" />
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <input type="hidden" name="return" class="nl-return" />
          <button class="btn" type="submit" style="width:100%;margin-top:16px;min-height:52px">Count me in</button>
          <p class="meta" style="margin-top:12px">One click to leave anytime. We never sell your email.</p>
        </form>
      </div>
    </div>
  </section>

  {places.length > 0 && (
    <section class="band" id="home-hood">
      <div class="wrap">
        <div class={spots.length > 0 ? 'hood-split' : ''}>
          <div>
            <p class="eyebrow">Neighborhood guides</p>
            <h2 style="margin-bottom:16px">Where do you call home?</h2>
            <p style="font-size:17px;margin-bottom:20px">Pick an area to see what is good nearby.</p>
            <div class="chips">{places.map((p) => <a class="chip" href={href(p)}>{p.name}</a>)}</div>
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px"><a class="btn line" href={url('/neighborhoods')}>Browse all neighborhoods</a><a class="btn line" href={url('/find-your-fit')}>Not sure? Find your fit</a></div>
          </div>
          {spots.length > 0 && (
            <aside aria-label="Neighborhood spotlight">
              {spots.map((s, i) => (
                <a class={i === 0 ? 'card spot-card' : 'card spot-card hidden'} href={s.link} rel={s.external ? 'noopener' : undefined}>
                  <p class="eyebrow">Neighborhood spotlight</p>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px"><span class="tag">{s.label}</span>{s.region && <span class="tag soft">{s.region}</span>}{s.date && <span class="tag soft">{s.date}</span>}</div>
                  <h3>{s.title}</h3>
                  <p class="meta" style="font-size:16px;margin:8px 0 12px">{s.summary}</p>
                  {s.bestFor && <p class="meta" style="margin-bottom:4px"><b>Best for:</b> {s.bestFor}</p>}
                  {s.homes && <p class="meta" style="margin-bottom:4px"><b>Typical homes:</b> {s.homes}</p>}
                  {(s.places > 0 || s.subs > 0) && <p class="meta"><b>{s.places}</b> places reviewed, <b>{s.subs}</b> subdivisions</p>}
                  <span class="spot-link">{s.cta}</span>
                </a>
              ))}
            </aside>
          )}
        </div>
        <script is:inline>
          (function () {
            var cards = document.querySelectorAll('.spot-card');
            if (cards.length < 2) return;
            var pick = Math.floor(Date.now() / 604800000) % cards.length;
            [].forEach.call(cards, function (c, k) { c.classList.toggle('hidden', k !== pick); });
          })();
        </script>
        <form class="card pad" id="home-locally" action={config.newsletterAction} method="post" style="margin-top:28px;max-width:760px;display:grid;gap:14px">
          <div><p class="eyebrow">Locally</p><h3 style="margin-bottom:6px">Your neighborhood, in your inbox.</h3><p class="meta" style="font-size:16px">For now, signing up joins In the Loop, and Locally for your area follows when it opens. Your area is saved on this device.</p></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div><label for="hl-area">Your area</label><select id="hl-area"><option value="">Choose an area</option>{areas.map((a) => <option>{a}</option>)}</select></div><div><label for="hl-email">Your email</label><input id="hl-email" name="email" type="email" required placeholder="name@email.com" /></div></div>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" class="nl-return" />
          <div><button class="btn" type="submit">Get Locally</button></div>
        </form>
      </div>
    </section>
  )}
  <script is:inline>document.querySelectorAll('.nl-return').forEach(function (r) { r.value = location.origin + location.pathname; });</script>
  {homeVideos.length > 0 && (
    <section class="band tint" id="home-videos">
      <div class="wrap">
        <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:28px;flex-wrap:wrap;gap:12px">
          <div><p class="eyebrow">Local videos</p><h2>Walk the neighborhood with us</h2></div>
          <a class="btn line" href={url('/videos')}>See all videos</a>
        </div>
        <div class="grid g3">{homeVideos.map((v) => <VideoCard v={v} />)}</div>
        <p style="margin-top:20px"><a href={config.youtube} rel="noopener" style="font-weight:700">Watch more on YouTube</a></p>
      </div>
    </section>
  )}

  {feed.length > 0 && (
    <section class="band" id="feed">
      <div class="wrap">
        <p class="eyebrow">The feed</p>
        <h2 style="margin-bottom:8px">Fresh from Sara, Dillon, and our Contributors</h2>
        <p class="meta" style="margin-bottom:28px;font-size:17px">The newest reviews and stories, written by people who live here.</p>
        <div class="grid g3" id="feed-grid">
          {feed.map((x, i) => (
            <a class={i >= 6 ? 'card pad feed-more hidden' : 'card pad'} href={href(x.r)} style="text-decoration:none">
              {x.m && <img class="photo" style="height:150px;border-radius:8px;margin-bottom:14px" src={x.m.src} alt={x.m.alt} />}
              <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px"><span class="tag">Review</span>{stars(x.r.rating) > 0 && <span class="tag soft">{stars(x.r.rating)} out of 5</span>}{x.biz && x.biz.area && <span class="tag soft">{x.biz.area}</span>}</div>
              <h4 style="margin-bottom:8px">{x.biz ? x.biz.name : x.r.title}</h4>
              <p class="meta" style="font-size:15px;margin-bottom:12px">{x.text}</p>
              <p class="meta" style="font-weight:700;color:var(--blue)">Read the review{x.r.reviewDate ? ', ' + dateText(x.r.reviewDate) : ''}</p>
            </a>
          ))}
        </div>
        <p style="margin-top:28px;display:flex;gap:18px;align-items:center;flex-wrap:wrap">{feed.length > 6 && <button class="btn line" id="feed-more-btn" type="button">Show more</button>}<a href={url('/food')} style="font-weight:700">See every place we have reviewed</a></p>
      </div>
    </section>
  )}

  <section class="band tint" id="meet">
    <div class="wrap" style="display:flex;gap:48px;align-items:center;flex-wrap:wrap">
      <div style="flex:1 1 320px;max-width:460px"><div class="ph" style="height:340px;border-radius:12px">Photo of Sara and Dillon coming soon</div></div>
      <div style="flex:1 1 380px">
        <p class="eyebrow">Who we are</p>
        <h2 style="margin-bottom:16px">Meet Sara and Dillon</h2>
        <p style="font-size:18px;margin-bottom:14px">We started Tradition Local to help people feel connected to their neighborhood, community, and city.</p>
        <p style="font-size:18px;margin-bottom:24px">Sara visits the places she writes about, then shares what she found, honestly and kindly. Dillon is a Realtor who loves these neighborhoods and answers questions personally.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/about')}>Meet Sara and Dillon</a><a class="btn line" href={url('/ask-dillon')}>Ask Dillon</a></div>
      </div>
    </div>
  </section>

  <VideoScript />
  <script is:inline define:vars={{ WK: weekData }}>
    (function () {
      var now = new Date(), today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      var SH = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'], DAYN = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      function p(s) { var a = s.split('-'); return new Date(+a[0], +a[1] - 1, +a[2]); }
      function iso(d) { return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); }
      function span(e) { return Math.round((p(e.f) - p(e.s)) / 86400000) + 1; }
      function label(e) { var a = p(e.s), b = p(e.f), x = SH[a.getMonth()] + ' ' + a.getDate(); return e.s === e.f ? x : x + ' to ' + SH[b.getMonth()] + ' ' + b.getDate(); }
      var dow = (today.getDay() + 6) % 7, mon = new Date(today); mon.setDate(today.getDate() - dow);
      var sun = new Date(mon); sun.setDate(mon.getDate() + 6);
      var from = iso(today), to = iso(sun);
      document.getElementById('hw-range').textContent = DAYN[mon.getDay()] + ' ' + SH[mon.getMonth()] + ' ' + mon.getDate() + ' to ' + DAYN[sun.getDay()] + ' ' + SH[sun.getMonth()] + ' ' + sun.getDate();
      var hits = WK.filter(function (e) { return e.f >= from && e.s <= to; }).sort(function (a, b) { return a.s < b.s ? -1 : a.s > b.s ? 1 : 0; });
      var shortOnes = hits.filter(function (e) { return span(e) <= 14; }), longOnes = hits.filter(function (e) { return span(e) > 14; });
      document.getElementById('hw-grid').innerHTML = shortOnes.slice(0, 4).map(function (e) { return '<a class="card pad" href="' + esc(e.u) + '" style="text-decoration:none"><span class="tag">' + esc(label(e)) + '</span><h4 style="margin:12px 0 6px">' + esc(e.t) + '</h4><p class="meta">' + esc(e.v) + '</p></a>'; }).join('');
      document.getElementById('hw-empty').classList.toggle('hidden', shortOnes.length > 0);
      var tabs = document.getElementById('ev-tabs'), soon = document.getElementById('ev-soon'), wk = document.getElementById('ev-week');
      function show(p) {
        wk.classList.toggle('hidden', p !== 'week'); if (soon) soon.classList.toggle('hidden', p !== 'soon');
        [].forEach.call(tabs.children, function (c) { var on = c.dataset.p === p; c.classList.toggle('on', on); c.setAttribute('aria-pressed', on ? 'true' : 'false'); });
      }
      tabs.children[0].textContent = 'This week' + (shortOnes.length ? ' (' + shortOnes.length + ')' : '');
      if (!soon) tabs.classList.add('hidden');
      tabs.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) show(b.dataset.p); });
      if (shortOnes.length === 0 && soon) show('soon');
      document.getElementById('hw-ongoing').innerHTML = longOnes.length ? 'Also on all week: ' + longOnes.slice(0, 4).map(function (e) { return '<a href="' + esc(e.u) + '" style="font-weight:700">' + esc(e.t) + '</a>'; }).join(', ') + '.' : '';
    })();
  </script>
  <script is:inline define:vars={{ FOOD: foodIdx, FOODURL: url('/food') }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      $('finder').addEventListener('submit', function (e) {
        e.preventDefault();
        var a = $('h-area').value, c = $('h-craving').value;
        var list = FOOD.filter(function (x) { return (!a || x.a === a) && (!c || x.t === c); }).sort(function (x, y) { return y.r - x.r; }).slice(0, 4);
        $('finder-out').classList.remove('hidden');
        $('finder-again').classList.add('hidden');
        $('finder-h').textContent = a ? "Sara's favorites in " + a : "Sara's favorites";
        $('finder-list').innerHTML = list.length ? list.map(function (x) { return '<a class="card pad" href="' + esc(x.u) + '" style="text-decoration:none">' + (x.r ? '<span class="tag">' + x.r + ' out of 5</span>' : '') + '<h4 style="margin:12px 0 4px">' + esc(x.n) + '</h4><p class="meta">' + esc([x.c, x.a].filter(Boolean).join(', ')) + '</p></a>'; }).join('') : '<p class="meta" style="grid-column:1/-1">No reviews match yet. Try another area or craving.</p>';
        $('finder-more').href = FOODURL + (a ? '?area=' + encodeURIComponent(a) : '');
        $('finder-more').textContent = a ? 'See all food in ' + a : 'See all food';
      });
      var last = '';
      function surprise() {
        var a = $('h-area').value, c = $('h-craving').value;
        var pool = FOOD.filter(function (x) { return (!a || x.a === a) && (!c || x.t === c); });
        var liked = pool.filter(function (x) { return x.r >= 4; }); if (liked.length) pool = liked;
        $('finder-out').classList.remove('hidden');
        if (!pool.length) { $('finder-h').textContent = 'Nothing to surprise you with yet'; $('finder-list').innerHTML = '<p class="meta" style="grid-column:1/-1">Try another area or craving.</p>'; $('finder-again').classList.add('hidden'); return; }
        var x; do { x = pool[Math.floor(Math.random() * pool.length)]; } while (pool.length > 1 && x.n === last); last = x.n;
        $('finder-h').textContent = 'How about this one?' + (a ? ' In ' + a : '');
        $('finder-list').innerHTML = '<a class="card pad" href="' + esc(x.u) + '" style="text-decoration:none">' + (x.r ? '<span class="tag">' + x.r + ' out of 5</span>' : '') + '<h4 style="margin:12px 0 4px">' + esc(x.n) + '</h4><p class="meta">' + esc([x.c, x.a].filter(Boolean).join(', ')) + '</p></a>';
        $('finder-again').classList.remove('hidden');
        $('finder-more').href = FOODURL + (a ? '?area=' + encodeURIComponent(a) : '');
        $('finder-more').textContent = a ? 'See all food in ' + a : 'See all food';
      }
      $('surprise').addEventListener('click', surprise); $('finder-again').addEventListener('click', surprise);
      var fm = $('feed-more-btn');
      if (fm) fm.addEventListener('click', function () { var hid = document.querySelectorAll('.feed-more.hidden'); for (var i = 0; i < Math.min(6, hid.length); i++) hid[i].classList.remove('hidden'); if (document.querySelectorAll('.feed-more.hidden').length === 0) fm.classList.add('hidden'); });
      $('home-locally').addEventListener('submit', function () { try { var v = $('hl-area').value; if (v) localStorage.setItem('tl_area', JSON.stringify(v)); } catch (e) {} });
    })();
  </script>
