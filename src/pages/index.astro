---
import Base from '../layouts/Base.astro';
import { businesses, ofType, reviewsFor, upcomingEvents, eventDates, href, media, stars, url } from '../lib/data';
import { config } from '../config';
import { isFood, foodTab, category, topRating } from '../lib/helpers';
const events = upcomingEvents(5);
const areas = [...new Set(businesses().map((b) => b.area).filter(Boolean))].sort();
const picks = businesses().filter(isFood).map((b) => ({ b, r: reviewsFor(b.name).sort((x, y) => stars(y.rating) - stars(x.rating))[0] })).filter((x) => x.r && stars(x.r.rating) >= 4)
  .sort((x, y) => stars(y.r.rating) - stars(x.r.rating)).slice(0, 4);
const places = ofType('Neighborhood', 'City').filter((p) => p.show.living).slice(0, 8);
const foodIdx = businesses().filter(isFood).filter((b) => b.status !== 'Closed').map((b) => ({ n: b.name, u: href(b), a: b.area, c: category(b), r: topRating(b.name), t: foodTab(b) }));
---
<Base title="Home" active="">
  <section class="band hero">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center">
      <div style="grid-column:span 7">
        <p class="eyebrow">Houston, with a local perspective</p>
        <h1 style="margin-bottom:20px">Where should we go?</h1>
        <p class="lead" style="margin-bottom:28px">Honest reviews, weekend plans, and neighborhood guides from people who live here. Tell us what you're in the mood for.</p>
        <form class="card" id="finder" method="get" action={url('/food')} style="padding:24px;display:grid;grid-template-columns:1fr 1fr auto;gap:14px;align-items:end">
          <div><label for="h-area">Area</label><select id="h-area" name="area"><option value="">Anywhere</option>{areas.map((a) => <option>{a}</option>)}</select></div>
          <div><label for="h-craving">Craving</label><select id="h-craving"><option value="">Anything</option><option value="coffee">Coffee and cafes</option><option value="restaurant">Restaurants</option><option value="sweets">Bakeries and sweets</option><option value="market">Markets</option></select></div>
          <button class="btn" type="submit">Show me</button>
        </form>
        <div id="finder-out" class="hidden" style="margin-top:20px" aria-live="polite">
          <p class="eyebrow" id="finder-h" style="margin-bottom:10px"></p>
          <div class="grid g2" id="finder-list"></div>
          <p style="margin-top:14px"><a id="finder-more" href={url('/food')} style="font-weight:700">See all food</a></p>
        </div>
      </div>
      <div style="grid-column:span 5"><div class="ph" style="height:400px;border-radius:16px">Photo</div></div>
    </div>
  </section>

  {events.length > 0 && (
    <section class="band">
      <div class="wrap">
        <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:28px;flex-wrap:wrap;gap:12px">
          <div><p class="eyebrow">This weekend and beyond</p><h2>Good ways to spend it</h2></div>
          <a class="btn line" href={url('/things-to-do')}>See all things to do</a>
        </div>
        <div class="grid g4">
          {events.map((e) => <a class="card pad" href={href(e)} style="text-decoration:none"><span class="tag">{eventDates(e)}</span><h4 style="margin:12px 0 6px">{e.title}</h4><p class="meta">{e.venue || e.profile}</p></a>)}
        </div>
      </div>
    </section>
  )}

  {picks.length > 0 && (
    <section class="band tint">
      <div class="wrap">
        <p class="eyebrow">Sara's Picks</p>
        <h2 style="margin-bottom:28px">Places we love, and why</h2>
        <div class="grid g4">
          {picks.map(({ b, r }) => { const m = media(b); return (
            <a class="card" href={href(b)} style="text-decoration:none">
              {m ? <img class="photo" style="height:180px" src={m.src} alt={m.alt} loading="lazy" /> : <div class="ph" style="height:180px">Photo coming soon</div>}
              <div class="pad"><span class="tag">{stars(r.rating)} out of 5</span><h4 style="margin:12px 0 4px">{b.name}</h4><p class="meta">{b.area}</p></div>
            </a>); })}
        </div>
      </div>
    </section>
  )}

  <section class="band navy">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center">
      <div style="grid-column:span 6">
        <p class="eyebrow">In the Loop</p>
        <h2 style="color:#fff;margin-bottom:16px">The best of Houston, once a week.</h2>
        <p style="font-size:19px;color:#fff;max-width:480px">Every Monday: food we trust, weekend plans, and what just opened. Free, friendly, and written by people who live here.</p>
      </div>
      <div style="grid-column:span 6">
        <form class="card pad" action={config.newsletterAction} method="post">
          <label for="home-email">Your email</label>
          <input id="home-email" name="email" type="email" required placeholder="name@email.com" />
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <input type="hidden" name="return" class="nl-return" />
          <button class="btn" type="submit" style="width:100%;margin-top:16px;min-height:52px">Count me in</button>
          <p class="meta" style="margin-top:12px">One click to leave anytime. We never sell your email.</p>
        </form>
      </div>
    </div>
  </section>

  {places.length > 0 && (
    <section class="band tint">
      <div class="wrap">
        <p class="eyebrow">Neighborhood guides</p>
        <h2 style="margin-bottom:16px">Where do you call home?</h2>
        <p style="font-size:17px;margin-bottom:20px">Pick an area to see what is good nearby.</p>
        <div class="chips">{places.map((p) => <a class="chip" href={href(p)}>{p.name}</a>)}</div>
        <form class="card pad" id="home-locally" action={config.newsletterAction} method="post" style="margin-top:28px;max-width:760px;display:grid;gap:14px">
          <div><p class="eyebrow">Locally</p><h3 style="margin-bottom:6px">Your neighborhood, in your inbox.</h3><p class="meta" style="font-size:16px">For now, signing up joins In the Loop, and Locally for your area follows when it opens. Your area is saved on this device.</p></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div><label for="hl-area">Your area</label><select id="hl-area"><option value="">Choose an area</option>{areas.map((a) => <option>{a}</option>)}</select></div><div><label for="hl-email">Your email</label><input id="hl-email" name="email" type="email" required placeholder="name@email.com" /></div></div>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" class="nl-return" />
          <div><button class="btn" type="submit">Get Locally</button></div>
        </form>
      </div>
    </section>
  )}
  <script is:inline>document.querySelectorAll('.nl-return').forEach(function (r) { r.value = location.origin + location.pathname; });</script>
  <script is:inline define:vars={{ FOOD: foodIdx, FOODURL: url('/food') }}>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
      $('finder').addEventListener('submit', function (e) {
        e.preventDefault();
        var a = $('h-area').value, c = $('h-craving').value;
        var list = FOOD.filter(function (x) { return (!a || x.a === a) && (!c || x.t === c); }).sort(function (x, y) { return y.r - x.r; }).slice(0, 4);
        $('finder-out').classList.remove('hidden');
        $('finder-h').textContent = a ? "Sara's favorites in " + a : "Sara's favorites";
        $('finder-list').innerHTML = list.length ? list.map(function (x) { return '<a class="card pad" href="' + esc(x.u) + '" style="text-decoration:none">' + (x.r ? '<span class="tag">' + x.r + ' out of 5</span>' : '') + '<h4 style="margin:12px 0 4px">' + esc(x.n) + '</h4><p class="meta">' + esc([x.c, x.a].filter(Boolean).join(', ')) + '</p></a>'; }).join('') : '<p class="meta" style="grid-column:1/-1">No reviews match yet. Try another area or craving.</p>';
        $('finder-more').href = FOODURL + (a ? '?area=' + encodeURIComponent(a) : '');
        $('finder-more').textContent = a ? 'See all food in ' + a : 'See all food';
      });
      $('home-locally').addEventListener('submit', function () { try { var v = $('hl-area').value; if (v) localStorage.setItem('tl_area', JSON.stringify(v)); } catch (e) {} });
    })();
  </script>
</Base>
