              load().then(function () { var a = find(c.getAttribute('data-n')); if (a) choose(a); else location.href = c.href; });
            });
            var saved = ''; try { saved = JSON.parse(localStorage.getItem('tl_area') || '""'); } catch (e) {}
            if (saved) load().then(function () { var a = find(saved); if (a) choose(a); });
            var user = null; try { user = JSON.parse(localStorage.getItem('tl_user') || 'null'); } catch (e) {}
