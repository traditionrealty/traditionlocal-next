---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url } from '../lib/data';
import MoreWays from '../components/MoreWays.astro';
const ORDER = ['Ask Dillon', 'Find your fit', 'Local Directory', 'Apartment locating', 'Neighborhoods', 'New builds'];
const tools = [
  ['Apartment locating', 'Tell us what matters, and we will help you narrow the list of rentals.', '/apartments', 'Open', true],
  ['Ask Dillon', 'Tell us where you are curious about, and Dillon replies personally. No pressure.', '/ask-dillon', 'Open', true],
  ['Neighborhoods', 'Area guides and subdivision profiles, with what it is like to live there.', '/neighborhoods', 'Open', true],
  ['Find your fit', 'Answer a few questions to see which neighborhoods match what you love.', '/find-your-fit', 'Open', true],
  ['New builds', 'Newer and master planned communities to compare side by side.', '/new-builds', 'Open', true],
  ['Local Directory', 'Providers we know and trust, for members.', '/local-directory', 'Members', true],
];
const services = [
  ['Relocation', 'Moving to Houston? Start with the neighborhood, then sort out the details.', '/relocation'],
  ['Commercial real estate', 'Buying, selling, or leasing space for a business.', '/commercial'],
  ['International clients', 'Moving to or buying in Houston from another country.', '/international'],
];
---
<Base title="Make it home" active="More" sub="makeithome" description="A place that fits. A life that feels like you.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Make it home</p>
      <h1 style="margin-bottom:16px;max-width:860px">A place that fits. A life that feels like you.</h1>
      <p class="lead" style="margin-bottom:28px">Moving, renting, or buying, start with the neighborhood. We will help you get to know it first.</p>
      <a class="btn" href={url('/ask-dillon')}>Ask Dillon</a>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Where to start</p><h2 style="margin-bottom:28px">Tools for getting to know a place</h2>
      <div class="grid g3">
        {[...tools].sort((a, b) => ORDER.indexOf(String(a[0])) - ORDER.indexOf(String(b[0]))).map(([name, blurb, path, label, live]) => (
          <a class="card pad" href={url(path as string)} style="text-decoration:none"><span class={live ? 'tag' : 'tag soft'}>{label}</span><h4 style="margin:12px 0 8px">{name}</h4><p class="meta" style="font-size:16px">{blurb}</p></a>
        ))}
      </div>
    </div>
  </section>
  <MoreWays cards={services} cols="g3" tint />
</Base>
