---
import Base from '../../layouts/Base.astro';
import '../../styles/pages.css';
import { events, upcomingEvents, href, media, eventDates, dateText, url } from '../../lib/data';
import { venuePlace, to12, timeRange } from '../../lib/helpers';
import { config } from '../../config';
import { hostsRsvp } from '../../lib/rsvp';
export function getStaticPaths() { return events().map((e) => ({ params: { slug: e.slug }, props: { e } })); }
const { e } = Astro.props;
const place = venuePlace(e), m = media(e) || (place ? media(place) : null);
const web = e.eventLink.replace(/^https?:\/\/(www\.)?/, '').replace(/\/.*$/, '');
const dates = e.starts && e.ends && e.ends !== e.starts ? `${dateText(e.starts)} to ${dateText(e.ends)}` : dateText(e.starts);
const where = place ? place.name : e.venue || e.profile;
const more = upcomingEvents(8).filter((x) => x.slug !== e.slug).slice(0, 3);
const rsvp = hostsRsvp(e);
const rsvpUrl = String(config.newsletterAction).replace(/\/$/, '') + '/rsvp';
const when = [dates, to12(e.startTime)].filter(Boolean).join(', ');
const loc = e.address && where && e.address.toLowerCase().indexOf(where.toLowerCase()) === 0 ? e.address : [where, e.address].filter(Boolean).join(', ');
// Events that repeat share a name, so the page title adds the date to tell them apart.
const pageTitle = e.starts && events().filter((x) => x.title === e.title).length > 1 ? e.title + ', ' + dateText(e.starts) : e.title;
---
<Base title={pageTitle} description={e.summary} active="Things to Do">
  <section class="band hero">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center">
      <div style="grid-column:span 8">
        <p class="meta" style="margin-bottom:12px"><a href={url('/things-to-do')} style="font-weight:700">Things to do</a> &rsaquo; {e.eventType || 'Event'}</p>
        <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap"><span class="tag">{e.eventType || 'Event'}</span><span class="tag soft">{eventDates(e)}</span></div>
        <h1 style="margin-bottom:16px">{e.title}</h1>
        {e.summary && <p class="lead" style="margin-bottom:28px">{e.summary}</p>}
        <div style="display:flex;gap:12px;flex-wrap:wrap">{e.eventLink && <a class="btn" href={e.eventLink} rel="noopener">Visit {web}</a>}<button class="btn line" id="ics">Add to calendar</button></div>
      </div>
      <div style="grid-column:span 4">{m ? <img class="photo" style="height:300px;border-radius:16px" src={m.src} alt={m.alt} /> : <div class="ph" style="height:300px;border-radius:16px">Event image</div>}</div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">The details</p><h2 style="margin-bottom:28px">Plan Your Visit</h2>
      <div class="grid g3">
        <div class="card pad"><p class="eyebrow">When</p><p style="font-size:20px;font-weight:700">{dates}</p>{(e.startTime || e.endTime) && <p class="meta" style="margin-top:6px">{timeRange(e.startTime, e.endTime)}</p>}</div>
        <div class="card pad"><p class="eyebrow">Where</p>{where ? <p style="font-size:20px;font-weight:700">{place ? <a href={href(place)}>{place.name}</a> : where}</p> : <p class="meta">Location coming soon.</p>}{e.address && <p class="meta" style="margin-top:6px">{e.address}</p>}</div>
        <div class="card pad"><p class="eyebrow">Cost</p><p style="font-size:20px;font-weight:700">{e.cost || 'Check the event site'}</p></div>
      </div>
      <p class="meta" style="margin-top:20px">Dates and prices can change, so check the event site before you go.</p>
      {e.tags.length > 0 && <div class="chips" style="margin-top:20px">{e.tags.map((t) => <span class="chip">{t}</span>)}</div>}
      {rsvp && (
        <div class="card pad" id="rsvp" data-starts={e.starts} data-ends={e.ends || e.starts} style="padding:32px;margin-top:40px;max-width:760px">
          <p class="eyebrow">RSVP</p><h3 style="margin-bottom:8px">Save Your Spot</h3>
          {e.starts ? (
            <>
              <p class="meta" id="rsvp-intro" style="margin-bottom:20px;font-size:16px">A Tradition Local event. Tell us who is coming and we will send a confirmation.</p>
              <div id="rsvp-ended" hidden><b>This event has ended.</b> <a href={url('/things-to-do')} style="font-weight:700">See what is coming up</a>.</div>
              <form id="rsvp-form" novalidate data-slug={e.slug} data-title={e.title} data-when={when} data-location={loc} data-endpoint={rsvpUrl} data-contact={config.contactEmail}>
                <div class="grid g2" style="margin-bottom:16px">
                  <div><label for="rsvp-first">First name</label><input id="rsvp-first" type="text" autocomplete="given-name" placeholder="Your first name" /><p class="msg-err" id="rsvp-first-err" hidden>Please add your first name.</p></div>
                  <div><label for="rsvp-last">Last name</label><input id="rsvp-last" type="text" autocomplete="family-name" placeholder="Your last name" /></div>
                </div>
                <div class="grid g2" style="margin-bottom:20px">
                  <div><label for="rsvp-email">Email</label><input id="rsvp-email" type="email" autocomplete="email" placeholder="name@email.com" /><p class="msg-err" id="rsvp-email-err" hidden>Enter an email address like name@company.com</p></div>
                  <div><label for="rsvp-guests">Guests, including you</label><select id="rsvp-guests"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></div>
                </div>
                <input id="rsvp-company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
                <button class="btn" id="rsvp-send" type="submit" style="min-height:52px">RSVP</button>
                <p class="msg-err" id="rsvp-fail" hidden></p>
              </form>
              <p id="rsvp-ok" hidden style="font-weight:700;color:var(--green);font-size:18px"></p>
            </>
          ) : (
            <p class="meta" style="font-size:16px">The date is coming soon. RSVP opens once it is set.</p>
          )}
        </div>
      )}
      <div class="card pad pick" style="padding:32px;margin-top:40px;max-width:760px">
        <p class="eyebrow">In the Loop</p><h3 style="margin-bottom:8px">Do Not Miss the Next One</h3>
        <p class="meta" style="margin-bottom:20px;font-size:16px">Every Monday: three local finds, the weekend list, and what just opened.</p>
        <form action={config.newsletterAction} method="post" style="display:flex;gap:10px;flex-wrap:wrap">
          <div style="flex:1;min-width:220px"><label class="sr" for="ev-email">Your email</label><input id="ev-email" name="email" type="email" required placeholder="name@email.com" /></div>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" class="nl-return" />
          <button class="btn" type="submit">Join In the Loop</button>
        </form>
      </div>
    </div>
  </section>
  {more.length > 0 && (
    <section class="band tint"><div class="wrap"><p class="eyebrow">Keep going</p><h2 style="margin-bottom:28px">More to Do</h2>
      <div class="grid g3">{more.map((x) => <a class="card pad" href={href(x)} style="text-decoration:none"><span class="tag">{eventDates(x)}</span><h4 style="margin:12px 0 6px">{x.title}</h4><p class="meta">{x.venue || x.profile || 'Houston'}</p></a>)}</div></div></section>
  )}
  <script is:inline define:vars={{ T: e.title, S: e.starts, E: e.ends || e.starts, W: where, L: e.eventLink }}>
    document.querySelectorAll('.nl-return').forEach(function (r) { r.value = location.origin + location.pathname; });
    function ymd(s) { var m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s || ''); return m ? m[3] + ('0' + m[1]).slice(-2) + ('0' + m[2]).slice(-2) : ''; }
    document.getElementById('ics').addEventListener('click', function () {
      var a = ymd(S), b = ymd(E) || a; if (!a) { alert('This event has no date yet.'); return; }
      var end = new Date(+b.slice(0, 4), +b.slice(4, 6) - 1, +b.slice(6, 8) + 1), pad = function (n) { return ('0' + n).slice(-2); };
      var endStr = end.getFullYear() + pad(end.getMonth() + 1) + pad(end.getDate());
      var ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Tradition Local//EN', 'BEGIN:VEVENT', 'UID:' + a + '-' + T.replace(/\W+/g, '') + '@traditionlocal.com', 'DTSTAMP:' + a + 'T000000Z', 'DTSTART;VALUE=DATE:' + a, 'DTEND;VALUE=DATE:' + endStr,
        'SUMMARY:' + T.replace(/[,;]/g, ' '), 'LOCATION:' + (W || '').replace(/[,;]/g, ' '), 'DESCRIPTION:' + (L || ''), 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
      var blob = new Blob([ics], { type: 'text/calendar' }), link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'event.ics'; link.click();
    });
  </script>
  <script is:inline>
    (function () {
      var card = document.getElementById('rsvp'), form = document.getElementById('rsvp-form'); if (!card || !form) return;
      var $ = function (id) { return document.getElementById(id); };
      function day(s) { var m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/.exec(s || ''); return m ? new Date(+m[3], +m[1] - 1, +m[2]) : null; }
      var last = day(card.getAttribute('data-ends')) || day(card.getAttribute('data-starts'));
      if (last && Date.now() > last.getTime() + 86400000) { form.hidden = true; $('rsvp-intro').hidden = true; $('rsvp-ended').hidden = false; return; }
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var first = $('rsvp-first').value.trim(), em = $('rsvp-email').value.trim();
        var okFirst = first.length > 0, okEm = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em);
        $('rsvp-first-err').hidden = okFirst; $('rsvp-email-err').hidden = okEm;
        if (!okFirst || !okEm) return;
        var btn = $('rsvp-send'), fail = $('rsvp-fail'); fail.hidden = true; btn.disabled = true; btn.textContent = 'Sending...';
        var body = { event_slug: form.dataset.slug, event_title: form.dataset.title, event_when: form.dataset.when, event_location: form.dataset.location, first_name: first, last_name: $('rsvp-last').value.trim(), email: em, party_size: +$('rsvp-guests').value, company: $('rsvp-company').value };
        try {
          var res = await fetch(form.dataset.endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          var out = await res.json(); if (!out.ok) throw new Error('rejected');
          form.hidden = true; $('rsvp-intro').hidden = true;
          var ok = $('rsvp-ok'); ok.textContent = out.duplicate ? 'You are already on the list for this event. See you there.' : 'You are on the list. Check your email for a confirmation.'; ok.hidden = false;
        } catch (err) {
          fail.textContent = 'We could not send your RSVP. Please try again in a moment, or email us at ' + form.dataset.contact + '.'; fail.hidden = false;
        } finally { btn.disabled = false; btn.textContent = 'RSVP'; }
      });
    })();
  </script>
  <style>
    .msg-err { color: var(--danger); font-size: 14px; font-weight: 700; margin-top: 6px; }
  </style>
</Base>
