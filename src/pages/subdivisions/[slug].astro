---
import Base from '../../layouts/Base.astro';
import '../../styles/pages.css';
import { profiles, byName, href, url } from '../../lib/data';
import { subsIn, bizIn, topRating, category } from '../../lib/helpers';
export function getStaticPaths() { return profiles.filter((p) => p.type === 'Subdivision').map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const area = byName(p.area);
const sibs = subsIn(p.area).filter((x) => x.slug !== p.slug).slice(0, 6);
const eats = bizIn(p.area).map((b) => ({ b, r: topRating(b.name) })).sort((x, y) => y.r - x.r).slice(0, 3);
---
<Base title={p.name} description={p.summary} active="Neighborhoods">
  <section class="band hero">
    <div class="wrap">
      <p class="meta" style="margin-bottom:12px"><a href={url('/neighborhoods')} style="font-weight:700">Neighborhoods</a>{area && <> &rsaquo; <a href={href(area)} style="font-weight:700">{area.name}</a></>} &rsaquo; {p.name}</p>
      <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap"><span class="tag">Subdivision</span>{p.area && <span class="tag soft">{p.area}</span>}{p.zips && <span class="tag soft">{p.zips}</span>}</div>
      <h1 style="margin-bottom:16px">{p.name}</h1>
      {p.summary && <p class="lead" style="margin-bottom:28px">{p.summary}</p>}
      <a class="btn line" href={url('/ask-dillon')}>Ask Dillon about {p.name}</a>
    </div>
  </section>
  <section class="band">
    <div class="wrap split">
      <div class="main">
        <p class="eyebrow">About</p><h2 style="margin-bottom:20px">What to know about {p.name}</h2>
        <p style="font-size:18px;margin-bottom:24px">{p.summary || 'We are still building this profile.'}</p>
        <p class="meta">Prices and school details are being reviewed, so we leave them out for now. Ask Dillon for the latest.</p>
      </div>
      <div class="side"><div class="card pad"><h3 style="margin-bottom:20px">Good to know</h3>
        {p.area && <p class="fact"><span>Area</span><b>{p.area}</b></p>}
        {p.postalCity && <p class="fact"><span>City</span><b>{p.postalCity}</b></p>}
        {p.zips && <p class="fact"><span>Zip code</span><b>{p.zips}</b></p>}
      </div></div>
    </div>
  </section>
  {sibs.length > 0 && <section class="band tint"><div class="wrap"><p class="eyebrow">Around {p.area}</p><h2 style="margin-bottom:28px">More subdivisions nearby</h2><div class="chips">{sibs.map((s) => <a class="chip" href={href(s)}>{s.name}</a>)}</div></div></section>}
  {eats.length > 0 && <section class="band"><div class="wrap"><p class="eyebrow">Eat nearby</p><h2 style="margin-bottom:28px">Places we love around {p.area}</h2><div class="grid g3">{eats.map(({ b, r }) => <a class="card pad" href={href(b)} style="text-decoration:none">{r > 0 && <span class="tag">{r} out of 5</span>}<h4 style="margin:12px 0 4px">{b.name}</h4><p class="meta">{category(b)}</p></a>)}</div></div></section>}
</Base>
