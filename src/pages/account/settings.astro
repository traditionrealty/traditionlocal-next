---
import Base from '../../layouts/Base.astro';
import Prefs from '../../components/Prefs.astro';
import '../../styles/pages.css';
import { businesses, profiles, href, url, isClosed, apartmentCommunities, developments } from '../../lib/data';
import { areaPages, category, isFood } from '../../lib/helpers';
import ComboKit from '../../components/ComboKit.astro';
import AuthClient from '../../components/AuthClient.astro';
import { config } from '../../config';
const areas = areaPages().map((p) => p.name).sort();
const index = businesses().filter(isFood).map((b) => ({ s: b.slug, n: b.name, a: b.area, c: category(b), u: href(b), x: isClosed(b) ? 1 : 0 }))
  .concat(profiles.filter((p) => p.type === 'Place' && !isClosed(p)).map((p) => ({ s: 'p:' + p.slug, n: p.name, a: p.area, c: p.subCategory || 'Place', u: href(p), x: 0 })))
  .concat(areaPages().map((p) => ({ s: 'n:' + p.slug, n: p.name, a: '', c: p.region ? 'Neighborhood, ' + p.region : 'Neighborhood', u: href(p), x: 0 })))
  .concat(apartmentCommunities.map((a) => ({ s: 'a:' + a.slug, n: a.name, a: a.area, c: 'Apartment', u: url('/apartments/' + a.slug), x: 0 })))
  .concat(developments.map((d) => ({ s: 'd:' + d.slug, n: d.name, a: d.area || d.city, c: 'New development', u: url('/developments/' + d.slug), x: 0 })));
const topics = [['food', 'Food and drink'], ['things', 'Things to do'], ['openings', 'New openings'], ['homes', 'Neighborhoods and homes']];
---
<Base title="Account Settings" description="Your picks, areas, newsletters, and account details." noindex>
<div class="st-page">
<section class="st-hero"><div class="st-wrap">
<a class="st-back" href={url('/account')}>Back to your account home</a>
<h1>Settings</h1>
<p class="st-note" id="sync-note">Your area, followed areas, and saved places stay on this device until you sign in.</p>
</div></section>

<div class="st-wrap st-grid">
<nav class="st-nav" aria-label="Settings sections"><a href="#locally">Locally Plus</a><a href="#areas">Places you follow</a><a href="#loop">Email and newsletters</a><a href="#saved">Saved places</a><a href="#member">Account</a><a href="#privacy">Privacy and data</a></nav>
<div class="st-stack">

<section class="st-card" id="locally"><div class="st-head"><div><p class="st-eye">Locally Plus</p><h2>Shape your picks</h2><p class="st-sub">These choices decide what appears in Your Locally Plus on your account home.</p></div><button class="st-sw" id="l-on" type="button" role="switch" aria-checked="false" aria-label="Locally Plus"></button></div>
<div class="st-block"><h3>What to include</h3><div class="chips" id="l-topics">{topics.map(([k, l]) => <button class="chip" data-k={k} aria-pressed="false">{l}</button>)}</div></div>
<div class="st-block"><h3>How often</h3><div class="chips" id="l-freq"><button class="chip" data-f="twice" aria-pressed="false">Twice a month</button><button class="chip" data-f="monthly" aria-pressed="false">Monthly</button></div></div>
<div class="st-foot"><p class="st-meta">We save these now. Locally Plus emails have not started yet.</p><a class="btn line sm" href={url('/locally')}>See your picks</a></div></section>

<section class="st-card" id="areas"><div class="st-head"><div><p class="st-eye">Places you follow</p><h2>Home and followed areas</h2><p class="st-sub">Home opens Food on your area first. Followed areas add more picks.</p></div></div>
<div class="st-block"><h3>Home</h3><div class="st-narrow"><label class="sr" for="a-home">Your home area</label><select id="a-home" data-combo><option value="">Choose an area</option>{areas.map((a) => <option>{a}</option>)}<option value="__other">Other (type your area or ZIP code)</option></select></div>
<div id="a-other-wrap" hidden class="st-narrow" style="margin-top:12px"><label for="a-other">Your area or ZIP code</label><input id="a-other" type="text" placeholder="Try Cypress or 77449" /></div></div>
<div class="st-block"><h3>Following</h3><div class="chips" id="a-follow"></div>
<div class="st-add"><div class="st-grow"><label class="sr" for="a-add">Follow another area</label><select id="a-add" data-combo><option value="">Follow another area</option>{areas.map((a) => <option>{a}</option>)}</select></div><button class="btn line sm" id="a-add-btn" type="button">Follow</button></div></div></section>

<section class="st-card" id="loop"><div class="st-head"><div><p class="st-eye">Email and newsletters</p><h2>In the Loop</h2><p class="st-sub">Every Monday, the same for everyone. Food we trust, what is happening, and what just opened.</p></div></div>
<form action={config.newsletterAction} method="post" class="st-add">
<div class="st-grow"><label class="sr" for="loop-email">Your email</label><input id="loop-email" name="email" type="email" required placeholder="name@email.com" /></div>
<input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" id="loop-return" />
<button class="btn" type="submit">Join In the Loop</button>
</form>
<div class="st-foot"><p class="st-meta">Locally Plus is separate. Turn it on and choose topics above.</p><a class="st-link" href={url('/newsletters#past-issues')}>Past issues</a></div></section>

<section class="st-card" id="saved"><div class="st-head"><div><p class="st-eye">Saved places</p><h2>Your list</h2></div></div>
<div id="s-list"></div>
<div class="st-foot"><button class="btn line sm" id="s-mail" type="button">Email my list</button><a class="st-link" href={url('/food')}>Find more places</a></div></section>

<section class="st-card" id="member"><div class="st-head"><div><p class="st-eye">Account</p><h2>Your details</h2></div></div>
<div id="m-out"><p class="st-sub" style="margin-bottom:16px">Create a free account to keep your name and details with us. You sign in with your email and a password.</p>
<div class="st-row"><a class="btn" href={url('/sign-in#create')}>Create an account</a><a class="btn line" href={url('/sign-in')}>Sign in</a></div></div>
<div id="m-in" hidden>
<p class="st-sub" style="margin-bottom:16px">Signed in as <b id="m-email"></b>.</p>
<form id="m-form" class="st-form">
<div class="st-two"><div><label for="m-first">First name</label><input id="m-first" type="text" autocomplete="given-name" required /></div><div><label for="m-last">Last name</label><input id="m-last" type="text" autocomplete="family-name" /></div></div>
<div><label for="m-phone">Phone (optional)</label><input id="m-phone" type="tel" autocomplete="tel" /></div>
<div><button class="btn" type="submit">Save my details</button></div>
</form>
<div class="si-note" id="m-note" role="status" aria-live="polite" hidden></div>
<details class="st-pw"><summary>Change your password</summary>
<form id="m-pw" class="st-form" style="margin-top:14px">
<div><label for="m-p1">New password</label><input id="m-p1" type="password" autocomplete="new-password" minlength="8" required /></div>
<div><label for="m-p2">Type it again</label><input id="m-p2" type="password" autocomplete="new-password" minlength="8" required /></div>
<div><button class="btn line" type="submit">Update password</button></div>
</form>
<div class="si-note" id="m-pwnote" role="status" aria-live="polite" hidden></div></details>
<div class="st-foot"><button class="btn line sm" type="button" id="m-out-btn">Sign out</button></div>
</div></section>

<section class="st-card" id="privacy"><div class="st-head"><div><p class="st-eye">Privacy and data</p><h2>You are in control</h2><p class="st-sub">We never sell your email, and you can leave at any time.</p></div></div>
<div class="st-prow"><div><b>Download what is saved on this device</b><span>Your area, followed areas, Locally Plus choices, and saved places, as a file.</span></div><button class="btn line sm" id="p-download" type="button">Download</button></div>
<div class="st-prow"><div><b>Clear what is saved on this device</b><span>Your area, followed areas, Locally Plus choices, and saved places.</span></div><button class="btn line sm" id="p-clear" type="button">Clear</button></div></section>

</div>
</div>
</div>
<Prefs />
<script is:inline define:vars={{ INDEX: index }}>
var TLD = window.TL, $ = function (id) { return document.getElementById(id); };
function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
$('loop-return').value = location.origin + location.pathname;
var home = $('a-home'), other = $('a-other');
function initHome() { var v = TLD.area(), opts = [].map.call(home.options, function (o) { return o.value; });
if (!v) home.value = ''; else if (opts.indexOf(v) > -1) home.value = v; else { home.value = '__other'; other.value = v; } $('a-other-wrap').hidden = home.value !== '__other'; }
function follows() { var f = TLD.follows(); $('a-follow').innerHTML = f.length ? f.map(function (a) { return '<button class="chip on" data-a="' + esc(a) + '" title="Unfollow">' + esc(a) + ' &times;</button>'; }).join('') : '<span class="st-meta">You are not following any areas yet.</span>'; }
home.addEventListener('change', function () { if (home.value === '__other') { $('a-other-wrap').hidden = false; TLD.setArea(other.value.trim()); } else { $('a-other-wrap').hidden = true; TLD.setArea(home.value); } });
other.addEventListener('input', function () { TLD.setArea(other.value.trim()); });
$('a-follow').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; var f = TLD.follows().filter(function (x) { return x !== b.dataset.a; }); TLD.setFollows(f); follows(); });
$('a-add-btn').addEventListener('click', function () { var v = $('a-add').value; if (!v) return; var f = TLD.follows(); if (f.indexOf(v) < 0) f.push(v); TLD.setFollows(f); $('a-add').value = ''; follows(); });
var pref = TLD.get('tl_locally', { on: true, topics: { food: true, things: true, openings: false, homes: true }, freq: 'twice' });
function savePref() { TLD.set('tl_locally', pref); }
function drawLocally() { var on = $('l-on'); on.setAttribute('aria-checked', pref.on ? 'true' : 'false'); on.title = pref.on ? 'Locally Plus is on' : 'Locally Plus is off';
document.querySelectorAll('#l-topics button').forEach(function (b) { var v = !!pref.topics[b.dataset.k]; b.classList.toggle('on', v); b.setAttribute('aria-pressed', v); });
document.querySelectorAll('#l-freq button').forEach(function (b) { var v = pref.freq === b.dataset.f; b.classList.toggle('on', v); b.setAttribute('aria-pressed', v); }); }
$('l-on').addEventListener('click', function () { pref.on = !pref.on; savePref(); drawLocally(); });
$('l-topics').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; pref.topics[b.dataset.k] = !pref.topics[b.dataset.k]; savePref(); drawLocally(); });
$('l-freq').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; pref.freq = b.dataset.f; savePref(); drawLocally(); });
function saved() { var s = TLD.saved(), box = $('s-list'); var rows = s.map(function (slug) { return INDEX.filter(function (x) { return x.s === slug; })[0]; }).filter(Boolean);
box.innerHTML = rows.length ? rows.map(function (x) { return '<div class="st-srow"><div><a href="' + esc(x.u) + '">' + esc(x.n) + '</a>' + (x.x ? ' <span class="tag closed">Closed</span>' : '') + '<span>' + esc([x.c, x.a].filter(Boolean).join(', ')) + '</span></div><button class="btn line sm" data-slug="' + esc(x.s) + '" type="button">Remove</button></div>'; }).join('') : '<p class="st-meta" style="margin:0 0 4px">Nothing saved yet. Tap the heart on any place to add it here.</p>'; }
$('s-list').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; TLD.toggleSaved(b.dataset.slug); saved(); });
$('p-clear').addEventListener('click', function () {
var inn = TLD.signedIn && TLD.signedIn();
if (!confirm(inn ? 'Clear your saved places, followed areas, and home area from this device and from your account?' : 'Clear your saved choices on this device?')) return;
['tl_area', 'tl_follows', 'tl_saved', 'tl_locally'].forEach(function (k) { try { localStorage.removeItem(k); } catch (e) {} });
if (inn && TLD.pushNow) TLD.pushNow(function () { location.reload(); }); else location.reload();
});
$('s-mail').addEventListener('click', function () {
var s = TLD.saved(), rows = s.map(function (slug) { return INDEX.filter(function (x) { return x.s === slug; })[0]; }).filter(Boolean);
if (!rows.length) { alert('Nothing saved yet.'); return; }
var body = rows.map(function (x) { return x.n + (x.a ? ' (' + x.a + ')' : '') + ': ' + location.origin + x.u; }).join('\n');
location.href = 'mailto:?subject=' + encodeURIComponent('My saved places from Tradition Local') + '&body=' + encodeURIComponent(body);
});
$('p-download').addEventListener('click', function () {
var data = {}; ['tl_area', 'tl_follows', 'tl_saved', 'tl_locally'].forEach(function (k) { try { var v = localStorage.getItem(k); if (v) data[k.replace('tl_', '')] = JSON.parse(v); } catch (e) {} });
var blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }), link = document.createElement('a');
link.href = URL.createObjectURL(blob); link.download = 'tradition-local-my-data.json'; link.click();
});
document.addEventListener('tl:synced', function () { var n = $('sync-note'); if (n) n.textContent = 'Your area, followed areas, and saved places are kept with your account, so they follow you to your other devices.'; });
document.addEventListener('tl:pulled', function () { initHome(); follows(); saved(); drawLocally(); });
initHome(); follows(); drawLocally(); saved();
if (TLD.sync) TLD.sync(true);
</script>
<style is:global>
.si-note { margin-top: 18px; padding: 14px 16px; border-radius: 12px; font-size: 16px; line-height: 1.5; max-width: 460px; }
.si-note.ok { background: #e8f4ec; border: 1px solid #bcd9c5; color: #1d4d2b; }
.si-note.err { background: #fdecea; border: 1px solid #f0c4be; color: #7a1f14; }
.st-page { background: #FAF7F0; }
.st-wrap { max-width: 1120px; margin: 0 auto; padding: 0 40px; }
.st-hero { background: #1D1A6D; color: #fff; padding: 26px 0 84px; }
.st-hero h1 { color: #fff; margin: 14px 0 0; font-size: 40px; line-height: 1.1; }
.st-back { color: #dcdaf5; font-size: 14px; font-weight: 700; text-decoration: underline; }
.st-back:hover { color: #fff; }
.st-note { margin: 10px 0 0; font-size: 14px; color: #dcdaf5; max-width: 640px; }
.st-grid { display: flex; flex-wrap: wrap; gap: 28px; align-items: flex-start; margin-top: -52px; padding-bottom: 80px; position: relative; }
.st-nav { flex: 0 0 240px; background: #fff; border: 1px solid #e3dcc9; border-radius: 20px; padding: 10px; display: flex; flex-direction: column; box-shadow: 0 12px 28px rgba(29,26,109,.10); position: sticky; top: 90px; }
.st-nav a { padding: 12px 14px; border-radius: 12px; font-size: 15px; font-weight: 700; color: #1D1A6D; text-decoration: none; }
.st-nav a:hover { background: #FAF7F0; }
.st-stack { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
.st-card { background: #fff; border: 1px solid #e3dcc9; border-radius: 22px; padding: 28px 30px; box-shadow: 0 8px 22px rgba(29,26,109,.06); scroll-margin-top: 100px; }
.st-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 18px; }
.st-eye { margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #2E7D4F; }
.st-card h2 { margin: 0; font-size: 28px; line-height: 1.15; }
.st-sub { margin: 8px 0 0; font-size: 15px; color: #4a4870; max-width: 560px; }
.st-block { border-top: 1px solid #efe9d8; padding-top: 18px; margin-top: 18px; }
.st-block h3 { margin: 0 0 10px; font-size: 16px; font-family: 'DM Sans', sans-serif; }
.st-narrow { max-width: 380px; }
.st-add { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; max-width: 560px; align-items: center; }
.st-grow { flex: 1; min-width: 220px; }
.st-foot { border-top: 1px solid #efe9d8; margin-top: 20px; padding-top: 18px; display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.st-meta { margin: 0; font-size: 14px; color: #4a4870; }
.st-link { font-size: 14px; font-weight: 700; }
.st-row { display: flex; gap: 12px; flex-wrap: wrap; }
.st-form { display: grid; gap: 14px; max-width: 460px; }
.st-two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.st-pw { margin-top: 24px; border-top: 1px solid #efe9d8; padding-top: 18px; }
.st-pw summary { cursor: pointer; font-weight: 700; font-size: 15px; color: #004AAD; }
.st-srow { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 13px 0; border-bottom: 1px solid #efe9d8; }
.st-srow:last-child { border-bottom: 0; }
.st-srow a { font-size: 17px; font-weight: 700; text-decoration: none; display: block; }
.st-srow span { font-size: 14px; color: #4a4870; }
.st-prow { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding: 16px 0; border-top: 1px solid #efe9d8; }
.st-prow b { display: block; font-size: 15px; }
.st-prow span { font-size: 14px; color: #4a4870; }
.st-sw { flex: none; width: 52px; height: 30px; border-radius: 999px; border: 0; background: #cfc8b4; position: relative; cursor: pointer; padding: 0; transition: background .15s; }
.st-sw::after { content: ''; position: absolute; top: 3px; left: 3px; width: 24px; height: 24px; border-radius: 50%; background: #fff; transition: left .15s; box-shadow: 0 1px 2px rgba(0,0,0,.2); }
.st-sw[aria-checked="true"] { background: #2E7D4F; }
.st-sw[aria-checked="true"]::after { left: 25px; }
@media (max-width: 720px) {
  .st-wrap { padding: 0 14px; }
  .st-hero { padding: 18px 0 70px; }
  .st-hero .st-wrap { padding: 0 18px; }
  .st-hero h1 { font-size: 30px; }
  .st-grid { margin-top: -44px; gap: 14px; padding-bottom: 40px; }
  .st-nav { position: static; flex: 1 1 100%; flex-direction: row; overflow-x: auto; gap: 4px; padding: 8px; border-radius: 16px; }
  .st-nav a { white-space: nowrap; padding: 10px 14px; }
  .st-card { border-radius: 20px; padding: 20px 18px; }
  .st-card h2 { font-size: 24px; }
  .st-two { grid-template-columns: 1fr; }
}
</style>
<AuthClient />
<script is:inline>
(function () {
var A = window.TLAuth, c = A && A.client(); if (!c) return;
var $ = function (i) { return document.getElementById(i); }, cur = null, hasRow = false, shown = '';
function say(id, t, k) { var n = $(id); n.textContent = t || ''; n.className = 'si-note' + (k ? ' ' + k : ''); n.hidden = !t; }
function view(user) {
cur = user; $('m-out').hidden = !!user; $('m-in').hidden = !user; if (!user) { shown = ''; return; }
$('m-email').textContent = user.email || ''; if (shown === user.id) return; shown = user.id;
var meta = user.user_metadata || {};
c.from('profiles').select('first_name,last_name,phone,area_of_interest').eq('id', user.id).maybeSingle().then(function (r) {
var p = (r && r.data) || {}; hasRow = !!(r && r.data);
$('m-first').value = p.first_name || meta.first_name || ''; $('m-last').value = p.last_name || meta.last_name || '';
$('m-phone').value = p.phone || '';
});
}
c.auth.getSession().then(function (r) { var s = r && r.data && r.data.session; view(s ? s.user : null); });
c.auth.onAuthStateChange(function (ev, s) { if (ev === 'SIGNED_OUT') view(null); else if (s && s.user && (ev === 'SIGNED_IN' || ev === 'USER_UPDATED')) view(s.user); });
$('m-form').addEventListener('submit', function (e) {
e.preventDefault(); if (!cur) return; say('m-note', '');
var area = window.TL && window.TL.area ? window.TL.area() : '';
var row = { first_name: $('m-first').value.trim(), last_name: $('m-last').value.trim(), phone: $('m-phone').value.trim(), area_of_interest: area && area !== '__other' ? area : '' };
if (!row.first_name) { say('m-note', 'Please tell us your first name.', 'err'); return; }
if (row.phone && !/^[0-9 +().-]{7,20}$/.test(row.phone)) { say('m-note', 'That phone number does not look right. Use numbers only, or leave it blank.', 'err'); return; }
var q = hasRow ? c.from('profiles').update(row).eq('id', cur.id) : c.from('profiles').insert(Object.assign({ id: cur.id, email: cur.email }, row));
q.then(function (r) {
if (r && r.error) { say('m-note', 'We could not save that. Please try again.', 'err'); return; }
hasRow = true; say('m-note', 'Saved.', 'ok'); c.auth.updateUser({ data: { first_name: row.first_name, last_name: row.last_name, area_of_interest: row.area_of_interest } });
});
});
$('m-pw').addEventListener('submit', function (e) {
e.preventDefault(); var p1 = $('m-p1').value, p2 = $('m-p2').value; say('m-pwnote', '');
if (p1.length < 8) { say('m-pwnote', 'Please use at least 8 characters.', 'err'); return; }
if (p1 !== p2) { say('m-pwnote', 'The two passwords do not match.', 'err'); return; }
c.auth.updateUser({ password: p1 }).then(function (r) {
if (r && r.error) { say('m-pwnote', A.friendly(r.error), 'err'); return; }
$('m-p1').value = ''; $('m-p2').value = ''; say('m-pwnote', 'Your password is updated.', 'ok');
});
});
$('m-out-btn').addEventListener('click', function () { c.auth.signOut().then(function () { A.go(A.paths.home); }); });
})();
</script>
<ComboKit />
</Base>
