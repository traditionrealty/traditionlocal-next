---
import Base from '../layouts/Base.astro';
import Prefs from '../components/Prefs.astro';
import '../styles/pages.css';
import { businesses, profiles, href, url, isClosed } from '../lib/data';
import { areaPages, bizIn, topRating, category, isFood } from '../lib/helpers';
import ComboKit from '../components/ComboKit.astro';
import AuthClient from '../components/AuthClient.astro';
import { config } from '../config';
const areas = areaPages().map((p) => p.name).sort();
const index = businesses().filter(isFood).map((b) => ({ s: b.slug, n: b.name, a: b.area, c: category(b), r: topRating(b.name), u: href(b), x: isClosed(b) ? 1 : 0 }))
  .concat(profiles.filter((p) => p.type === 'Place' && !isClosed(p)).map((p) => ({ s: 'p:' + p.slug, n: p.name, a: p.area, c: p.subCategory || 'Place', r: 0, u: href(p) })))
  .concat(areaPages().map((p) => ({ s: 'n:' + p.slug, n: p.name, a: '', c: p.region ? 'Neighborhood, ' + p.region : 'Neighborhood', r: 0, u: href(p), x: 0 })));
const topics = [['food', 'Food and drink'], ['things', 'Things to do'], ['openings', 'New openings'], ['homes', 'Neighborhoods and homes']];
---
<Base title="Your Account" description="Your area, the places you follow, and what you receive." noindex>
  <section class="band hero"><div class="wrap"><p class="eyebrow">Your account</p><h1 style="margin-bottom:12px">Account and Settings</h1><p class="lead">Choose your area, follow the places you care about, and decide what you receive.</p>
    <p class="meta" style="margin-top:16px">Your area and saved places stay on this device. Your name and details are kept with your account when you sign in.</p></div></section>
  <section class="band">
    <div class="wrap" style="display:flex;flex-wrap:wrap;gap:56px;align-items:flex-start">
      <nav aria-label="Account sections" style="flex:0 0 240px"><a class="menu" href="#member">Your details</a><a class="menu" href="#areas">Your areas</a><a class="menu" href="#locally">Locally Plus</a><a class="menu" href="#loop">In the Loop</a><a class="menu" href="#saved">Saved places</a><a class="menu" href="#privacy">Privacy and data</a></nav>
      <div class="stack" style="flex:999 1 560px;min-width:0">

        <div class="panel" id="member"><p class="eyebrow">Your details</p><h2 style="font-size:32px;margin-bottom:8px">Your Tradition Local Account</h2>
          <div id="m-out"><p class="meta" style="font-size:16px;margin-bottom:20px">Create a free account to keep your name and details with us. You sign in with your email and a password.</p>
            <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/sign-in#create')}>Create an account</a><a class="btn line" href={url('/sign-in')}>Sign in</a></div></div>
          <div id="m-in" hidden>
            <p class="meta" style="font-size:16px;margin-bottom:20px">You are signed in as <b id="m-email"></b>.</p>
            <form id="m-form" style="display:grid;gap:14px;max-width:460px">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div><label for="m-first">First name</label><input id="m-first" type="text" autocomplete="given-name" required /></div><div><label for="m-last">Last name</label><input id="m-last" type="text" autocomplete="family-name" /></div></div>
              <div><label for="m-phone">Phone (optional)</label><input id="m-phone" type="tel" autocomplete="tel" /></div>
              <div><label for="m-area">Area you are most interested in</label><select id="m-area"><option value="">Choose an area</option>{areas.map((a) => <option>{a}</option>)}</select></div>
              <div><button class="btn" type="submit">Save my details</button></div>
            </form>
            <div class="si-note" id="m-note" role="status" aria-live="polite" hidden></div>
            <p style="font-size:13px;font-weight:700;margin:32px 0 10px">Change your password</p>
            <form id="m-pw" style="display:grid;gap:14px;max-width:460px">
              <div><label for="m-p1">New password</label><input id="m-p1" type="password" autocomplete="new-password" minlength="8" required /></div>
              <div><label for="m-p2">Type it again</label><input id="m-p2" type="password" autocomplete="new-password" minlength="8" required /></div>
              <div><button class="btn line" type="submit">Update password</button></div>
            </form>
            <div class="si-note" id="m-pwnote" role="status" aria-live="polite" hidden></div>
            <p style="margin-top:28px"><button class="btn line sm" type="button" id="m-out-btn">Sign out</button></p>
          </div>
        </div>

        <div class="panel" id="areas"><p class="eyebrow">Your areas</p><h2 style="font-size:32px;margin-bottom:8px">Where Do You Call Home?</h2>
          <p class="meta" style="font-size:16px;margin-bottom:20px">We use this for your local picks and to open Food on your area first.</p>
          <div style="max-width:380px"><label for="a-home">Your area</label><select id="a-home" data-combo><option value="">Choose an area</option>{areas.map((a) => <option>{a}</option>)}<option value="__other">Other (type your area or ZIP code)</option></select></div>
          <div id="a-other-wrap" hidden style="max-width:380px;margin-top:12px"><label for="a-other">Your area or ZIP code</label><input id="a-other" type="text" placeholder="Try Cypress or 77449" /></div>
          <p style="font-size:13px;font-weight:700;margin:28px 0 10px">Areas you follow</p>
          <div class="chips" id="a-follow"></div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;max-width:520px"><div style="flex:1;min-width:220px"><label class="sr" for="a-add">Follow another area</label><select id="a-add" data-combo><option value="">Follow another area</option>{areas.map((a) => <option>{a}</option>)}</select></div><button class="btn line sm" id="a-add-btn" type="button">Follow</button></div>
          <div id="a-picks" style="margin-top:28px;padding:20px;border-radius:12px;background:var(--ivory)" hidden><p class="eyebrow" id="a-picks-h" style="margin-bottom:8px"></p><div id="a-picks-list"></div></div>
        </div>

        <div class="panel" id="locally"><p class="eyebrow">Locally Plus</p><h2 style="font-size:32px;margin-bottom:8px">Your Neighborhood, in Your Inbox</h2>
          <p class="meta" style="font-size:16px;margin-bottom:20px">Locally Plus is a closer look at where you live, written for your area and the areas you follow. Separate from In the Loop.</p>
          <div style="margin-bottom:24px"><button class="chip" id="l-on" aria-pressed="false">Locally Plus is on</button></div>
          <p style="font-size:13px;font-weight:700;margin-bottom:10px">What to include</p>
          <div class="chips" id="l-topics">{topics.map(([k, l]) => <button class="chip" data-k={k} aria-pressed="false">{l}</button>)}</div>
          <p style="font-size:13px;font-weight:700;margin:24px 0 10px">How often</p>
          <div class="chips" id="l-freq"><button class="chip" data-f="twice" aria-pressed="false">Twice a month</button><button class="chip" data-f="monthly" aria-pressed="false">Monthly</button></div>
          <p class="meta" style="margin:20px 0 16px">We save these now. Locally Plus emails have not started yet.</p>
          <a class="btn line sm" href={url('/locally')}>Open your Locally Plus page</a>
        </div>

        <div class="panel" id="loop"><p class="eyebrow">In the Loop</p><h2 style="font-size:32px;margin-bottom:8px">Every Monday, the Same for Everyone</h2>
          <p class="meta" style="font-size:16px;margin-bottom:20px">Food we trust, what is happening, and what just opened. It is not tailored to your area.</p>
          <form action={config.newsletterAction} method="post" style="display:flex;gap:10px;flex-wrap:wrap;max-width:560px">
            <div style="flex:1;min-width:240px"><label class="sr" for="loop-email">Your email</label><input id="loop-email" name="email" type="email" required placeholder="name@email.com" /></div>
            <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><input type="hidden" name="return" id="loop-return" />
            <button class="btn" type="submit">Join In the Loop</button>
          </form>
        </div>

        <div class="panel" id="saved"><p class="eyebrow">Saved places</p><h2 style="font-size:32px;margin-bottom:8px">Your List</h2>
          <p class="meta" style="font-size:16px;margin-bottom:12px">Places you saved on Food, ready whenever you are.</p>
          <div id="s-list"></div><div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:16px"><button class="btn line sm" id="s-mail" type="button">Email my list</button><a href={url('/food')} style="font-weight:700">Find more places</a></div></div>

        <div class="panel" id="privacy"><p class="eyebrow">Privacy and data</p><h2 style="font-size:32px;margin-bottom:8px">You Are in Control</h2>
          <p class="meta" style="font-size:16px;margin-bottom:12px">We never sell your email, and you can leave at any time.</p>
          <div class="row"><div style="flex:1;min-width:240px"><b>Download what is saved on this device</b><br /><span class="meta">Your area, followed areas, Locally Plus choices, and saved places, as a file.</span></div><button class="btn line sm" id="p-download" type="button">Download</button></div>
          <div class="row"><div style="flex:1;min-width:240px"><b>Clear what is saved on this device</b><br /><span class="meta">Your area, followed areas, Locally Plus choices, and saved places.</span></div><button class="btn line sm" id="p-clear" type="button">Clear</button></div></div>
      </div>
    </div>
  </section>
  <Prefs />
  <script is:inline define:vars={{ INDEX: index }}>
    var TLD = window.TL, $ = function (id) { return document.getElementById(id); };
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
    $('loop-return').value = location.origin + location.pathname;
    var home = $('a-home'), other = $('a-other');
    function areaName() { var v = TLD.area(); return v; }
    function initHome() { var v = TLD.area(), opts = [].map.call(home.options, function (o) { return o.value; });
      if (!v) home.value = ''; else if (opts.indexOf(v) > -1) home.value = v; else { home.value = '__other'; other.value = v; } $('a-other-wrap').hidden = home.value !== '__other'; }
    function picks() { var a = TLD.area(), box = $('a-picks'); if (!a || a === '__other') { box.hidden = true; return; }
      var list = INDEX.filter(function (x) { return x.a === a && x.s.indexOf('p:') !== 0 && !x.x; }).sort(function (x, y) { return y.r - x.r; }).slice(0, 3); box.hidden = !list.length; if (!list.length) return;
      $('a-picks-h').textContent = 'Local picks for ' + a;
      $('a-picks-list').innerHTML = list.map(function (x) { return '<div class="row" style="border-top:1px solid var(--line)"><b style="flex:1"><a href="' + esc(x.u) + '">' + esc(x.n) + '</a></b><span class="meta">' + esc(x.c) + (x.r ? ', ' + x.r + ' out of 5' : '') + '</span></div>'; }).join(''); }
    function follows() { var f = TLD.follows(); $('a-follow').innerHTML = f.length ? f.map(function (a) { return '<button class="chip on" data-a="' + esc(a) + '" title="Unfollow">' + esc(a) + ' &times;</button>'; }).join('') : '<span class="meta">You are not following any areas yet.</span>'; }
    home.addEventListener('change', function () { if (home.value === '__other') { $('a-other-wrap').hidden = false; TLD.setArea(other.value.trim()); } else { $('a-other-wrap').hidden = true; TLD.setArea(home.value); } picks(); });
    other.addEventListener('input', function () { TLD.setArea(other.value.trim()); picks(); });
    $('a-follow').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; var f = TLD.follows().filter(function (x) { return x !== b.dataset.a; }); TLD.setFollows(f); follows(); });
    $('a-add-btn').addEventListener('click', function () { var v = $('a-add').value; if (!v) return; var f = TLD.follows(); if (f.indexOf(v) < 0) f.push(v); TLD.setFollows(f); $('a-add').value = ''; follows(); });
    var pref = TLD.get('tl_locally', { on: true, topics: { food: true, things: true, openings: false, homes: true }, freq: 'twice' });
    function savePref() { TLD.set('tl_locally', pref); }
    function drawLocally() { var on = $('l-on'); on.classList.toggle('on', pref.on); on.setAttribute('aria-pressed', pref.on); on.textContent = pref.on ? 'Locally Plus is on' : 'Locally Plus is off';
      document.querySelectorAll('#l-topics button').forEach(function (b) { var v = !!pref.topics[b.dataset.k]; b.classList.toggle('on', v); b.setAttribute('aria-pressed', v); });
      document.querySelectorAll('#l-freq button').forEach(function (b) { var v = pref.freq === b.dataset.f; b.classList.toggle('on', v); b.setAttribute('aria-pressed', v); }); }
    $('l-on').addEventListener('click', function () { pref.on = !pref.on; savePref(); drawLocally(); });
    $('l-topics').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; pref.topics[b.dataset.k] = !pref.topics[b.dataset.k]; savePref(); drawLocally(); });
    $('l-freq').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; pref.freq = b.dataset.f; savePref(); drawLocally(); });
    function saved() { var s = TLD.saved(), box = $('s-list'); var rows = s.map(function (slug) { return INDEX.filter(function (x) { return x.s === slug; })[0]; }).filter(Boolean);
      box.innerHTML = rows.length ? rows.map(function (x) { return '<div class="row"><div style="flex:1;min-width:220px"><a href="' + esc(x.u) + '" style="font-size:18px;font-weight:700">' + esc(x.n) + '</a>' + (x.x ? ' <span class="tag closed">Closed</span>' : '') + '<br><span class="meta">' + esc([x.c, x.a].filter(Boolean).join(', ')) + '</span></div><button class="btn line sm" data-slug="' + esc(x.s) + '" type="button">Remove</button></div>'; }).join('') : '<div class="row"><span class="meta">Nothing saved yet. Tap the heart on any place to add it here.</span></div>'; }
    $('s-list').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; TLD.toggleSaved(b.dataset.slug); saved(); });
    $('p-clear').addEventListener('click', function () { if (!confirm('Clear your saved choices on this device?')) return; ['tl_area', 'tl_follows', 'tl_saved', 'tl_locally'].forEach(function (k) { try { localStorage.removeItem(k); } catch (e) {} }); location.reload(); });
    $('s-mail').addEventListener('click', function () {
      var s = TLD.saved(), rows = s.map(function (slug) { return INDEX.filter(function (x) { return x.s === slug; })[0]; }).filter(Boolean);
      if (!rows.length) { alert('Nothing saved yet.'); return; }
      var body = rows.map(function (x) { return x.n + (x.a ? ' (' + x.a + ')' : '') + ': ' + location.origin + x.u; }).join('\n');
      location.href = 'mailto:?subject=' + encodeURIComponent('My saved places from Tradition Local') + '&body=' + encodeURIComponent(body);
    });
    $('p-download').addEventListener('click', function () {
      var data = {}; ['tl_area', 'tl_follows', 'tl_saved', 'tl_locally'].forEach(function (k) { try { var v = localStorage.getItem(k); if (v) data[k.replace('tl_', '')] = JSON.parse(v); } catch (e) {} });
      var blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }), link = document.createElement('a');
      link.href = URL.createObjectURL(blob); link.download = 'tradition-local-my-data.json'; link.click();
    });
    initHome(); picks(); follows(); drawLocally(); saved();
  </script>
  <style>
    .si-note { margin-top: 18px; padding: 14px 16px; border-radius: 12px; font-size: 16px; line-height: 1.5; max-width: 460px; }
    .si-note.ok { background: #e8f4ec; border: 1px solid #bcd9c5; color: #1d4d2b; }
    .si-note.err { background: #fdecea; border: 1px solid #f0c4be; color: #7a1f14; }
  </style>
  <AuthClient />
  <script is:inline>
    (function () {
      var A = window.TLAuth, c = A && A.client(); if (!c) return;
      var $ = function (i) { return document.getElementById(i); }, cur = null, hasRow = false, shown = '';
      function say(id, t, k) { var n = $(id); n.textContent = t || ''; n.className = 'si-note' + (k ? ' ' + k : ''); n.hidden = !t; }
      function view(user) {
        cur = user; $('m-out').hidden = !!user; $('m-in').hidden = !user; if (!user) { shown = ''; return; }
        $('m-email').textContent = user.email || ''; if (shown === user.id) return; shown = user.id;
        var meta = user.user_metadata || {};
        c.from('profiles').select('first_name,last_name,phone,area_of_interest').eq('id', user.id).maybeSingle().then(function (r) {
          var p = (r && r.data) || {}; hasRow = !!(r && r.data);
          $('m-first').value = p.first_name || meta.first_name || ''; $('m-last').value = p.last_name || meta.last_name || '';
          $('m-phone').value = p.phone || ''; $('m-area').value = p.area_of_interest || meta.area_of_interest || '';
        });
      }
      c.auth.getSession().then(function (r) { var s = r && r.data && r.data.session; view(s ? s.user : null); });
      c.auth.onAuthStateChange(function (ev, s) { if (ev === 'SIGNED_OUT') view(null); else if (s && s.user && (ev === 'SIGNED_IN' || ev === 'USER_UPDATED')) view(s.user); });
      $('m-form').addEventListener('submit', function (e) {
        e.preventDefault(); if (!cur) return; say('m-note', '');
        var row = { first_name: $('m-first').value.trim(), last_name: $('m-last').value.trim(), phone: $('m-phone').value.trim(), area_of_interest: $('m-area').value };
        if (!row.first_name) { say('m-note', 'Please tell us your first name.', 'err'); return; }
        if (row.phone && !/^[0-9 +().-]{7,20}$/.test(row.phone)) { say('m-note', 'That phone number does not look right. Use numbers only, or leave it blank.', 'err'); return; }
        var q = hasRow ? c.from('profiles').update(row).eq('id', cur.id) : c.from('profiles').insert(Object.assign({ id: cur.id, email: cur.email }, row));
        q.then(function (r) {
          if (r && r.error) { say('m-note', 'We could not save that. Please try again.', 'err'); return; }
          hasRow = true; say('m-note', 'Saved.', 'ok'); c.auth.updateUser({ data: { first_name: row.first_name, last_name: row.last_name, area_of_interest: row.area_of_interest } });
        });
      });
      $('m-pw').addEventListener('submit', function (e) {
        e.preventDefault(); var p1 = $('m-p1').value, p2 = $('m-p2').value; say('m-pwnote', '');
        if (p1.length < 8) { say('m-pwnote', 'Please use at least 8 characters.', 'err'); return; }
        if (p1 !== p2) { say('m-pwnote', 'The two passwords do not match.', 'err'); return; }
        c.auth.updateUser({ password: p1 }).then(function (r) {
          if (r && r.error) { say('m-pwnote', A.friendly(r.error), 'err'); return; }
          $('m-p1').value = ''; $('m-p2').value = ''; say('m-pwnote', 'Your password is updated.', 'ok');
        });
      });
      $('m-out-btn').addEventListener('click', function () { c.auth.signOut().then(function () { A.go(A.paths.home); }); });
    })();
  </script>
<ComboKit />
</Base>
