---
import Base from '../../layouts/Base.astro';
import '../../styles/pages.css';
import { href, media, url } from '../../lib/data';
import { stories, storyDate, topicName } from '../../lib/stories';
const all = stories();
const topics = [...new Set(all.flatMap((s) => s.tags))].sort((a, b) => all.filter((s) => s.tags.includes(b)).length - all.filter((s) => s.tags.includes(a)).length);
const SHOW = 12;
---
<Base title="Stories" active="" description="Reviews, neighborhood notes, and local finds from people who live here.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Read local</p>
      <h1 style="margin-bottom:12px">Stories from around town</h1>
      <p class="lead" style="margin-bottom:28px">Reviews, neighborhood notes, and local finds, written by people who live here.</p>
      <div class="card pad search"><label for="s-q">Search stories</label><input id="s-q" type="search" placeholder="Try coffee, Katy, or Heights" /></div>
      <div class="tabs" id="s-topics" style="margin-top:20px"><button class="chip on" data-t="" aria-pressed="true">All</button>{topics.map((t) => <button class="chip" data-t={t} aria-pressed="false">{topicName(t)}</button>)}</div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <p class="meta" id="s-count" style="margin-bottom:16px">{all.length} stories</p>
      <div class="grid g3" id="s-grid">
        {all.map((s) => { const m = media(s); return (
          <a class="card s-item" href={href(s)} data-topics={s.tags.join(' ')} data-text={`${s.title} ${s.summary}`.toLowerCase()} style="text-decoration:none">
            {m ? <img class="photo" style="height:190px" src={m.src} alt={m.alt || s.title} loading="lazy" /> : <div class="ph" style="height:190px">Tradition Local</div>}
            <div class="pad"><span class="tag">{topicName(s.tags[0] || 'Story')}</span><h4 style="margin:12px 0 6px">{s.title}</h4><p class="meta">{storyDate(s)}</p></div>
          </a>); })}
      </div>
      <div class="card pad hidden" id="s-empty"><b>No stories match yet.</b><p class="meta" style="margin-top:4px">Try another topic or search.</p></div>
      <p style="margin-top:28px;text-align:center"><button class="btn line" id="s-more" type="button">Show more stories</button></p>
    </div>
  </section>
  <script is:inline define:vars={{ SHOW }}>
    (function () {
      var items = [].slice.call(document.querySelectorAll('.s-item')), box = document.getElementById('s-q'), topic = '', limit = SHOW;
      function run() {
        var t = box.value.trim().toLowerCase(), n = 0, shown = 0;
        items.forEach(function (i) { var ok = (!topic || (' ' + i.dataset.topics + ' ').indexOf(' ' + topic + ' ') > -1) && (!t || i.dataset.text.indexOf(t) > -1); if (ok) n++; var show = ok && shown < limit; if (show) shown++; i.classList.toggle('hidden', !show); });
        document.getElementById('s-count').textContent = n + (n === 1 ? ' story' : ' stories');
        document.getElementById('s-empty').classList.toggle('hidden', n > 0);
        document.getElementById('s-more').parentNode.classList.toggle('hidden', shown >= n);
      }
      box.addEventListener('input', function () { limit = SHOW; run(); });
      document.getElementById('s-topics').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; topic = b.dataset.t; limit = SHOW; [].forEach.call(this.children, function (c) { c.classList.toggle('on', c === b); c.setAttribute('aria-pressed', c === b ? 'true' : 'false'); }); run(); });
      document.getElementById('s-more').addEventListener('click', function () { limit += SHOW; run(); });
      var pre = new URLSearchParams(location.search).get('topic'); if (pre) { var b = document.querySelector('#s-topics [data-t="' + pre + '"]'); if (b) b.click(); else run(); } else run();
    })();
  </script>
</Base>
