---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import FilterKit from '../components/FilterKit.astro';
import { profiles, href, url } from '../lib/data';
const WORDS = ['new construction', 'new build', 'new homes', 'newer homes', 'master planned', 'master-planned', 'new development', 'new neighborhoods', 'builder'];
const isNew = (p: any) => { const t = [p.summary, p.description, p.localTake, p.typicalHomes, p.bestFor].join(' ').toLowerCase(); return WORDS.some((w) => t.includes(w)); };
const list = profiles.filter((p) => ['Subdivision', 'Neighborhood', 'City', 'Area'].includes(p.type) && isNew(p)).sort((a, b) => a.name.localeCompare(b.name));
const areas = [...new Set(list.map((p) => (p.type === 'Subdivision' ? p.area : p.name)).filter(Boolean))].sort();
const tips = [
  ['Bring Your Realtor on Your First Visit', 'Many builders ask on day one whether you already have a Realtor, so it helps to have one before you walk in.'],
  ['Compare the Full Monthly Cost', 'Taxes, HOA dues, and special district fees can differ a lot between communities, even at the same price.'],
  ['Ask What Is Included', 'Find out which finishes are standard and which are upgrades, and get the answer in writing.'],
  ['Consider Your Own Inspection', 'A new home can still have issues. An independent inspection is worth thinking about.'],
];
---
<Base title="New Builds" active="More" sub="makeithome" description="Newer and master planned communities to compare around Houston.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">New builds</p>
      <h1 style="margin-bottom:16px;max-width:880px">Newer Communities to Compare.</h1>
      <p class="lead" style="margin-bottom:28px">Neighborhoods and communities that our guides describe as new construction or master planned. Start here, then ask Dillon what is open right now.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/ask-dillon')}>Ask Dillon about new builds</a><a class="btn line" href={url('/find-your-fit')}>Find your fit</a></div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Communities</p><h2 style="margin-bottom:16px">Where New Homes Are Being Built</h2>
      <div class="fbar" id="nb-bar">
        <div class="fbar-row">
          <div class="fbar-search"><label for="nb-q">Search</label><input id="nb-q" type="search" placeholder="Try a community or a city" autocomplete="off" /></div>
          <button class="chip fbar-toggle" type="button" aria-expanded="false" aria-controls="nb-panel">Filters <span class="fcount hidden" id="nb-badge"></span></button>
          <div class="fbar-panel" id="nb-panel"><div class="fsel"><label for="nb-area">Area</label><select id="nb-area"><option value="">All areas</option>{areas.map((a) => <option>{a}</option>)}</select></div></div>
        </div>
        <div class="fbar-status"><div class="fpills" id="nb-pills"></div><button class="flink hidden" id="nb-clear" type="button">Clear all</button><span class="meta" id="nb-count">{list.length} communities</span></div>
      </div>
      <div style="height:24px"></div>
      <div class="grid g3">
        {list.map((p, i) => (
          <a class={i < 24 ? 'card pad nb-item' : 'card pad nb-item hidden'} data-name={[p.name, p.type === 'Subdivision' ? p.area : p.region].join(' ').toLowerCase()} href={href(p)} data-area={p.type === 'Subdivision' ? p.area : p.name} style="text-decoration:none">
            <span class="tag">{p.type === 'Subdivision' ? 'Community' : 'Area'}</span>
            <h4 style="margin:12px 0 6px">{p.name}</h4>
            <p class="meta" style="margin-bottom:8px">{p.type === 'Subdivision' ? p.area : p.region}</p>
            <p class="meta" style="font-size:15px">{p.summary.length > 150 ? p.summary.slice(0, 150).replace(/\s+\S*$/, '') + '...' : p.summary}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><button class="btn line hidden" id="nb-more" type="button">Show more communities</button></p>
      <div class="card pad hidden" id="nb-empty"><b>No communities match that area yet.</b></div>
    </div>
  </section>
  <section class="band tint">
    <div class="wrap">
      <p class="eyebrow">Before you visit</p><h2 style="margin-bottom:28px">Buying New Construction</h2>
      <div class="grid g2">{tips.map(([t, d]) => <div class="card pad"><h4 style="margin-bottom:8px">{t}</h4><p class="meta" style="font-size:16px">{d}</p></div>)}</div>
    </div>
  </section>
  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
      <div style="max-width:700px"><h3 style="margin-bottom:8px">Curious About a Community?</h3><p style="font-size:17px">Dillon can tell you what is available and what to look for. Questions are always welcome.</p></div>
      <a class="btn" href={url('/ask-dillon')}>Ask Dillon</a>
    </div>
  </section>
  <FilterKit />
  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); }, area = $('nb-area');
      var kit = TLF.init({ bar: $('nb-bar'), items: [].slice.call(document.querySelectorAll('.nb-item')), search: $('nb-q'), step: 24, noun: ['community', 'communities'], count: $('nb-count'), empty: $('nb-empty'), more: $('nb-more'), clear: $('nb-clear'), pills: $('nb-pills'), badge: $('nb-badge'), filters: [TLF.select(area, 'area')] });
      area.addEventListener('change', kit.refresh);
    })();
  </script>
</Base>
