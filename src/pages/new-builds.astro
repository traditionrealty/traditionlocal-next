---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import FilterKit from '../components/FilterKit.astro';
import { profiles, developments, href, url } from '../lib/data';
const WORDS = ['new construction', 'new build', 'new homes', 'newer homes', 'master planned', 'master-planned', 'new development', 'new neighborhoods', 'builder'];
const isNew = (p: any) => { const t = [p.summary, p.description, p.localTake, p.typicalHomes, p.bestFor].join(' ').toLowerCase(); return WORDS.some((w) => t.includes(w)); };
const list = profiles.filter((p) => ['Subdivision', 'Neighborhood', 'City', 'Area'].includes(p.type) && isNew(p)).sort((a, b) => a.name.localeCompare(b.name));
const areas = [...new Set(list.map((p) => (p.type === 'Subdivision' ? p.area : p.name)).filter(Boolean))].sort();
const fmt = (n: number) => n.toLocaleString('en-US');
const rng = (a: number, b: number, f: (n: number) => string) => (!a && !b ? '' : a === b || !a || !b ? f(a || b) : f(a) + ' to ' + f(b));
const bedText = (d: any) => { const t = rng(d.bedsMin, d.bedsMax, (n) => String(n)); return t ? t + (d.bedsMax > 1 || d.bedsMin > 1 ? ' bedrooms' : ' bedroom') : ''; };
const sqftText = (d: any) => { const t = rng(d.sqftMin, d.sqftMax, fmt); return t ? t + ' sq ft' : ''; };
const devAreas = [...new Set(developments.map((d) => d.area).filter(Boolean))].sort();
const devBuilders = [...new Set(developments.flatMap((d) => d.builders))].sort();
const upTo = (b: string[]) => (b.length > 3 ? b.slice(0, 3).join(', ') + ' and ' + (b.length - 3) + ' more' : b.join(', '));
const tips = [
  ['Bring Your Realtor on Your First Visit', 'Many builders ask on day one whether you already have a Realtor, so it helps to have one before you walk in.'],
  ['Compare the Full Monthly Cost', 'Taxes, HOA dues, and special district fees can differ a lot between communities, even at the same price.'],
  ['Ask What Is Included', 'Find out which finishes are standard and which are upgrades, and get the answer in writing.'],
  ['Consider Your Own Inspection', 'A new home can still have issues. An independent inspection is worth thinking about.'],
];
---
<Base title="New Builds" active="More" sub="makeithome" description="Newer and master planned communities to compare around Houston.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">New builds</p>
      <h1 style="margin-bottom:16px;max-width:880px">Newer Communities to Compare</h1>
      <p class="lead" style="margin-bottom:28px">Search new developments across Greater Houston by area, builder, bedrooms and home size. Then ask Dillon what is open right now.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/ask-dillon')}>Ask Dillon about new builds</a><a class="btn line" href={url('/find-your-fit')}>Find your fit</a></div>
    </div>
  </section>
  <section class="band">
<div class="wrap">
<p class="eyebrow">New developments</p><h2 style="margin-bottom:12px">Search New Developments</h2>
<p class="meta" style="max-width:760px;margin-bottom:20px">Builder names and home plans come from a historical export and may be out of date. Confirm current plans, pricing and availability with the builder, or ask Dillon what is open right now.</p>
<div class="fbar" id="dv-bar">
<div class="fbar-row">
<div class="fbar-search"><label for="dv-q">Search</label><input id="dv-q" type="search" placeholder="Try a development, builder, city or ZIP" autocomplete="off" /></div>
<button class="chip fbar-toggle" type="button" aria-expanded="false" aria-controls="dv-panel">Filters <span class="fcount hidden" id="dv-badge"></span></button>
<div class="fbar-panel" id="dv-panel">
<div class="fsel"><label for="dv-area">Area</label><select id="dv-area"><option value="">All areas</option>{devAreas.map((a) => <option>{a}</option>)}</select></div>
<div class="fsel"><label for="dv-builder">Builder</label><select id="dv-builder"><option value="">All builders</option>{devBuilders.map((b) => <option>{b}</option>)}</select></div>
<div class="fsel"><label for="dv-beds">Bedrooms</label><select id="dv-beds"><option value="0">Any</option><option value="2">2 or more</option><option value="3">3 or more</option><option value="4">4 or more</option><option value="5">5 or more</option></select></div>
<div class="fsel"><label for="dv-sqft">Home size</label><select id="dv-sqft"><option value="0">Any</option><option value="1500">1,500 sq ft or more</option><option value="2000">2,000 sq ft or more</option><option value="2500">2,500 sq ft or more</option><option value="3000">3,000 sq ft or more</option></select></div>
</div>
</div>
<div class="fbar-status"><div class="fpills" id="dv-pills"></div><button class="flink hidden" id="dv-clear" type="button">Clear all</button><span class="meta" id="dv-count">{developments.length} developments</span></div>
</div>
<div style="height:24px"></div>
<div class="grid g3">
{developments.map((d, i) => (
<div class={i < 24 ? 'card pad dv-item' : 'card pad dv-item hidden'} data-name={[d.name, d.city, d.area, d.zip, d.builders.join(' ')].join(' ').toLowerCase()} data-area={d.area} data-builders={d.builders.join('|')} data-bedsmax={d.bedsMax} data-sqftmax={d.sqftMax}>
<span class="tag">New development</span>
<h4 style="margin:12px 0 6px">{d.name}</h4>
<p class="meta" style="margin-bottom:8px">{[d.city, d.area && d.area !== d.city ? d.area : ''].filter(Boolean).join(', ')}</p>
{d.builders.length > 0 && <p class="meta" style="font-size:15px;margin-bottom:6px"><b>Builders:</b> {upTo(d.builders)}</p>}
{(bedText(d) || sqftText(d)) && <p class="meta" style="font-size:15px;margin-bottom:6px">{[bedText(d), sqftText(d)].filter(Boolean).join(', ')}</p>}
{d.builders.length > 0 && <p class="meta" style="font-size:14px;margin-bottom:12px">Historical record. Confirm current plans.</p>}
<p style="display:flex;gap:16px;flex-wrap:wrap;margin:0">{d.website && <a href={d.website} target="_blank" rel="noopener noreferrer">View the listing</a>}<a href={url('/ask-dillon')}>Ask Dillon</a></p>
</div>
))}
</div>
<p style="margin-top:24px"><button class="btn line hidden" id="dv-more" type="button">Show more developments</button></p>
<div class="card pad hidden" id="dv-empty"><b>No developments match those filters.</b></div>
</div>
</section>
<section class="band tint">
    <div class="wrap">
      <p class="eyebrow">Communities</p><h2 style="margin-bottom:16px">Communities and Areas to Explore</h2>
      <div class="fbar" id="nb-bar">
        <div class="fbar-row">
          <div class="fbar-search"><label for="nb-q">Search</label><input id="nb-q" type="search" placeholder="Try a community or a city" autocomplete="off" /></div>
          <button class="chip fbar-toggle" type="button" aria-expanded="false" aria-controls="nb-panel">Filters <span class="fcount hidden" id="nb-badge"></span></button>
          <div class="fbar-panel" id="nb-panel"><div class="fsel"><label for="nb-area">Area</label><select id="nb-area"><option value="">All areas</option>{areas.map((a) => <option>{a}</option>)}</select></div></div>
        </div>
        <div class="fbar-status"><div class="fpills" id="nb-pills"></div><button class="flink hidden" id="nb-clear" type="button">Clear all</button><span class="meta" id="nb-count">{list.length} communities</span></div>
      </div>
      <div style="height:24px"></div>
      <div class="grid g3">
        {list.map((p, i) => (
          <a class={i < 24 ? 'card pad nb-item' : 'card pad nb-item hidden'} data-name={[p.name, p.type === 'Subdivision' ? p.area : p.region].join(' ').toLowerCase()} href={href(p)} data-area={p.type === 'Subdivision' ? p.area : p.name} style="text-decoration:none">
            <span class="tag">{p.type === 'Subdivision' ? 'Community' : 'Area'}</span>
            <h4 style="margin:12px 0 6px">{p.name}</h4>
            <p class="meta" style="margin-bottom:8px">{p.type === 'Subdivision' ? p.area : p.region}</p>
            <p class="meta" style="font-size:15px">{p.summary.length > 150 ? p.summary.slice(0, 150).replace(/\s+\S*$/, '') + '...' : p.summary}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><button class="btn line hidden" id="nb-more" type="button">Show more communities</button></p>
      <div class="card pad hidden" id="nb-empty"><b>No communities match that area yet.</b></div>
    </div>
  </section>
  <section class="band tint">
    <div class="wrap">
      <p class="eyebrow">Before you visit</p><h2 style="margin-bottom:28px">Buying New Construction</h2>
      <div class="grid g2">{tips.map(([t, d]) => <div class="card pad"><h4 style="margin-bottom:8px">{t}</h4><p class="meta" style="font-size:16px">{d}</p></div>)}</div>
    </div>
  </section>
  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
      <div style="max-width:700px"><h3 style="margin-bottom:8px">Curious About a Community?</h3><p style="font-size:17px">Dillon can tell you what is available and what to look for. Questions are always welcome.</p></div>
      <a class="btn" href={url('/ask-dillon')}>Ask Dillon</a>
    </div>
  </section>
  <FilterKit />
  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); }, area = $('nb-area');
      var kit = TLF.init({ bar: $('nb-bar'), items: [].slice.call(document.querySelectorAll('.nb-item')), search: $('nb-q'), step: 24, noun: ['community', 'communities'], count: $('nb-count'), empty: $('nb-empty'), more: $('nb-more'), clear: $('nb-clear'), pills: $('nb-pills'), badge: $('nb-badge'), filters: [TLF.select(area, 'area')] });
      area.addEventListener('change', kit.refresh);
    })();
  (function () {
var $ = function (id) { return document.getElementById(id); };
var area = $('dv-area'), builder = $('dv-builder'), beds = $('dv-beds'), sqft = $('dv-sqft');
var byBuilder = { test: function (it) { return !builder.value || (it.dataset.builders || '').split('|').indexOf(builder.value) > -1; }, pills: function () { return builder.value ? [{ label: builder.value, remove: function () { builder.value = ''; } }] : []; }, clear: function () { builder.value = ''; } };
var kit = TLF.init({ bar: $('dv-bar'), items: [].slice.call(document.querySelectorAll('.dv-item')), search: $('dv-q'), step: 24, noun: ['development', 'developments'], count: $('dv-count'), empty: $('dv-empty'), more: $('dv-more'), clear: $('dv-clear'), pills: $('dv-pills'), badge: $('dv-badge'), filters: [TLF.select(area, 'area'), byBuilder, TLF.min(beds, 'bedsmax', 'Bedrooms: '), TLF.min(sqft, 'sqftmax', 'Size: ')] });
[area, builder, beds, sqft].forEach(function (s) { s.addEventListener('change', kit.refresh); });
})();
</script>
</Base>
