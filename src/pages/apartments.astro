---
import Base from '../layouts/Base.astro';
import FilterKit from '../components/FilterKit.astro';
import '../styles/pages.css';
import { url, IS_PREVIEW, apartmentCommunities } from '../lib/data';
import { config } from '../config';
import { apartments } from '../lib/apartments';
const areas = [...new Set(apartments.map((a) => a.area).filter(Boolean))].sort();
const aptAreas = [...new Set(apartmentCommunities.map((x) => x.area).filter(Boolean))].sort();
const aptLayouts = ['Studio', '1 Bedroom', '2 Bedroom', '3 Bedroom', '4 Bedroom', 'Penthouse'].filter((l) => apartmentCommunities.some((x) => x.layouts.includes(l)));
const mail = 'mailto:' + config.contactEmail + '?subject=Apartment%20locating';
const help = [
  ['Matched to Your Life', 'Your commute, budget, pets, and the feel of the neighborhood all shape the shortlist.'],
  ['Neighborhood Context', 'Our guides show what is nearby, from coffee and groceries to parks and things to do.'],
  ['Tours Made Easier', 'A short list means fewer afternoons spent driving around.'],
  ['A Person to Ask', 'Not sure where to start? Ask, and we will point you the right way.'],
];
const steps = ['Share your budget, move date, and what you must have.', 'We suggest areas and places worth a look.', 'You tour, compare, and decide with a local on your side.'];
---
<Base title="Apartment Locating" active="More" sub="makeithome" description="Help finding the right apartment in Houston.">
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">Apartment locating</p>
      <h1 style="margin-bottom:16px;max-width:880px">Apartment Communities to Compare</h1>
      <p class="lead" style="margin-bottom:28px">Finding a rental in a big city takes time. Browse apartment communities below, then tell Dillon what matters and he will help you narrow the list.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/ask-dillon')}>Ask Dillon about apartments</a><a class="btn line" href={url('/find-your-fit')}>Find your fit</a></div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Apartments</p><h2 style="margin-bottom:12px">Search Apartment Communities</h2>
      <p class="meta" style="max-width:760px;margin-bottom:20px">Compare apartment communities by area and layout. Layouts and features come from third party listings and may change. Rent and availability are not listed here, so ask Dillon what is open right now.</p>
      <div class="fbar" id="ap-bar">
        <div class="fbar-row">
          <div class="fbar-search"><label for="ap-q">Search</label><input id="ap-q" type="search" placeholder="Try a community, neighborhood or ZIP" autocomplete="off" /></div>
          <button class="chip fbar-toggle" type="button" aria-expanded="false" aria-controls="ap-panel">Filters <span class="fcount hidden" id="ap-badge"></span></button>
          <div class="fbar-panel" id="ap-panel">
            <div class="fsel"><label for="ap-area">Area</label><select id="ap-area"><option value="">All areas</option>{aptAreas.map((x) => <option>{x}</option>)}</select></div>
            <div class="fsel"><label for="ap-layout">Layout</label><select id="ap-layout"><option value="">Any layout</option>{aptLayouts.map((x) => <option>{x}</option>)}</select></div>
          </div>
        </div>
        <div class="fbar-status"><div class="fpills" id="ap-pills"></div><button class="flink hidden" id="ap-clear" type="button">Clear all</button><span class="meta" id="ap-count">{apartmentCommunities.length} apartment communities</span></div>
      </div>
      <div style="height:24px"></div>
      <div class="grid g3">
        {apartmentCommunities.map((x, i) => (
          <div class={i < 24 ? 'card pad ap-item' : 'card pad ap-item hidden'} data-name={[x.name, x.area, x.address, x.zip, x.features].join(' ').toLowerCase()} data-area={x.area} data-layouts={x.layouts.join('|')}>
            <span class="tag">Apartment community</span>
            <h4 style="margin:12px 0 6px"><a href={url('/apartments/' + x.slug)}>{x.name}</a></h4>
            <p class="meta" style="margin-bottom:8px">{[x.area, x.city].filter((v, j, arr) => v && arr.indexOf(v) === j).join(', ')}</p>
            {x.layouts.length > 0 && <p class="meta" style="font-size:15px;margin-bottom:6px"><b>Layouts:</b> {x.layouts.join(', ')}</p>}
            {x.features && <p class="meta" style="font-size:15px;margin-bottom:6px"><b>Features:</b> {x.features}</p>}
            <p style="margin-top:14px"><a class="btn line" href={url('/apartments/' + x.slug)}>View details</a></p>
          </div>
        ))}
      </div>
      <p style="margin-top:24px"><button class="btn line hidden" id="ap-more" type="button">Show more apartments</button></p>
      <div class="card pad hidden" id="ap-empty"><b>No apartment communities match those filters.</b></div>
    </div>
  </section>
  <section class="band tint">
    <div class="wrap">
      <p class="eyebrow">How we can help</p><h2 style="margin-bottom:28px">What to Expect</h2>
      <div class="grid g2">{help.map(([t, d]) => <div class="card pad"><h4 style="margin-bottom:8px">{t}</h4><p class="meta" style="font-size:16px">{d}</p></div>)}</div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">How it works</p><h2 style="margin-bottom:28px">Three Simple Steps</h2>
      <div class="grid g3">{steps.map((s, i) => <div class="card pad"><span class="tag">{i + 1}</span><p style="margin-top:12px">{s}</p></div>)}</div>
      <p class="meta" style="font-size:16px;margin-top:24px;max-width:760px">Great for renters new to Houston, anyone moving on a short timeline, and people who want to know the neighborhood before they sign.</p>
    </div>
  </section>
  <section class="band butter">
    <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
      <div style="max-width:700px"><h3 style="margin-bottom:8px">Curious About a Community?</h3><p style="font-size:17px">Tell Dillon your budget, your move date, and what you must have. He will reply personally, with no pressure.</p></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={url('/ask-dillon')}>Ask Dillon</a><a class="btn line" href={mail}>Email Dillon</a></div>
    </div>
  </section>
  <FilterKit />
  <script is:inline>
(function () {
var $ = function (id) { return document.getElementById(id); };
var area = $('ap-area'), layout = $('ap-layout');
var byLayout = { test: function (it) { return !layout.value || (it.dataset.layouts || '').split('|').indexOf(layout.value) > -1; }, pills: function () { return layout.value ? [{ label: layout.value, remove: function () { layout.value = ''; } }] : []; }, clear: function () { layout.value = ''; } };
var kit = TLF.init({ bar: $('ap-bar'), items: [].slice.call(document.querySelectorAll('.ap-item')), search: $('ap-q'), step: 24, noun: ['apartment community', 'apartment communities'], count: $('ap-count'), empty: $('ap-empty'), more: $('ap-more'), clear: $('ap-clear'), pills: $('ap-pills'), badge: $('ap-badge'), filters: [TLF.select(area, 'area'), byLayout] });
[area, layout].forEach(function (s) { s.addEventListener('change', kit.refresh); });
})();
  </script>
</Base>
