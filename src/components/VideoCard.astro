---
const { v } = Astro.props;
---
<div class="card vcard" data-kind={v.tour ? 'tour' : 'food'}>
  <button type="button" class="vthumb" data-id={v.id} data-title={v.display} aria-label={'Play ' + v.display}>
    <img src={v.thumb} alt="" loading="lazy" />
    <span class="vplay" aria-hidden="true"></span>
    {v.duration && <span class="vdur">{v.duration}</span>}
  </button>
  <div class="vbody">
    <h4 style="margin-bottom:6px">{v.display}</h4>
    {v.place && <p class="meta" style="font-size:15px">At <a href={v.place}>{v.placeName}</a></p>}
  </div>
</div>
<style is:global>
  .vthumb { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; padding: 0; background: #000; cursor: pointer; overflow: hidden; border-radius: 12px 12px 0 0; }
  .vthumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .25s; }
  .vthumb:hover img, .vthumb:focus-visible img { transform: scale(1.04); }
  .vthumb:focus-visible { outline: 3px solid var(--gold); outline-offset: -3px; }
  .vplay { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: rgba(29, 26, 109, .88); }
  .vplay::after { content: ""; position: absolute; left: 25px; top: 19px; border-left: 20px solid #fff; border-top: 13px solid transparent; border-bottom: 13px solid transparent; }
  .vdur { position: absolute; right: 10px; bottom: 10px; background: rgba(0, 0, 0, .78); color: #fff; font-size: 13px; font-weight: 700; padding: 2px 8px; border-radius: 6px; }
  .vcard { overflow: hidden; }
  .vcard .vbody { padding: 18px 20px 20px; }
  .vcard iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; }
</style>
