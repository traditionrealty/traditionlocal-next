---
import { url } from '../lib/data';
import { config } from '../config';
const gated = !!config.searchMembersOnly;
---
<div id="srch" class="srch hidden" role="dialog" aria-modal="true" aria-label="Search the site">
  <div class="srch-back" data-close="1"></div>
  <div class="srch-box">
    {gated ? (
      <div style="padding:8px 6px">
        <h3 style="margin-bottom:8px">Search Is for Members</h3>
        <p class="meta" style="margin-bottom:16px">Sign in to search places, neighborhoods, events, and videos.</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn" href={url('/account')}>Sign in</a><button class="btn line" type="button" data-close="1">Close</button></div>
      </div>
    ) : (
      <>
        <form class="srch-form" action={url('/search')} method="get" role="search">
          <input id="srch-q" name="q" type="search" placeholder="Search places, neighborhoods, events, videos" autocomplete="off" aria-label="Search" />
          <button class="btn sm" type="submit">Search</button>
          <button class="srch-x" type="button" data-close="1" aria-label="Close search">Close</button>
        </form>
        <div id="srch-out" class="srch-out" role="listbox" aria-live="polite"></div>
        <p class="meta srch-hint">Tip: press / anywhere to search, and Esc to close.</p>
      </>
    )}
  </div>
</div>
<style is:global>
  .tag.closed { background: #FBE9E7; color: var(--danger); }
  .closed-note { background: #FBE9E7; border: 1px solid #F0C9C4; border-radius: 12px; padding: 16px 18px; margin: 0 0 22px; max-width: 720px; font-size: 16px; line-height: 1.55; color: var(--navy); }
  .closed-note b { color: var(--danger); }
  .closed-note a { font-weight: 700; }
  .f-item[data-closed="1"] { background: var(--ivory); }
  .f-item[data-closed="1"] h4 { color: var(--slate); }
  .fcheck { display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: var(--fs-small); font-weight: 700; cursor: pointer; }
  .fcheck input { width: 18px; height: 18px; min-height: 0; margin: 0; accent-color: var(--navy); }
  .srch { position: fixed; inset: 0; z-index: 200; }
  .srch-back { position: absolute; inset: 0; background: rgba(29, 26, 109, .55); }
  .srch-box { position: relative; max-width: 720px; margin: 10vh auto 0; background: #fff; border-radius: 16px; padding: 18px; box-shadow: 0 24px 60px rgba(0, 0, 0, .3); max-height: 80vh; overflow: auto; }
  .srch-form { display: flex; gap: 10px; align-items: center; }
  .srch-form input { flex: 1; min-width: 0; font-size: 18px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 999px; background: #fff; }
  .srch-x { border: 0; background: none; font: inherit; font-weight: 700; color: var(--blue); cursor: pointer; padding: 8px; }
  .srch-out { margin-top: 12px; display: grid; }
  .srch-item { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; align-items: center; padding: 11px 10px; border-radius: 10px; text-decoration: none; color: var(--navy); }
  .srch-item .meta { grid-column: 2; font-size: 14px; }
  .srch-item:hover, .srch-item.on { background: var(--ivory); }
  .srch-hint { margin-top: 10px; font-size: 13px; }
  .srch-lock { overflow: hidden; }
  .srch-open { display: inline-flex; align-items: center; justify-content: center; width: 42px; padding-left: 0 !important; padding-right: 0 !important; }
  .srch-h { font-size: 22px; margin: 36px 0 14px; }
  @media (max-width: 640px) { .srch-box { margin: 0; border-radius: 0 0 16px 16px; max-height: 100vh; } .srch-form { flex-wrap: wrap; } }
</style>
<script is:inline define:vars={{ INDEX: url('/search-index.json'), GATED: gated }}>
  (function () {
    var idx = null, loading = null, active = -1, opener = null;
    var LABEL = { food: 'Where to eat', biz: 'Local business', closed: 'Closed', review: 'Review', thing: 'Things to do', area: 'Neighborhood', sub: 'Subdivision', event: 'Event', video: 'Video', opening: 'Openings', page: 'Page' };
    var GROUPS = { page: 'Pages', food: 'Places to Eat', biz: 'Other Places We Reviewed', review: 'Reviews', area: 'Neighborhoods', sub: 'Subdivisions', thing: 'Things to Do', event: 'Events', video: 'Videos', opening: 'Openings and Closings', closed: 'Closed Places (No Longer Open)' };
    var ORDER = ['page', 'food', 'biz', 'review', 'area', 'sub', 'thing', 'event', 'video', 'opening', 'closed'];
    var BOOST = { page: 6, food: 5, biz: 2, area: 4, thing: 3, event: 3, sub: 1, review: 1, video: 0, opening: 0, closed: -4 };
    var box = document.getElementById('srch'), input = document.getElementById('srch-q'), out = document.getElementById('srch-out');
    function norm(s) { return String(s || '').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/['\u2019]/g, '').replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').replace(/\s+/g, ' ').trim(); }
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
    function load() {
      if (idx) return Promise.resolve(idx);
      if (!loading) loading = fetch(INDEX).then(function (r) { return r.json(); }).then(function (rows) { rows.forEach(function (e) { e._t = norm(e.t); e._s = norm(e.s); e._x = norm(e.x); }); idx = rows; return rows; });
      return loading;
    }
    function search(q, limit) {
      var qn = norm(q); if (!qn || !idx) return [];
      var toks = qn.split(' '), hits = [];
      idx.forEach(function (e) {
        var sc = 0, ok = true;
        for (var i = 0; i < toks.length; i++) {
          var tk = toks[i], inT = e._t.indexOf(tk) > -1, inS = e._s.indexOf(tk) > -1, inX = e._x.indexOf(tk) > -1;
          if (!inT && !inS && !inX) { ok = false; break; }
          sc += inT ? ((' ' + e._t).indexOf(' ' + tk) > -1 ? 20 : 10) : inS ? 8 : 3;
        }
        if (!ok) return;
        if (e._t === qn) sc += 100; else if (e._t.indexOf(qn) === 0) sc += 60; else if ((' ' + e._t).indexOf(' ' + qn) > -1) sc += 35;
        hits.push({ e: e, sc: sc + (BOOST[e.k] || 0) });
      });
      hits.sort(function (a, b) { return b.sc - a.sc || a.e.t.localeCompare(b.e.t); });
      return hits.slice(0, limit || 50).map(function (h) { return h.e; });
    }
    function item(e) { return '<a class="srch-item" role="option" href="' + esc(e.u) + '"><span class="tag ' + (e.k === 'closed' ? 'closed' : 'soft') + '">' + esc(LABEL[e.k] || '') + '</span><b>' + esc(e.t) + '</b>' + (e.s ? '<span class="meta">' + esc(e.s) + '</span>' : '') + '</a>'; }
    function items() { return out ? [].slice.call(out.querySelectorAll('.srch-item')) : []; }
    function setActive(n) { var list = items(); if (!list.length) { active = -1; return; } active = (n + list.length) % list.length; list.forEach(function (a, i) { a.classList.toggle('on', i === active); a.setAttribute('aria-selected', i === active ? 'true' : 'false'); }); list[active].scrollIntoView({ block: 'nearest' }); }
    function suggestions() { return '<p class="meta" style="padding:10px 10px 4px">Try a place, a neighborhood, or something you are craving. Or jump straight in:</p>' + [['Where to Eat', '/food'], ['Neighborhoods', '/neighborhoods'], ['Things to Do', '/things-to-do'], ['Videos', '/videos']].map(function (p) { return item({ k: 'page', t: p[0], u: INDEX.replace('/search-index.json', p[1]), s: '' }); }).join(''); }
    function render() {
      if (!out) return;
      var q = input.value;
      if (!norm(q)) { out.innerHTML = suggestions(); active = -1; return; }
      load().then(function () {
        if (input.value !== q) return;
        var res = search(q, 8);
        out.innerHTML = res.length ? res.map(item).join('') + '<p style="padding:8px 10px 0"><a href="' + esc(INDEX.replace('/search-index.json', '/search')) + '?q=' + encodeURIComponent(q) + '" style="font-weight:700">See all results</a></p>' : '<p class="meta" style="padding:12px 10px">No matches yet. Try a shorter word.</p>';
        setActive(res.length ? 0 : -1);
      });
    }
    function open() { if (!box) return; opener = document.activeElement; box.classList.remove('hidden'); document.documentElement.classList.add('srch-lock'); if (input) { input.focus(); input.select(); load(); render(); } }
    function close() { if (!box) return; box.classList.add('hidden'); document.documentElement.classList.remove('srch-lock'); if (opener && opener.focus) opener.focus(); }
    document.addEventListener('click', function (e) {
      if (e.target.closest('.srch-open')) { e.preventDefault(); open(); return; }
      if (e.target.closest('[data-close]')) { close(); }
    });
    document.addEventListener('keydown', function (e) {
      var tag = (e.target.tagName || '').toLowerCase(), typing = tag === 'input' || tag === 'textarea' || tag === 'select' || e.target.isContentEditable;
      if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) { e.preventDefault(); open(); return; }
      if (!box || box.classList.contains('hidden')) return;
      if (e.key === 'Escape') { close(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter' && active > -1 && items()[active] && e.target === input) { e.preventDefault(); items()[active].click(); }
    });
    if (input) input.addEventListener('input', render);
    // The full results page
    var pg = document.getElementById('srch-page-out');
    if (pg && !GATED) {
      var q = new URLSearchParams(location.search).get('q') || '', pin = document.getElementById('srch-page-q'), cnt = document.getElementById('srch-page-count');
      if (pin) pin.value = q;
      if (!norm(q)) { pg.innerHTML = '<p class="meta">Type something to search places, neighborhoods, events, and videos.</p>'; }
      else load().then(function () {
        var res = search(q, 300);
        cnt.textContent = res.length + (res.length === 1 ? ' result' : ' results') + ' for ' + q;
        if (!res.length) { pg.innerHTML = '<div class="card pad"><b>No results yet.</b><p class="meta" style="margin-top:4px">Try a shorter word, or browse Food, Neighborhoods, Things to do, or Videos from the menu.</p></div>'; return; }
        var by = {}; res.forEach(function (e) { (by[e.k] = by[e.k] || []).push(e); });
        pg.innerHTML = ORDER.filter(function (k) { return by[k]; }).map(function (k) {
          return '<h2 class="srch-h">' + GROUPS[k] + ' <span class="meta" style="font-size:16px">(' + by[k].length + ')</span></h2><div class="grid g2">' + by[k].slice(0, 12).map(function (e) { return '<a class="card pad" href="' + esc(e.u) + '" style="text-decoration:none"><b style="font-size:18px">' + esc(e.t) + '</b>' + (e.s ? '<p class="meta" style="margin-top:4px">' + esc(e.s) + '</p>' : '') + '</a>'; }).join('') + '</div>' + (by[k].length > 12 ? '<p class="meta" style="margin-top:10px">Showing 12 of ' + by[k].length + '. Add a word to narrow it down.</p>' : '');
        }).join('');
      });
    }
    window.TLSearch = { load: load, search: search, norm: norm };
  })();
</script>
