---
// The real estate feed: market updates, Tradition Realty Group articles and guides, and the latest videos from Dillon.
// Used on the Tradition Realty Group page and on the Neighborhoods page. Use it once per page.
import VideoCard from './VideoCard.astro';
import VideoScript from './VideoScript.astro';
import { url, IS_PREVIEW } from '../lib/data';
import { feed, feedHasPosts, feedHasVideos } from '../lib/realestate';
---
{feed.length > 0 && (
  <section class="band" id="re-feed">
    <div class="wrap">
      <p class="eyebrow">Reading and watching</p><h2 style="margin-bottom:12px">Houston Guides, Articles, and Videos</h2>
      <p class="meta" style="font-size:17px;margin-bottom:24px;max-width:720px">Market updates, articles, news, and videos from Dillon. Check back often.</p>
      {feedHasPosts && feedHasVideos && <div class="tabs" id="rf-tabs" style="margin-bottom:24px"><button class="chip on" data-k="" aria-pressed="true">All</button><button class="chip" data-k="update" aria-pressed="false">Articles and updates</button><button class="chip" data-k="video" aria-pressed="false">Videos</button></div>}
      <div class="grid g3" id="rf-grid">
        {feed.map((it, i) => it.type === 'post' ? (
          <a class={i < 6 ? 'card pad rf-item' : 'card pad rf-item hidden'} data-k="update" href={it.post.link || url('/ask-dillon')} rel={it.post.external ? 'noopener' : undefined} style="text-decoration:none;display:flex;flex-direction:column">
            <div style="display:flex;gap:8px;flex-wrap:wrap"><span class="tag">{it.post.label}</span>{it.post.date && <span class="tag soft">{it.post.date}</span>}{IS_PREVIEW && it.post.example && <span class="tag soft">Example</span>}</div>
            <h4 style="margin:12px 0 8px">{it.post.title}</h4>
            {it.post.summary && <p class="meta" style="font-size:15px">{it.post.summary}</p>}
            {it.post.source && <p class="meta" style="font-size:13px;margin-top:10px">Source: {it.post.source}</p>}
            <span style="margin-top:auto;padding-top:14px;font-weight:700;color:var(--blue)">{it.post.link ? 'Read more' : 'Ask Dillon about this'}</span>
          </a>
        ) : (
          <div class={i < 6 ? 'rf-item' : 'rf-item hidden'} data-k="video"><VideoCard v={it.v} /></div>
        ))}
      </div>
      <p style="margin-top:24px"><button class="btn line hidden" id="rf-more" type="button">Show more</button></p>
    </div>
  </section>
)}
  <VideoScript />
  <script is:inline>
    (function () {
      var g = document.getElementById('rf-grid'); if (!g) return;
      var items = [].slice.call(g.children), more = document.getElementById('rf-more'), tabs = document.getElementById('rf-tabs'), kind = '', shown = 6;
      function run() {
        var m = items.filter(function (i) { return !kind || i.getAttribute('data-k') === kind; });
        items.forEach(function (i) { i.classList.add('hidden'); });
        m.slice(0, shown).forEach(function (i) { i.classList.remove('hidden'); });
        more.classList.toggle('hidden', m.length <= shown);
      }
      if (tabs) tabs.addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        kind = b.getAttribute('data-k'); shown = 6;
        [].forEach.call(tabs.children, function (c) { var on = c === b; c.classList.toggle('on', on); c.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        run();
      });
      more.addEventListener('click', function () { shown += 6; run(); });
      run();
    })();
  </script>
