---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
import { url } from '../lib/data';
import { config } from '../config';
interface Props { title: string; eyebrow: string; lead: string; who: string[]; help: [string, string][]; steps: string[]; subject: string; description: string; }
const { title, eyebrow, lead, who, help, steps, subject, description } = Astro.props;
const mail = `mailto:${config.contactEmail}?subject=${encodeURIComponent(subject)}`;
---
<Base title={title} active="More" sub="makeithome" description={description}>
  <section class="band hero">
    <div class="wrap">
      <p class="eyebrow">{eyebrow}</p>
      <h1 style="margin-bottom:16px;max-width:880px">{title}</h1>
      <p class="lead" style="margin-bottom:28px">{lead}</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href={mail}>Email Dillon</a><a class="btn line" href={url('/ask-dillon')}>Ask Dillon a question</a></div>
    </div>
  </section>
  <section class="band">
    <div class="wrap split">
      <div class="main">
        <p class="eyebrow">How we can help</p><h2 style="margin-bottom:24px">What to expect</h2>
        <div class="grid g2" style="margin-bottom:40px">{help.map(([t, d]) => <div class="card pad"><h4 style="margin-bottom:8px">{t}</h4><p class="meta" style="font-size:16px">{d}</p></div>)}</div>
        <p class="eyebrow">How it works</p><h2 style="margin-bottom:12px">Three simple steps</h2>
        <ol class="wx" role="list">{steps.map((s, i) => <li><span class="wx-n" aria-hidden="true">{i + 1}</span><p>{s}</p></li>)}</ol>
      </div>
      <div class="side">
        <div class="card pad"><p class="eyebrow">Who this is for</p><ul style="padding-left:20px;margin:0;display:grid;gap:8px">{who.map((w) => <li>{w}</li>)}</ul></div>
        <div class="card pad pick" style="margin-top:24px"><p class="eyebrow">Start here</p><h3 style="margin-bottom:8px">Tell us what you need.</h3><p class="meta" style="margin-bottom:16px;font-size:16px">A short note is enough. We will reply personally.</p><a class="btn" href={mail} style="width:100%">Email Dillon</a></div>
        <div class="card pad" style="margin-top:24px"><p class="eyebrow">Explore first</p><a class="menu" href={url('/neighborhoods')}>Neighborhood guides</a><a class="menu" href={url('/find-your-fit')}>Find your fit</a><a class="menu" href={url('/make-it-home')} style="border-bottom:0">All ways we can help</a></div>
      </div>
    </div>
  </section>
</Base>
