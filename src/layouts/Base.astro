---
import '../styles/global.css';
import '../styles/header.css';
import { IS_PREVIEW, url } from '../lib/data';
import { config } from '../config';
import SearchBox from '../components/SearchBox.astro';
import Popups from '../components/Popups.astro';
interface Props { title: string; description?: string; active?: string; sub?: string; noindex?: boolean; }
const { title, description = 'Honest reviews, weekend plans, and neighborhood guides from people who live here.', active = '', sub = '', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://traditionlocal.com').href;
const main = [['Food', '/food'], ['Neighborhoods', '/neighborhoods'], ['Things to Do', '/things-to-do']];
const more: [string, [string, string, string][]][] = [
  ['Stay In the Loop', [['Newsletters', '/newsletters', 'In the Loop and Locally Plus'], ['Videos', '/videos', 'Walks, coffee runs, and reviews']]],
  ['Moving to Houston', [['Make It Home', '/make-it-home', 'Moving, renting, or buying'], ['Ask Dillon', '/ask-dillon', 'Questions about an area']]],
  ['For Members', [['Local Directory', '/local-directory', 'Providers we know, for members']]],
];
const subs = [['Overview', '/make-it-home'], ['Find Your Fit', '/find-your-fit']];
const moreOn = sub !== '' || active === 'More';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <meta name="theme-color" content="#1D1A6D" />
  <title>{title} | Tradition Local</title>
  <meta name="description" content={description} />
  {IS_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
  {!IS_PREVIEW && noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="Tradition Local" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title + ' | Tradition Local'} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Fraunces:wght@600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {IS_PREVIEW && <div class="ribbon"><div class="wrap"><b>Draft preview.</b> This is the redesign in progress, built from the Simple Master sheet. It is not the live site.</div></div>}
  <header class="top">
    <div class="wrap">
      <a class="logo" href={url('/')}>{config.mark && <img src={url(config.mark)} alt="" width="48" height="48" />}Tradition Local</a>
      <div class="mbar">
        <button class="srch-open" type="button" aria-label="Search" aria-haspopup="dialog"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg></button>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      </div>
      <nav class="nav" id="site-nav" aria-label="Main">
        {main.map(([n, h]) => <a class={'nl' + (active === n ? ' on' : '')} href={url(h)} aria-current={active === n ? 'page' : undefined}>{n}</a>)}
        <div class="more">
          <button type="button" class={moreOn ? 'on' : ''} aria-haspopup="true" aria-expanded="false">More <span aria-hidden="true">&#9660;</span></button>
          <div class="pop"><div class="pop-in">{more.map(([g, list]) => <><p class="pop-h">{g}</p>{list.map(([n, h, d]) => <a href={url(h)} aria-current={Astro.url.pathname.replace(/\/$/, '').endsWith(h) ? 'page' : undefined}>{n}<small>{d}</small></a>)}</>)}</div></div>
        </div>
        <div class="nav-end">
          <button class="srch-open" type="button" aria-label="Search" aria-haspopup="dialog" title="Search (press /)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg></button>
          <a class="signin" id="nav-signin" href={url('/sign-in')} data-account={url('/account')}>Sign in</a>
          <a class="btn sm" href={url('/newsletters')}>Join In the Loop</a>
        </div>
      </nav>
    </div>
  </header>
  {sub === 'makeithome' && (
    <div class="subnav"><div class="wrap"><b>Make It Home</b>{subs.map(([n, h]) => <a class={Astro.url.pathname.replace(/\/$/, '').endsWith(h) ? 'on' : ''} href={url(h)}>{n}</a>)}</div></div>
  )}
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="wrap">
      <div class="cols">
        <div>
          <a class="logo" href={url('/')} style="color:#fff;font-size:34px">Tradition Local</a>
          <p style="margin-top:10px;font-size:17px;max-width:360px">We help people feel connected to their neighborhood, community, and city.</p>
          <p class="h" style="margin-top:28px">Explore</p>
          <div style="display:flex;gap:28px;flex-wrap:wrap"><a href={url('/food')}>Where to Eat</a><a href={url('/neighborhoods')}>Neighborhoods</a><a href={url('/things-to-do')}>Things to Do</a></div>
        </div>
        <div>
          <p class="h">About</p>
          <p class="li"><a href={url('/about')}>Meet Sara and Dillon</a></p>
          <p class="li"><a href={url('/how-we-review')}>How We Review Places</a></p>
          <p class="li"><a href={url('/contact')}>Contact</a></p>
        </div>
        <div>
          <form action={config.newsletterAction} method="post">
            <label for="foot-email" style="color:#E7BC52">Join In the Loop, every Monday</label>
            <div class="join"><input id="foot-email" name="email" type="email" required placeholder="name@email.com" autocomplete="email" /><button type="submit">Join</button></div>
            <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
            <input type="hidden" name="return" id="nl-return-f" />
            <p id="nl-msg" role="status" hidden style="margin-top:8px;font-size:14px;color:#fff;font-weight:700"></p>
          </form>
          <p style="margin-top:10px;font-size:14px;color:#D4D2EE">Free, and one click to leave. We never sell your email.</p>
          <p style="margin-top:14px"><a href={url('/account')} style="color:#FFE29A;font-weight:700">Get local picks for your area</a></p>
        </div>
      </div>
      <div class="legal">
        <span>© {new Date().getFullYear()} Tradition Local | <a href={url('/privacy')}>Privacy</a> | <a href={url('/disclosures')}>Texas Real Estate Disclosures</a> | Real estate services by <a href={url('/tradition-realty-group')}>{config.brokerage.name}</a></span>
        <span><a href={config.social.instagram} rel="noopener">Instagram</a> | <a href="https://www.youtube.com/@TraditionLocal">YouTube</a> | <a href={config.social.facebook} rel="noopener">Facebook</a> | <a href="#top">Back to top</a></span>
      </div>
    </div>
  </footer>
  <script is:inline define:vars={{ sbRef: new URL(config.supabase.url).hostname.split('.')[0], sbUrl: config.supabase.url, sbKey: config.supabase.key }}>
    // The header button follows the sign in. It reads what sign in saved on this device. When that has gone stale (the hour is up), it asks Supabase
    // whether the session is still good, loading the sign in library only then, so the button never says "Hi" for a session that has ended.
    // Signed out, the button sends people back to the page they were on after they sign in.
    (function () {
      // One shared sign in connection for the whole page, loaded only when something needs it (a stale header, or saving to the account).
      var queue = [], loading = false, client = null;
      window.TLSb = { get: function (cb) {
        if (window.TLAuth && window.TLAuth.client()) { cb(window.TLAuth.client()); return; }
        if (client) { cb(client); return; }
        queue.push(cb); if (loading) return; loading = true;
        function done(c) { client = c; loading = false; queue.splice(0).forEach(function (f) { try { f(c); } catch (e) {} }); }
        function ready() { var c = null; try { c = window.supabase.createClient(sbUrl, sbKey, { auth: { persistSession: true, autoRefreshToken: false, detectSessionInUrl: false } }); } catch (e) {} done(c); }
        if (window.supabase) { ready(); return; }
        var sc = document.createElement('script'); sc.src = 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.118.0/dist/umd/supabase.js';
        sc.onload = ready; sc.onerror = function () { done(null); }; document.head.appendChild(sc);
      } };
      var a = document.getElementById('nav-signin'); if (!a) return;
      var home = a.getAttribute('href'), acct = a.getAttribute('data-account') || home;
      function out() {
        a.textContent = 'Sign in'; a.classList.remove('in');
        a.href = /^\/(sign-in|account)(\/|$)/.test(location.pathname) ? home : home + '?next=' + encodeURIComponent(location.pathname);
      }
      function inn(u) { var n = (u && u.user_metadata && u.user_metadata.first_name) || ''; a.textContent = n && n.length <= 14 ? 'Hi, ' + n : 'Account'; a.href = acct; a.classList.add('in'); }
      window.TLHeader = { paint: function (session) { if (session && session.user) inn(session.user); else out(); } };
      if (window.__tlKnown) { window.TLHeader.paint(window.__tlSession); return; }
      var s = null; try { s = JSON.parse(localStorage.getItem('sb-' + sbRef + '-auth-token')); } catch (e) {}
      if (!s || !s.user || !(s.access_token || s.refresh_token)) { out(); return; }
      inn(s.user);
      if (window.TLAuth || (s.expires_at && s.expires_at * 1000 > Date.now() + 60000)) return; // pages with the sign in library report for themselves
      window.TLSb.get(function (c) { if (c) c.auth.getSession().then(function (r) { window.TLHeader.paint(r && r.data && r.data.session); }, function () {}); });
    })();
  </script>
  <script is:inline>
    // Fill in the return address, and show the result when the signup service sends the reader back.
    var q = new URLSearchParams(location.search).get('newsletter');
    var m = document.getElementById('nl-msg');
    document.querySelectorAll('input[name="return"]').forEach(function (x) { x.value = location.origin + location.pathname; });
    if (q && m) { m.hidden = false; m.textContent = q === 'ok' ? 'Thanks, you are subscribed. Welcome to Tradition Local.' : q === 'invalid' ? 'That email address does not look right. Please try again.' : 'Something went wrong. Please try again, or email us.'; }
  </script>
  <script is:inline>
    (function () {
      var h = document.querySelector('header.top'); if (!h) return;
      var b = h.querySelector('.nav-toggle'), more = h.querySelector('.more'), mb = more && more.querySelector('button');
      var mobile = function () { return window.matchMedia ? window.matchMedia('(max-width: 760px)').matches : false; };
      function setMore(o) { if (!more) return; more.classList.toggle('open', o); if (mb) mb.setAttribute('aria-expanded', o ? 'true' : 'false'); }
      function set(o) { h.classList.toggle('open', o); if (b) { b.setAttribute('aria-expanded', o ? 'true' : 'false'); b.textContent = o ? 'Close' : 'Menu'; } if (!o) setMore(false); else if (mb && mb.classList.contains('on')) setMore(true); }
      if (mb) mb.addEventListener('click', function (e) { e.stopPropagation(); setMore(!more.classList.contains('open')); });
      if (b) b.addEventListener('click', function () { set(!h.classList.contains('open')); });
      document.addEventListener('click', function (e) { if (more && !more.contains(e.target) && !(b && b.contains(e.target))) setMore(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { setMore(false); if (mobile()) set(false); } });
      h.querySelector('.nav').addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
      // pinned header: it shrinks and gains a shadow once the page has moved
      var dock = document.querySelector('.fdock'), root = document.documentElement;
      var onScroll = function () { var s = window.pageYOffset > 24; h.classList.toggle('stuck', s); root.classList.toggle('hs', s); if (dock) dock.classList.toggle('stuck', window.pageYOffset > 8 && dock.getBoundingClientRect().top <= h.getBoundingClientRect().height + 1); };
      window.addEventListener('resize', onScroll);
      window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
    })();
  </script>
  <SearchBox />
  <Popups />
</body>
</html>
